# Handtop: default apps for file types where more than one installed app could open them
# (docs/desktop.md, "File associations"). A user's ~/.config/mimeapps.list wins.
[Default Applications]
image/png=org.xfce.ristretto.desktop;imv.desktop
image/gif=org.xfce.ristretto.desktop;imv.desktop
image/jpeg=org.xfce.ristretto.desktop;imv.desktop
image/bmp=org.xfce.ristretto.desktop;imv.desktop
image/tiff=org.xfce.ristretto.desktop;imv.desktop
image/webp=org.xfce.ristretto.desktop
image/svg+xml=org.xfce.ristretto.desktop
image/x-pixmap=org.xfce.ristretto.desktop
image/x-xpixmap=org.xfce.ristretto.desktop
