# labwc session autostart (system default; a user file in ~/.config/labwc overrides it)
L="$HOME/.local/state/session"; mkdir -p "$L" "$HOME/.cache"
# After a log-out, the helpers that are not Wayland clients (input daemon loop, battery icon
# animation, Tailscale tray) outlive labwc: stop the previous session's whole process group
# (labwc starts each autostart in its own session) before starting new ones.
R="${XDG_RUNTIME_DIR:-/tmp}"
OLD=$(cat "$R/rg35xxh-autostart.pgid" 2>/dev/null)
ME=$(ps -o pgid= -p $$ | tr -d ' ')
[ -n "$OLD" ] && [ "$OLD" != "$ME" ] \
  && ps -eo pgid=,args= | awk -v g="$OLD" '$1 == g' | grep -q "labwc/autostart" \
  && kill -TERM "-$OLD" 2>/dev/null   # (no "--": dash, which runs this, rejects it) only if that group still is an old autostart
echo "$ME" > "$R/rg35xxh-autostart.pgid"
echo 0 > "$R/rg35xxh-session-starts"   # labwc is up: reset the failed-start counter (zz-rg35xxh-session.sh)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP >/dev/null 2>&1
(while :; do rg35xxh-inputd >>"$L/inputd.log" 2>&1; sleep 2; done) &
rg35xxh-osd >"$L/osd.log" 2>&1 &     # volume / brightness bar, left edge (src/osd)
rg35xxh-themed swaybg >"$L/swaybg.log" 2>&1 &     # dark | light: rg35xxh-theme
kanshi -c /etc/xdg/kanshi/config >"$L/kanshi.log" 2>&1 &
rg35xxh-themed waybar >"$L/waybar.log" 2>&1 &
rg35xxh-battery --animate >"$L/battery.log" 2>&1 &   # taskbar battery icon (charging animation)
rg35xxh-themed mako >"$L/mako.log" 2>&1 &   # (a ~/.config/mako/config still wins)
lxpolkit >"$L/lxpolkit.log" 2>&1 &
nm-applet --indicator >"$L/nm-applet.log" 2>&1 &
rg35xxh-bluetooth --watch >"$L/bluetooth.log" 2>&1 &   # taskbar Bluetooth icon (no blueman applet)
# Tailscale tray icon: only once Waybar's tray host is up (tailscale systray gives up for good
# when nobody hosts tray icons yet: no icon at all after some boots)
command -v tailscale >/dev/null && { gdbus wait --session --timeout 30 org.kde.StatusNotifierWatcher; \
  exec tailscale systray; } >"$L/tailscale-systray.log" 2>&1 &
. /etc/rg35xxh/power.conf 2>/dev/null   # auto-sleep after AUTOSLEEP_MINUTES without input (0 = off)
[ "${AUTOSLEEP_MINUTES:-0}" -gt 0 ] && swayidle -w timeout $((AUTOSLEEP_MINUTES * 60)) rg35xxh-autosleep >>"$L/autosleep.log" 2>&1 &
