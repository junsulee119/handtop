// RG35XX H panel: bottom taskbar, sized for 640x480. Per-user override: ~/.config/waybar/
{
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "spacing": 4,
  "modules-left": ["custom/apps", "wlr/taskbar"],
  "modules-right": ["image#inputmode", "image#bluetooth", "tray", "image#battery", "battery", "clock", "custom/power"],

  // Apps / power: text-free pixel icons as CSS backgrounds (panel-apps.png, panel-power[-light].png)
  "custom/apps":  { "format": "Apps", "tooltip": false, "on-click": "rg35xxh-drawer" },
  "custom/power": { "format": " ", "tooltip": false, "on-click": "rg35xxh-power-menu" },
  // Input-mode icon (desktop / gamepad / BT Controller); rg35xxh-inputd sends SIGRTMIN+8 on change,
  // the daemon also drives the shake of the old icon. Bar 32 px = 1 px border + 31 px:
  // 4 px above and below the 23 px icon (with the 1 px margin-top in style.css).
  // Battery icon (pixel art, 20x11; charging animation driven by "rg35xxh-battery --animate"),
  // followed by the percentage from the battery module.
  "image#battery": { "exec": "rg35xxh-battery", "size": 20, "interval": 30, "signal": 9 },
  "image#inputmode": { "exec": "rg35xxh-inputmode", "size": 23, "interval": 10, "signal": 8 },
  // Bluetooth: own icon instead of blueman's tray (rg35xxh-bluetooth; --watch sends signal 10)
  "image#bluetooth": { "exec": "rg35xxh-bluetooth", "size": 23, "interval": 60, "signal": 10,
                       "on-click": "rg35xxh-bluetooth --manager", "tooltip": false },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize"
  },
  "tray": { "icon-size": 23, "spacing": 8 },   // 23 px: Handtop's pixel-art tray icons (Bluetooth) stay sharp
  "battery": {
    "bat": "battery",
    "interval": 30,
    "states": { "warning": 20, "critical": 10 },
    "format": "{capacity}%",
    "format-charging": "{capacity}%",          // charging is shown by the icon
    "tooltip-format": "{timeTo}"
  },
  "clock": { "format": "{:%H:%M}", "tooltip-format": "{:%Y-%m-%d %a}" }
}
