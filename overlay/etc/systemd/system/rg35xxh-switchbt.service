[Unit]
Description=Handtop Switch controller mode over Bluetooth (handheld as a Pro Controller, experimental)
# Wants, not Requires: the service restarts bluetoothd itself (Pro Controller identity),
# which must not stop it.
Wants=bluetooth.service
After=bluetooth.service
# One external controller connection at a time.
Conflicts=rg35xxh-btpad.service rg35xxh-usbpad.service rg35xxh-switchpad.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/rg35xxh-switchbt
# Put bluetoothd's own identity (and its input plugin) back even if the service crashed.
ExecStopPost=/usr/local/sbin/rg35xxh-switchbt --restore
# Stops by itself when the mode is left; not started at boot.
Restart=no
