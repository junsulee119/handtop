[Unit]
Description=Handtop wired controller mode (handheld as a wired Xbox 360 controller over USB)
# One external controller connection at a time.
Conflicts=rg35xxh-btpad.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/rg35xxh-usbpad
# Stops by itself when the mode is left; not started at boot (the port has other uses).
Restart=no
