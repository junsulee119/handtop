[Unit]
Description=Act on recovery.txt on the boot partition (Handtop recovery)
Documentation=https://github.com/junsulee119/handtop/blob/main/docs/services/update.md
# Early, before the session and the input daemon; it restarts once when it changed something.
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target system-update-pre.target shutdown.target
Conflicts=shutdown.target
# Wants, not Requires: a saved request is acted on even when the boot partition fails to mount (nofail).
WantsMountsFor=/boot/firmware
ConditionPathExists=|/boot/firmware/recovery.txt
# or a request saved before a cut (acted on even if the boot partition is missing now)
ConditionPathExists=|/var/lib/handtop-update/recovery-request.json

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/handtop-run handtop-recovery
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
