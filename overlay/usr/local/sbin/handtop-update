#!/usr/bin/python3
"""Handtop's update worker (docs/services/update.md).

    handtop-update status      downloaded / scheduled / going back possible / last result (JSON)
    handtop-update check       refresh the package lists and list the available updates (JSON)
    handtop-update download    download the update, the release to go back to, and save the plan
    handtop-update schedule [restart|poweroff]
                               after checks, install at the next restart; then start the desktop
                               (restart, default) or switch off
    handtop-update migrate     v0.4.x card (no Handtop packages yet): check, download and save the plan
                               that moves it onto packages (handtop-migrate runs it; schedule next)
    handtop-update cancel      forget the downloaded update (not a migration that has started installing)
    handtop-update repair      a kept migration: fetch its missing or damaged files again (same plan)
    handtop-update abandon-migration
                               give up a kept migration plan (docs/migrate.md); root only, not the app
    handtop-update channel stable|testing
                               where Handtop's packages come from (cancels a downloaded update)
    handtop-update apply       maintenance boot only (handtop-update-apply.service)
    handtop-update boot-check  normal boot only (handtop-update-boot-check.service)
    handtop-update --self-test exit 0 if this copy works (handtop-run uses it)

Updates are never installed in the running desktop. They are downloaded here, then installed in
systemd's offline-update boot (system-update.target, entered while the /system-update link
exists), where no session, input daemon or controller mode runs. The plan is exact: the package
lists are frozen at download, every file's SHA-256 is recorded, and the maintenance boot refuses
to do anything the plan didn't approve. The Update app runs status, check, download, schedule,
cancel and channel through sudo (/etc/sudoers.d/rg35xxh-update). recovery.txt is handled by
handtop-recovery, a separate small script.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid

STATE = "/var/lib/handtop-update"
PLAN = STATE + "/plan.json"
SCHEDULE = STATE + "/schedule.json"     # {plan, after, attempts, deferrals}
INPROGRESS = STATE + "/in-progress.json"
CLEANUP = STATE + "/cleanup.json"         # complete() in progress (plan id, decision)
LATER_EDITS = STATE + "/later-edits.json"   # migration: Handtop files the user changed after the plan
CHANGED = STATE + "/plan-changed.json"    # the plan whose install has started changing packages
RESULT = STATE + "/last-result.json"
CHECKED = STATE + "/checked.json"
CACHE = STATE + "/cache"                # the plan's .debs
LISTS = STATE + "/lists"                # the package lists the plan was made from (hard links)
PREFS = STATE + "/prefs.d"              # preferences for a plan that holds Handtop back (new image)
EMPTY = STATE + "/empty"
PREVIOUS = STATE + "/previous"          # the release to go back to (handtop=previous)
NEXT = PREVIOUS + ".next"               # staged by download, becomes PREVIOUS when the install starts
OLD = PREVIOUS + ".old"
DROP = PREVIOUS + ".drop"               # a kept release being deleted (renamed first, then removed)
LKG = STATE + "/lkg"                    # last copies of the worker and handtop-recovery that worked
NO_PREDECESSOR = STATE + "/no-predecessor"   # a plan whose installed release can't be kept for going back
RELEASES = "/usr/local/share/handtop/releases.tsv"   # files Handtop put on v0.4.x cards (tools/release-data.py)
BOOT_TEMPLATES = "/usr/local/share/handtop/boot"     # recovery.txt, rg35xxh-input.conf as images write them
BACKUP = "/var/backups/handtop-migrate"              # files the user changed that the migration replaced
MIGRATE_TARGETS = ("handtop", "handtop-platform-h700")
MODEL = "/etc/handtop/model"
BOOT_PENDING = STATE + "/boot-files-pending.json"    # a migration's FAT files not written yet
UNITS_SEEN = "/var/lib/handtop/units-enabled"         # the packages' postinst enables a unit once
MIGRATE_DROPINS = ("rg35xxh-bootlogo.service", "rg35xxh-bt-check.service")   # handtop-migrate's
DROPIN_NAME = "handtop-migrate-maintenance.conf"
FATSEQ = STATE + "/fat-seq"
MARKER = "/system-update"
MARKER_ETC = "/etc/system-update"     # systemd's second marker: only ever another updater's
LOCK = "/run/handtop-update.lock"
LOGDIR = "/var/log/handtop-update"
FAT = "/boot/firmware"
BOOT_ABI = "/etc/handtop/boot-abi"
MAIN_SOURCES = "/etc/apt/sources.list.d/handtop.sources"             # handtop-keyring's; never edited
CHANNEL_SOURCES = "/etc/apt/sources.list.d/handtop-testing.sources"  # 'channel testing'
TESTING_STANZA = """\
# Written by 'handtop-update channel testing' (Update app); 'channel stable' removes it.
# Packages from testing stay installed until stable has the same or newer versions.
Types: deb
URIs: https://junsulee119.github.io/handtop-apt
Suites: trixie-testing
Components: main
Signed-By: /usr/share/keyrings/handtop-archive.asc
"""
POLICY_RC = "/usr/sbin/policy-rc.d"
POLICY_SAVED = POLICY_RC + ".handtop-saved"
POLICY_BODY = "#!/bin/sh\n# handtop-update: no service starts during the maintenance boot\nexit 101\n"
APPLY_UNIT = "handtop-update-apply.service"
SYSFS = os.environ.get("HANDTOP_UPDATE_SYSFS", "/sys")          # tests point it at a fake tree
NO_POWER_ACTION = os.environ.get("HANDTOP_UPDATE_NO_POWER_ACTION") == "1"   # tests: chroot
CHROOT_TEST = os.environ.get("HANDTOP_UPDATE_CHROOT") == "1"   # tests: systemd can't answer is-active
MAX_ATTEMPTS = 3          # maintenance boots per plan that start installing (power cuts included)
MAX_DEFERRALS = 3         # maintenance boots that switch off without installing (unknown battery)
MIN_INODES = 20000        # free inodes to install (the themes alone are thousands of small files)
MIN_BATTERY = 40          # to schedule without the charger
STOP_BATTERY = 10         # the maintenance boot switches off below this and continues later
CHECK_MAX_AGE = 24 * 3600
APPLY_BUDGET = 100 * 60   # handtop-update-apply.service has TimeoutStartSec=120min
CONTROLLER_UNITS = ("rg35xxh-btpad", "rg35xxh-btclassic", "rg35xxh-usbpad",
                    "rg35xxh-switchpad", "rg35xxh-switchbt")
FFMPEG_FAMILY = ("ffmpeg", "libavcodec61", "libavdevice61", "libavfilter10", "libavformat61",
                 "libavutil59", "libpostproc58", "libswresample5", "libswscale8")
FFMPEG_DEV = ("libavcodec-dev", "libavdevice-dev", "libavfilter-dev", "libavformat-dev",
              "libavutil-dev", "libpostproc-dev", "libswresample-dev", "libswscale-dev")
LEGACY_HOLDS = FFMPEG_FAMILY[1:]   # the 8 libraries v0.4.x images held (the ffmpeg CLI was unowned)
MIGRATE_HOLDS = STATE + "/migrate-holds.json"   # holds the migration released (put back on cancel)
NEVER_ROLLED_BACK = ("handtop-keyring",)    # an old keyring could lack the current signing key
APT_ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C",
               APT_LISTCHANGES_FRONTEND="none", PATH="/usr/sbin:/usr/bin:/sbin:/bin")
CONF = ["--force-confdef", "--force-confold"]
# Dpkg::Use-Pty=0: apt runs dpkg in a PTY in a new session otherwise, outside the process group a
# time-out stops (review 2026-11-26 #68).
APT_CONF = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold",
            "-o", "Dpkg::Use-Pty=0"]


class Fail(Exception):
    pass


class Drift(Fail):
    """The card no longer matches the plan: retrying can't help."""


class Stuck(Drift):
    """A timed-out command left processes or dpkg's lock behind: no retry in place (the restart that
    follows ends them)."""


def out(obj):
    print(json.dumps(obj, indent=1, sort_keys=True), flush=True)


# ---- files ------------------------------------------------------------------------------------

def fsync_dir(path):
    d = os.open(path, os.O_RDONLY)
    try:
        os.fsync(d)
    finally:
        os.close(d)


def write_atomic(path, data, mode=0o644):
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb" if isinstance(data, bytes) else "w") as f:      # text or bytes
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.rename(tmp, path)
    fsync_dir(os.path.dirname(path) or ".")


def write_json(path, obj):
    write_atomic(path, json.dumps(obj, indent=1, sort_keys=True))


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def unlink(path):
    if os.path.lexists(path):
        os.unlink(path)


def rmtree(path):
    if os.path.lexists(path):
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path)
        else:
            os.unlink(path)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def free_space(path):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize // (1 << 20), st.f_favail


# ---- logs -------------------------------------------------------------------------------------

class Log:
    """Root log in /var/log/handtop-update; command output is streamed into it as it comes."""

    def __init__(self, kind):
        os.makedirs(LOGDIR, exist_ok=True)
        self.path = os.path.join(LOGDIR, "%s-%s.log" % (kind, time.strftime("%Y%m%d-%H%M%S")))
        self.f = open(self.path, "a", buffering=1)

    def __call__(self, text):
        self.f.write(time.strftime("%H:%M:%S ") + text.rstrip("\n") + "\n")
        self.f.flush()

    def sync(self):
        try:
            os.fsync(self.f.fileno())
        except OSError:
            pass


def tail(path, n):
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - n))
        return f.read().decode("utf-8", "replace")


def _descendants(pid):
    """Every process below pid (by parent links in /proc), including ones in other sessions."""
    kids = {}
    for e in os.listdir("/proc"):
        if not e.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % e) as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        kids.setdefault(ppid, []).append(int(e))
    res, todo = [], [pid]
    while todo:
        for c in kids.get(todo.pop(), []):
            res.append(c)
            todo.append(c)
    return res


def _alive(pid):
    """Running (a zombie, waiting to be reaped, doesn't count)."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            return f.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return False


def _group_alive(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return any(_alive(int(e)) for e in os.listdir("/proc") if e.isdigit() and _pgid(int(e)) == pgid)


def _pgid(pid):
    try:
        return os.getpgid(pid)
    except OSError:
        return None


def dpkg_lock_free():
    """True when no process holds dpkg's locks (fcntl locks, as dpkg takes them)."""
    for name in ("lock-frontend", "lock"):
        path = "/var/lib/dpkg/" + name
        try:
            fd = os.open(path, os.O_RDWR)
        except FileNotFoundError:
            continue
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.lockf(fd, fcntl.LOCK_UN)
        except OSError:
            return False
        finally:
            os.close(fd)
    return True


def _stop_group(p):
    """Stop a command and everything it started (apt's dpkg, maintainer scripts): TERM, then KILL, to
    its process group and every process below it (found before signalling: an orphan loses its
    parent link). Raises Stuck when any of them, or dpkg's lock, is still there afterwards."""
    procs = set()
    for sig, wait in ((signal.SIGTERM, 10), (signal.SIGKILL, 30)):
        procs |= set(_descendants(p.pid))
        for kill, target in [(os.killpg, p.pid)] + [(os.kill, x) for x in procs]:
            try:
                kill(target, sig)
            except (ProcessLookupError, PermissionError):
                pass
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            p.poll()
            if p.returncode is not None and not _group_alive(p.pid) and not any(_alive(x) for x in procs):
                break
            time.sleep(0.5)
        else:
            continue
        break
    # Done only when the command itself is gone (reaped), its group is empty, every process found
    # below it is gone and dpkg's locks are free (review 2026-11-27 #90).
    for _ in range(20):
        p.poll()
        left = sorted(x for x in procs if _alive(x))
        if p.returncode is not None and not _group_alive(p.pid) and not left and dpkg_lock_free():
            return
        time.sleep(0.5)
    why = ("the command itself" if p.returncode is None else "its process group" if _group_alive(p.pid)
           else "processes %s" % left if left else "dpkg's lock")
    raise Stuck("a timed-out command left %s behind; not retrying until the restart" % why)


def run(cmd, timeout, log=None, check=True, cwd=None):
    """Run cmd in its own process group (a time-out stops all of it). With a log, output goes straight
    to the log file (so a power cut leaves what the command printed so far; synced every 2 s); the
    result's stdout is then the last part of it."""
    deadline = time.monotonic() + timeout
    if log:
        log("$ " + " ".join(cmd))
        start = log.f.tell()
        p = subprocess.Popen(cmd, env=APT_ENV, cwd=cwd, stdout=log.f, stderr=subprocess.STDOUT,
                             start_new_session=True)
        try:
            while True:
                try:
                    p.wait(timeout=2)
                    break
                except subprocess.TimeoutExpired:
                    log.sync()
                    if time.monotonic() > deadline:
                        _stop_group(p)
                        raise subprocess.TimeoutExpired(cmd, timeout)
        finally:
            log.f.flush()
            log.sync()
        with open(log.path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(start, f.tell() - 20000))
            text = f.read().decode("utf-8", "replace")
        p.stdout = text
    else:
        p = subprocess.Popen(cmd, env=APT_ENV, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, errors="replace", start_new_session=True)
        try:
            out, _ = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            _stop_group(p)
            raise
        p.stdout = out
    if check and p.returncode != 0:
        raise Fail("%s failed (%d): %s" % (" ".join(cmd[:2]), p.returncode, p.stdout.strip()[-600:]))
    return p


def copy_log_to_fat(path, kind):
    """A short copy on the boot partition (logs\\<kind>-NNNNNN.txt), readable from any PC; the last
    5 are kept. Best effort: never part of a transaction."""
    try:
        if not os.path.ismount(FAT) or not os.access(FAT, os.W_OK):
            return
        logs = FAT + "/logs"
        os.makedirs(logs, exist_ok=True)
        seq = (read_json(FATSEQ) or {}).get(kind, 0) + 1
        write_json(FATSEQ, dict(read_json(FATSEQ) or {}, **{kind: seq}))
        name = "%s-%06d.txt" % (kind, seq % 1000000)
        write_atomic(os.path.join(logs, name), tail(path, 60000).replace("\r", "").replace("\n", "\r\n"))
        mine = sorted((f for f in os.listdir(logs) if re.match(kind + r"-\d{6}\.txt$", f)),
                      key=lambda f: os.path.getmtime(os.path.join(logs, f)))
        for f in mine[:-5]:
            os.unlink(os.path.join(logs, f))
    except Exception:       # noqa: BLE001 - a broken FAT must never stop an update from finishing
        pass


def console(msg):
    line = "Handtop: %s" % msg
    print(line, flush=True)
    try:
        with open("/dev/tty1", "w") as t:
            t.write("\r\n" + line + "\r\n")
    except OSError:
        pass


# ---- system state -------------------------------------------------------------------------------

def lock(wait=0):
    f = open(LOCK, "w")
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except OSError:
            if time.time() >= end:
                f.close()
                raise Fail("another update operation is running")
            time.sleep(1)


_NATIVE = []


def native_arch():
    if not _NATIVE:
        _NATIVE.append(run(["dpkg", "--print-architecture"], timeout=30).stdout.strip())
    return _NATIVE[0]


def installed():
    """{package: version} of the installed packages, held ones included. Names as apt prints them:
    plain for the native architecture and all, name:arch for a foreign one."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${Architecture}\\t${Version}\\t${db:Status-Abbrev}\\n"],
            timeout=60)
    res = {}
    for line in p.stdout.splitlines():
        name, arch, ver, st = line.split("\t")
        if len(st) > 1 and st[1] == "i":
            res[name if arch in (native_arch(), "all") else "%s:%s" % (name, arch)] = ver
    return res


def installed_any():
    """{package: version} including packages a cut left unpacked or half-configured."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${Version}\\t${db:Status-Abbrev}\\n"], timeout=60)
    return {n: v for n, v, st in (l.split("\t") for l in p.stdout.splitlines()) if len(st) > 1 and st[1] in "iUHFWt"}


def installed_healthy():
    """{package: version} of fully installed packages only (no cut, no error flag)."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${Version}\\t${db:Status-Abbrev}\\n"], timeout=60)
    return {n: v for n, v, st in (l.split("\t") for l in p.stdout.splitlines())
            if st[:1] in ("i", "h") and st[1:2] == "i" and st[2:3] in ("", " ")}


def pending_packages():
    """Packages dpkg hasn't finished with (unpacked, half-installed, half-configured, triggers)."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${db:Status-Abbrev}\\n"], timeout=60)
    return sorted(n for n, st in (l.split("\t") for l in p.stdout.splitlines()) if len(st) > 1 and st[1] in "UHFWt")


def require_clean_dpkg():
    left = pending_packages()
    if left:
        raise Fail("dpkg has unfinished work (%s): finish it first (sudo dpkg --configure -a)"
                   % ", ".join(left[:8]))


def pending_state():
    """[(name as apt prints it, version, status)] of packages dpkg hasn't finished with."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${Architecture}\\t${Version}\\t${db:Status-Abbrev}\\n"],
            timeout=60)
    res = []
    for line in p.stdout.splitlines():
        name, arch, ver, st = line.split("\t")
        if len(st) > 1 and (st[1] in "UHFWt" or (len(st) > 2 and st[2] not in " ")):   # also error flags
            res.append((name if arch in (native_arch(), "all") else "%s:%s" % (name, arch), ver,
                        st[1] if st[1] in "UHFWt" else "R"))
    return res


def plan_changed(plan):
    """True once an attempt at this plan has started changing packages (kept across attempts and
    reschedules: a kept migration resumes after a cut in the middle of its install)."""
    return (read_json(CHANGED) or {}).get("plan") == plan.get("id")


def mark_changed(plan):
    """Recorded (synced) right before the first package change of a plan."""
    if not plan_changed(plan):
        write_json(CHANGED, {"plan": plan["id"], "time": int(time.time())})


def dpkg_state_check(plan, any_version=False):
    """Before anything of this plan changed packages, dpkg must have no unfinished work at all (it
    would run unchecked: review 2026-11-26 #67). After a cut, only the plan's own packages may be
    unfinished, at their old or planned version, plus trigger states (they run the installed versions'
    own triggers). any_version (going back): the plan's packages at whatever version the failed
    release left them, also on the first attempt; anything else unfinished still stops it."""
    pend = pending_state()
    if not any_version and not plan_changed(plan):
        if pend:
            raise Fail("dpkg has unfinished work (%s): nothing changed; finish it first "
                       "(sudo dpkg --configure -a)" % ", ".join("%s %s" % (n, v) for n, v, _ in pend[:8]))
        return
    allowed = {}
    for p in plan["packages"]:
        allowed.setdefault(p["name"], set()).update(x for x in (p.get("old"), p.get("new"), p.get("version")) if x)
    for n in plan.get("remove", []):
        allowed.setdefault(n, None)
    other = ["%s %s" % (n, v) for n, v, st in pend if (st not in "tW" or any_version) and not (
        n in allowed and (any_version or allowed[n] is None or v in allowed[n]))]   # recovery: no others' triggers
    if other:
        raise Drift("dpkg has unfinished work outside this update (%s): not continuing; finish it "
                    "(sudo dpkg --configure -a)" % ", ".join(other[:8]))


def boot_abi():
    res = {}
    try:
        for line in open(BOOT_ABI):
            k, _, v = line.strip().partition("=")
            res[k] = v
    except OSError:
        pass
    return res


def our_marker():
    """True: the marker is ours. None: no marker. False: someone else's offline update (either of
    systemd's two marker paths)."""
    if os.path.lexists(MARKER_ETC):
        return False
    if not os.path.lexists(MARKER):
        return None
    try:
        return os.path.islink(MARKER) and os.readlink(MARKER) == STATE
    except OSError:
        return False


def set_marker():
    if our_marker() is False:
        raise Fail("another offline update is scheduled (/system-update); not touching it")
    if our_marker() is None:
        os.symlink(STATE, MARKER)
    fsync_dir("/")


def remove_marker():
    if our_marker():
        os.unlink(MARKER)
        fsync_dir("/")


def battery():
    """(capacity or None, charging, has_battery)."""
    def rd(p):
        try:
            with open(os.path.join(SYSFS, p)) as f:
                return f.read().strip()
        except OSError:
            return None
    has = os.path.isdir(os.path.join(SYSFS, "class/power_supply/battery"))
    cap = rd("class/power_supply/battery/capacity")
    cap = int(cap) if cap and cap.isdigit() and 0 <= int(cap) <= 100 else None
    return cap, rd("class/power_supply/axp20x-usb/online") == "1", has


def handheld():
    """A battery-powered Anbernic handheld (its device tree says so), as opposed to a test machine."""
    try:
        with open("/proc/device-tree/compatible", "rb") as f:
            return b"anbernic," in f.read()
    except OSError:
        return False


def power_ok(minimum):
    """None if fine, else the reason. Unknown is only fine on a machine without a battery: on the
    handheld a battery that hasn't shown up yet counts as unreadable, not as absent."""
    cap, charging, has = battery()
    if charging or not (has or handheld()):
        return None
    if cap is None:
        return "the battery level can't be read"
    if cap < minimum:
        return "battery at %d%%" % cap
    return None


def controller_mode_active():
    if CHROOT_TEST:
        return None
    for u in CONTROLLER_UNITS:
        p = subprocess.run(["systemctl", "is-active", u + ".service"], stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, text=True, timeout=15)
        state = p.stdout.strip()
        if state in ("active", "activating", "reloading", "deactivating", "refreshing"):
            return u
        if state not in ("inactive", "failed", "unknown"):
            raise Fail("can't tell whether %s is running (%s)" % (u, state or "no answer from systemd"))
    return None


# ---- what apt would do ----------------------------------------------------------------------------

def apt_opts(frozen=False, held=False):
    o = []
    if frozen:
        o += ["-o", "Dir::State::Lists=" + LISTS, "-o", "Dir::Cache::pkgcache=",
              "-o", "Dir::Cache::srcpkgcache="]
    if held:
        o += ["-o", "Dir::Etc::PreferencesParts=" + PREFS]
    return o + APT_CONF


def parse_sim(text):
    """(installs, removals); parse_sim.confs: the (package, version) pairs apt would configure."""
    inst, removes, confs = [], [], []
    for line in text.splitlines():
        m = re.match(r"^Inst (\S+) (?:\[(\S+)\] )?\((\S+) (.*?)(?: \[(\S+)\])?\)", line)
        if m:
            inst.append({"name": m.group(1), "old": m.group(2), "new": m.group(3),
                         "origin": m.group(4), "arch": m.group(5)})
        m = re.match(r"^(?:Remv|Purg) (\S+)", line)
        if m:
            removes.append(m.group(1))
        m = re.match(r"^Conf (\S+) \((\S+)", line)
        if m:
            confs.append((m.group(1), m.group(2)))
    parse_sim.confs = confs
    return inst, removes


def simulate(opts, extra=(), what=("dist-upgrade",)):
    p = run(["apt-get", "-s", "-q"] + list(extra) + opts + list(what), timeout=300)
    inst, removes = parse_sim(p.stdout)
    if removes:
        raise Fail("the update would remove packages (%s); not doing it" % ", ".join(removes))
    return inst


def is_handtop(name):
    return name == "handtop" or name.startswith("handtop-")


def write_held_prefs():
    """Preferences for a Debian-only plan: Handtop's packages and FFmpeg build stay where they are."""
    rmtree(PREFS)
    os.makedirs(PREFS)
    if os.path.isdir("/etc/apt/preferences.d"):
        for f in os.listdir("/etc/apt/preferences.d"):
            src = os.path.join("/etc/apt/preferences.d", f)
            if os.path.isfile(src):
                shutil.copy(src, os.path.join(PREFS, f))
    # apt uses the first matching pin and reads the files in name order: this one must come first.
    write_atomic(PREFS + "/00-handtop-new-image", (
        "# handtop-update: this card needs a new image for the next Handtop release; until then\n"
        "# only Debian's updates are installed.\n"
        "Package: handtop handtop-* %s %s\nPin: release o=Handtop\nPin-Priority: -1\n")
        % (" ".join(FFMPEG_FAMILY), " ".join(FFMPEG_DEV)))


def modules_mismatch(inst, opts, want=None):
    """Modules packages in the plan whose kernel (Handtop-Kernel-SHA256) isn't this card's."""
    want = want or boot_abi().get("kernel_sha256")
    bad = []
    for i in inst:
        if not i["name"].startswith("handtop-modules-"):
            continue
        tmp = STATE + "/modcheck"
        rmtree(tmp)
        os.makedirs(tmp)
        stage_for_apt(tmp)
        try:
            run(["apt-get", "download", "-q"] + opts + ["%s=%s" % (i["name"], i["new"])], timeout=600, cwd=tmp)
            debs = [f for f in os.listdir(tmp) if f.endswith(".deb")]
            have = run(["dpkg-deb", "-f", os.path.join(tmp, debs[0]), "Handtop-Kernel-SHA256"],
                       timeout=60).stdout.strip() if debs else ""
        finally:
            rmtree(tmp)
        if not want or not have or have != want:
            bad.append(i["name"])
    return bad


def plan_transaction(frozen):
    """(updates, handtop_held, new_image_packages)."""
    inst = simulate(apt_opts(frozen))
    bad = modules_mismatch(inst, apt_opts(frozen))
    if not bad:
        return inst, False, []
    write_held_prefs()
    inst = simulate(apt_opts(frozen, held=True))
    still = [i["name"] for i in inst if is_handtop(i["name"].split(":")[0])
             or i["name"].split(":")[0] in FFMPEG_FAMILY + FFMPEG_DEV]          # name:arch too (#58)
    if still:    # e.g. an administrator's pin outranks ours: refuse rather than install them
        raise Fail("this card needs a new image, but the Debian-only update would still change %s "
                   "(check /etc/apt/preferences.d)" % ", ".join(still))
    return inst, True, bad


def ffmpeg_pin_effective():
    """Handtop's pin works for every FFmpeg package: each one's Debian versions are at -1, and each has
    at least one (a failed query or no evidence = not shown to work, so holds stay)."""
    p = run(["apt-cache", "policy"] + list(FFMPEG_FAMILY), timeout=120, check=False)
    if p.returncode != 0:
        return False
    sections = re.split(r"^(\S+):\s*$", p.stdout, flags=re.M)
    found = {sections[i]: sections[i + 1] for i in range(1, len(sections) - 1, 2)}
    return all(n in found and debian_versions_pinned_out(found[n], need_evidence=True) for n in FFMPEG_FAMILY)


def debian_versions_pinned_out(policy, need_evidence=False):
    """apt-cache policy's version table: each version line ("[***] VERSION PIN") is followed by its
    sources ("PRIORITY URI ..."). True when every version a debian.org source offers has pin -1
    (need_evidence: and at least one such version is listed)."""
    pins, cur = [], None
    for line in policy.splitlines():
        m = re.match(r"^\s+(?:\*\*\* )?(\S+) (-?\d+)$", line)
        if m:
            cur = int(m.group(2))
            continue
        if cur is not None and re.match(r"^\s+-?\d+ \S*debian\.org", line):
            pins.append(cur)
    return all(x == -1 for x in pins) and (bool(pins) or not need_evidence)


def held_ffmpeg():
    """Handtop's FFmpeg packages the user (or a v0.4.x image) holds; updates to them are skipped."""
    held = set(run(["apt-mark", "showhold"], timeout=60).stdout.split())
    return [n for n in FFMPEG_FAMILY + FFMPEG_DEV if n in held]


def hold_warnings():
    h = held_ffmpeg()
    return ["held, so not updated: %s (apt-mark unhold to allow it)" % ", ".join(h)] if h else []


def release_legacy_holds():
    """Migration only: release the holds v0.4.x images set on FFmpeg's libraries, once Handtop's pin is
    shown to work, and remember them (cancel puts them back)."""
    rel = [n for n in held_ffmpeg() if n in LEGACY_HOLDS]
    if not rel:
        return
    if not ffmpeg_pin_effective():
        raise Fail("Handtop's FFmpeg pin is not in effect (/etc/apt/preferences.d/handtop.pref); "
                   "FFmpeg stays held and nothing was changed")
    prev = (read_json(MIGRATE_HOLDS) or {}).get("released", [])
    write_json(MIGRATE_HOLDS, {"released": sorted(set(prev) | set(rel))})
    run(["apt-mark", "unhold"] + rel, timeout=60)


def restore_legacy_holds(keep_journal=False):
    """Hold again what the migration released. The journal stays when apt-mark fails (tried again
    later) or keep_journal (a kept migration releases them again when it resumes)."""
    rel = (read_json(MIGRATE_HOLDS) or {}).get("released", [])
    have = installed_any()
    rel = [n for n in rel if n in have]
    if rel and run(["apt-mark", "hold"] + rel, timeout=60, check=False).returncode != 0:
        return False
    if not keep_journal:
        unlink(MIGRATE_HOLDS)
    return True


def release_notes(version):
    """The Handtop release and its short notes, from the handtop metapackage's control data in the
    signed index (Handtop-Release, Handtop-Changes)."""
    p = run(["apt-cache", "show", "handtop=%s" % version], timeout=60, check=False)
    rel, lines, inside = None, [], False
    for line in p.stdout.splitlines():
        if line.startswith("Handtop-Release:"):
            rel = line.split(":", 1)[1].strip()
            inside = False
        elif line.startswith("Handtop-Changes:"):
            inside = True
            first = line.split(":", 1)[1].strip()
            if first:
                lines.append(first)
        elif inside and line.startswith(" "):
            lines.append(line.strip())
        elif line.strip() == "":
            if rel or lines:
                break
        else:
            inside = False
    return {"release": rel, "lines": lines}


def cmd_check():
    with lock():
        warnings = hold_warnings()
        p = run(["apt-get", "update", "-q", "--error-on=any"], timeout=600, check=False)
        problems = [l for l in p.stdout.splitlines() if l.startswith(("E:", "W:", "Err:"))]
        if p.returncode != 0:
            write_json(CHECKED, {"ok": False, "time": int(time.time())})
            out({"ok": False, "error": "could not refresh every package list", "details": problems})
            return 1
        write_json(CHECKED, {"ok": True, "time": int(time.time())})
        inst, held, bad = plan_transaction(frozen=False)
        handtop = [i for i in inst if "Handtop" in i["origin"] or is_handtop(i["name"])]
        meta = next((i for i in inst if i["name"] == "handtop"), None)
        size = sum(v["size"] for v in archive_info(apt_opts(False, held), held, hashes=False).values()) \
            if inst else 0
        out({"ok": True, "updates": inst, "handtop": handtop, "debian": len(inst) - len(handtop),
             "warnings": warnings + problems, "new_image_needed": bad, "handtop_held": held,
             "download_mb": round(size / (1 << 20), 1),
             "release_notes": release_notes(meta["new"]) if meta else None})
        return 0


# ---- download -------------------------------------------------------------------------------------

def stage_for_apt(path):
    """apt-get download keeps its network sandbox only where _apt can write."""
    try:
        import pwd
        os.chown(path, pwd.getpwnam("_apt").pw_uid, 0)
    except (KeyError, OSError):
        pass


def freeze_lists():
    tmp = LISTS + ".new"
    rmtree(tmp)
    os.makedirs(tmp + "/partial")
    src = "/var/lib/apt/lists"
    for f in os.listdir(src):
        p = os.path.join(src, f)
        if os.path.isfile(p) and not os.path.islink(p) and f != "lock":
            os.link(p, os.path.join(tmp, f))   # apt replaces lists by rename: the link keeps this copy
    rmtree(LISTS)
    os.rename(tmp, LISTS)


def archive_info(opts, held, hashes=True, what=("dist-upgrade",)):
    """{(name, version, arch): {file, size, algo, hash}} for every archive of the plan. Names and sizes
    come from apt's download list (asked against an empty archive directory, so already-downloaded
    files count too); the SHA-256 from the signed package indexes (apt-cache show), because the
    download list gives only the weakest hash, or none (Debian's security archive, apt 3.0)."""
    rmtree(EMPTY)
    os.makedirs(EMPTY + "/partial")
    p = run(["apt-get", "-qq", "--print-uris", "-o", "Dir::Cache::archives=" + EMPTY] + opts
            + list(what), timeout=300)
    rmtree(EMPTY)
    res = {}
    from urllib.parse import unquote
    for line in p.stdout.splitlines():
        m = re.match(r"^'(\S+)' (\S+) (\d+)", line)
        if not m:
            continue
        fname = m.group(2)
        parts = fname[:-4].split("_") if fname.endswith(".deb") else []
        if len(parts) != 3:
            continue
        res[(parts[0], unquote(parts[1]), parts[2])] = {"file": fname, "size": int(m.group(3)),
                                                         "algo": "sha256", "hash": None}
    if hashes and res:
        add_sha256(res, opts)
    return res


def add_sha256(res, opts):
    """Fill in each archive's SHA-256 from the package indexes; refuse an archive without one."""
    p = run(["apt-cache", "show"] + opts + ["%s:%s=%s" % (n, a, v) for n, v, a in res], timeout=300)
    for st in p.stdout.split("\n\n"):
        f = dict(re.findall(r"^(Package|Version|Architecture|SHA256|Size): (\S+)$", st, re.M))
        key = (f.get("Package"), f.get("Version"), f.get("Architecture"))
        if key in res and f.get("SHA256") and int(f.get("Size", -1)) == res[key]["size"]:
            h = f["SHA256"].lower()
            if res[key]["hash"] and res[key]["hash"] != h:
                # Two sources offer the same package, version and size with different contents:
                # which one apt picks can't be told from here.
                raise Fail("%s %s is offered with two different contents (two sources?): not downloading"
                           % (key[0], key[1]))
            res[key]["hash"] = h
    missing = ["%s %s" % (n, v) for (n, v, _), r in res.items() if not r["hash"]]
    if missing:
        raise Fail("no SHA-256 in the package indexes for %s" % ", ".join(missing))


def file_ok(path, algo, digest):
    if not os.path.isfile(path):
        return False
    if algo == "sha256":
        return sha256(path) == digest
    h = hashlib.new({"md5sum": "md5", "sha1": "sha1", "sha512": "sha512"}.get(algo, algo))
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest() == digest


def verify_files(packages, where):
    bad = [p["name"] for p in packages if not file_ok(os.path.join(where, p["file"]), p["algo"], p["hash"])]
    if bad:
        raise Fail("downloaded files missing or damaged: %s; download again" % ", ".join(bad))


def rollback_set(have):
    """Packages to keep for going back: Handtop's own (but the keyring) and Handtop's FFmpeg build."""
    names = [n for n in have if is_handtop(n) and n not in NEVER_ROLLED_BACK]
    names += [n for n in FFMPEG_FAMILY + FFMPEG_DEV if n in have and "+handtop" in have[n]]
    return sorted(names)


def stage_previous(plan_id, opts, need_mb=0):
    """Download the installed release into previous.next (previous/ stays as it is until the
    install starts). Returns its manifest. need_mb: what the plan itself needs on top; the space for
    both is checked before this download starts (review 2026-11-26 #54)."""
    have = installed()
    names = rollback_set(have)
    tmp = NEXT + ".tmp"
    rmtree(tmp)
    os.makedirs(tmp)
    stage_for_apt(tmp)
    want = ["%s=%s" % (n, have[n]) for n in names]
    if want:
        uris = run(["apt-get", "download", "--print-uris", "-q"] + opts + want, timeout=300, check=False, cwd=tmp)
        if uris.returncode != 0:
            rmtree(tmp)
            raise Fail("can't find the installed release's packages to keep for going back: %s"
                       % uris.stdout.strip()[-300:])
        prev_mb = sum(int(m.group(1)) for m in re.finditer(r"^'\S+' \S+ (\d+)", uris.stdout, re.M)) / 1e6
        mb, inodes = free_space(STATE)
        if mb < prev_mb + need_mb + 200 or inodes < MIN_INODES:
            rmtree(tmp)
            raise Fail("not enough free space to keep the current release for going back and install the "
                       "update (%d MB free, %d MB needed)" % (mb, prev_mb + need_mb + 200))
    p = run(["apt-get", "download", "-q"] + opts + want, timeout=1800, check=False, cwd=tmp) if want else None
    os.chown(tmp, 0, 0)
    pkgs, missing = [], []
    for n in names:
        f = [x for x in os.listdir(tmp) if x.startswith(n + "_") and x.endswith(".deb")]
        if not f:
            missing.append(n)
            continue
        path = os.path.join(tmp, f[0])
        os.chown(path, 0, 0)
        ver = run(["dpkg-deb", "-f", path, "Version"], timeout=60).stdout.strip()
        if ver != have[n]:
            missing.append(n)
            continue
        pkgs.append({"name": n, "version": ver, "file": f[0], "algo": "sha256", "hash": sha256(path)})
    manifest = {"for_plan": plan_id, "release": have.get("handtop"), "packages": pkgs,
                "complete": not missing and bool(pkgs), "missing": missing,
                "warnings": [l for l in (p.stdout.splitlines() if p else []) if l.startswith(("W:", "E:"))]}
    write_json(tmp + "/manifest.json", manifest)
    rmtree(NEXT)
    os.rename(tmp, NEXT)
    fsync_dir(STATE)
    return manifest


# ---- going back: trial (changes nothing) ----------------------------------------------------------

def _vcmp(a, op, b):
    try:
        import apt_pkg
        apt_pkg.init_system()
        c = apt_pkg.version_compare(a, b)
    except ImportError:
        if subprocess.run(["dpkg", "--compare-versions", a, "eq", b]).returncode == 0:
            c = 0
        else:
            c = -1 if subprocess.run(["dpkg", "--compare-versions", a, "lt", b]).returncode == 0 else 1
    return {"<<": c < 0, "<=": c <= 0, "=": c == 0, ">=": c >= 0, ">>": c > 0}[op]


def _deps(text):
    res = []
    for group in filter(None, (g.strip() for g in (text or "").split(","))):
        alts = []
        for a in group.split("|"):
            m = re.match(r"^\s*([a-z0-9][a-z0-9+.-]*)(?::\S+)?\s*(?:\(\s*(<<|<=|=|>=|>>)\s*([^)\s]+)\s*\))?", a.strip())
            if m:
                alts.append((m.group(1), m.group(2), m.group(3)))
        res.append(alts)
    return res


def _fields(deb):
    """(package, version, depends + pre-depends, provides, breaks + conflicts) of a .deb."""
    p = run(["dpkg-deb", "-f", deb, "Package", "Version", "Depends", "Pre-Depends", "Provides", "Breaks",
             "Conflicts"], timeout=60)
    f = dict(re.findall(r"^(\S+): (.*)$", p.stdout, re.M))
    j = lambda *k: ", ".join(x for x in (f.get(n) for n in k) if x)
    return f.get("Package"), f.get("Version"), j("Depends", "Pre-Depends"), f.get("Provides", ""), j("Breaks", "Conflicts")


def _providers(state):
    providers = {}
    for name, (_, _, provides, _) in state.items():
        for virtual, _, version in sum(_deps(provides), []):
            providers.setdefault(virtual, []).append((name, version))    # None: unversioned
    return providers


def _group_satisfied(group, state, providers):
    for name, op, ver in group:
        if name in state and (not op or _vcmp(state[name][0], op, ver)):
            return True
        if any(not op or (pv and _vcmp(pv, op, ver)) for _, pv in providers.get(name, [])):
            return True
    return False


def trial_rollback(plan, manifest, where=NEXT, live=False):
    """Would going back leave every relationship satisfied? At download, start from the projected
    state after the update. Live, use the saved recovery plan and also check Pre-Depends at unpack.
    Returns None or the reason to refuse."""
    if not manifest or not manifest.get("complete"):
        return "the release to go back to isn't complete (%s)" % ", ".join((manifest or {}).get("missing", []) or ["none kept"])
    p = run(["dpkg-query", "-W", "-f", "${binary:Package}\\t${Version}\\t${Depends}, ${Pre-Depends}\\t"
             "${Provides}\\t${Breaks}, ${Conflicts}\\t${db:Status-Abbrev}\\n"], timeout=120)
    state, foreign, healthy = {}, {}, {}
    for line in p.stdout.splitlines():
        n, v, d, pr, br, st = line.split("\t")
        if len(st) > 1 and st[1] in "iUHFWt":
            if ":" in n and n.split(":", 1)[1] not in (native_arch(), "all"):
                foreign[n] = d                   # another architecture: not modelled, see below
                continue
            n = n.split(":")[0]
            state[n] = (v, d, pr, br)
            if st[:1] in ("i", "h") and st[1:2] == "i" and st[2:3] in ("", " "):
                healthy[n] = v
    if not live:
        for i in plan["packages"]:                               # project a successful update
            n = i["name"].split(":")[0]
            state[n] = _fields(os.path.join(CACHE, i["file"]))[1:]
            healthy[n] = state[n][0]
    before = dict(state)                                         # before going back
    back = {p["name"] for p in manifest["packages"]}
    if live:
        # A retry still runs the saved operations, including any reinstalls already done.
        restore = plan["packages"]
        gone = set(plan.get("remove", []))
    else:
        restore = [p for p in manifest["packages"] if healthy.get(p["name"]) != p["version"]]
        # Recovery removes the Handtop packages absent from the kept release, except the keyring.
        gone = {n for n in before if is_handtop(n) and n not in back and n not in NEVER_ROLLED_BACK}
    for n in gone:
        state.pop(n, None)
    for i in restore:
        n, v, d, pr, br = _fields(os.path.join(where, i["file"]))
        state[n] = (v, d, pr, br)
    changed = {p["name"] for p in restore} | gone
    touched = changed.copy()
    # Check reverse dependencies on virtual names the changed packages provide before or after.
    for n in changed:
        for snapshot in (before, state):
            if n in snapshot:
                touched.update(name for name, _, _ in sum(_deps(snapshot[n][2]), []))
    providers = _providers(state)
    for n, (v, d, pr, br) in state.items():
        deps = _deps(d)
        if n not in back and not any(a[0] in touched for g in deps for a in g):
            continue
        for g in deps:
            if not _group_satisfied(g, state, providers):
                return "after going back, %s would need %s" % (n, " | ".join(
                    "%s%s" % (a[0], " (%s %s)" % (a[1], a[2]) if a[1] else "") for a in g))
    # Packages of another architecture aren't modelled. Going back (live) is refused on such cards
    # (round 5); when an update is planned, only when one of them depends on what going back changes.
    if live and foreign:
        return "packages for another architecture are installed (%s)" % ", ".join(sorted(foreign)[:4])
    for n, d in foreign.items():
        hit = sorted({a[0] for g in _deps(d) for a in g} & touched)
        if hit:
            return "%s (another architecture) depends on %s" % (n, ", ".join(hit))
    if live:
        # Removals run first. A healthy package outside the saved operations can satisfy a
        # Pre-Depends even if another alternative or provider changes during unpack (#112, #124).
        at_install = {n: x for n, x in before.items() if n not in changed and n in healthy}
        at_install_providers = _providers(at_install)
        for i in restore:
            pre = run(["dpkg-deb", "-f", os.path.join(where, i["file"]), "Pre-Depends"], timeout=60).stdout.strip()
            for g in _deps(pre):
                if not _group_satisfied(g, at_install, at_install_providers):
                    return "%s's pre-dependency %s isn't there when it is installed" % (
                        i["name"], " | ".join(a[0] for a in g))
    for n, (v, d, pr, br) in state.items():                      # Breaks / Conflicts, either way
        for name, op, ver in sum(_deps(br), []):
            if name in state and name != n and (n in back or name in back):
                if not op or _vcmp(state[name][0], op, ver):
                    return "after going back, %s would break %s %s" % (n, name, state[name][0])
            for prov, pv in providers.get(name, []):             # a virtual name: who provides it
                if prov != n and (n in back or prov in back) and (not op or (pv and _vcmp(pv, op, ver))):
                    return "after going back, %s would break %s (provided by %s)" % (n, name, prov)
    return None


def fetch_plan(inst, opts, held, what=("dist-upgrade",)):
    """Download the archives of a simulated transaction into the cache; each one's SHA-256 from the
    signed indexes is checked. Returns (packages with file/size/hash, MB)."""
    info = archive_info(opts, held, what=what)
    pkgs = []
    for i in inst:
        name = i["name"].split(":")[0]
        arch = i["arch"] or (i["name"].split(":")[1] if ":" in i["name"] else None)
        keys = [k for k in info if k[0] == name and k[1] == i["new"] and (arch is None or k[2] == arch)]
        if len(keys) != 1:
            raise Fail("%s archive information for %s %s" % ("no" if not keys else "ambiguous", i["name"], i["new"]))
        key = keys[0]
        pkgs.append(dict(i, **info[key]))
    total = sum(p["size"] for p in pkgs) / (1 << 20)
    mb, inodes = free_space(STATE)
    need = 3 * total + 300
    if mb < need or inodes < 5000:
        raise Fail("not enough free space: about %d MB needed, %d MB free" % (need, mb))
    os.makedirs(CACHE + "/partial", exist_ok=True)
    stage_for_apt(CACHE + "/partial")
    for p in pkgs:      # apt reuses a cached file of the right size even when it is damaged
        f = os.path.join(CACHE, p["file"])
        if os.path.exists(f) and not file_ok(f, p["algo"], p["hash"]):
            os.unlink(f)
    run(["apt-get", "-q", "-y", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE] + opts
        + ["--download-only"] + list(what), timeout=3600)
    verify_files(pkgs, CACHE)
    return pkgs, total


def cmd_download():
    with lock():
        refuse_if_migration_kept()
        if our_marker():
            raise Fail("an update is scheduled: cancel it first")
        chk = read_json(CHECKED) or {}
        if not chk.get("ok") or time.time() - chk.get("time", 0) > CHECK_MAX_AGE:
            raise Fail("check for updates first")
        require_clean_dpkg()
        freeze_lists()
        inst, held, bad = plan_transaction(frozen=True)
        if not inst:
            out({"ok": True, "nothing": True, "new_image_needed": bad})
            return 0
        opts = apt_opts(True, held)
        pkgs, total = fetch_plan(inst, opts, held)
        autos = set(run(["apt-mark", "showauto"], timeout=60).stdout.split())
        plan = {"id": uuid.uuid4().hex[:12], "kind": "update", "created": int(time.time()),
                "packages": pkgs, "handtop_held": held, "new_image_needed": bad,
                "size_mb": round(total, 1),
                # installed as dependencies (or new ones a dist-upgrade pulls in): auto after the install
                "auto": sorted(p["name"] for p in pkgs if p["name"] in autos or not p["old"])}
        rmtree(NEXT)
        if any(is_handtop(p["name"]) or p["name"] in FFMPEG_FAMILY + FFMPEG_DEV for p in pkgs):
            # Plain apt options: the pins of a Debian-only plan must not stop this download.
            manifest = stage_previous(plan["id"], apt_opts(True), need_mb=2 * total)
            mb, inodes = free_space(STATE)
            if mb < 2 * total + 200 or inodes < MIN_INODES:
                rmtree(NEXT)
                raise Fail("not enough free space to install and keep the current release for going back "
                           "(%d MB free)" % mb)
            reason = trial_rollback(plan, manifest)
            plan["rollback"] = {"needed": True, "possible": reason is None, "reason": reason,
                                "no_predecessor": False}
        else:
            # Debian's packages only: nothing to keep for this update, but the release already kept
            # must still fit after it (a Debian update can break what an older Handtop needs). Not a
            # reason to hold back Debian's updates: the app says going back won't work afterwards.
            kept = read_json(PREVIOUS + "/manifest.json")
            reason = trial_rollback(plan, kept, PREVIOUS) if kept and kept.get("complete") else None
            plan["rollback"] = {"needed": False, "possible": True, "reason": None, "no_predecessor": False,
                                "kept_after": reason}
        write_json(PLAN, plan)
        unlink(SCHEDULE)
        out({"ok": True, "plan": plan["id"], "packages": len(pkgs), "download_mb": round(total, 1),
             "handtop_held": held, "new_image_needed": bad, "rollback": plan["rollback"],
             "warnings": hold_warnings()})
        return 0



# ---- migration: a v0.4.x card (files copied by the image, no Handtop packages) onto packages ------
# handtop-migrate (published with each release) sets up Handtop's key and source, takes this worker
# out of the release's handtop-core package and runs 'migrate' and 'schedule'. The maintenance boot
# installs the packages; afterwards config files the user never changed get the package's version
# and the ones they changed stay (the package's next to them), other changed files are backed up.

def _release_rows():
    with open(RELEASES) as f:
        for line in f:
            if line.startswith("#") or not line.strip():
                continue
            cols = line.rstrip("\n").split("\t")
            yield cols[:5] + [cols[5] if len(cols) > 5 else ""]


def release_data():
    """{release: {path: {variant: (type, value)}}} of Handtop's files, from releases.tsv."""
    data = {}
    for rel, var, path, typ, val, _mode in _release_rows():
        if typ != "x":
            data.setdefault(rel, {}).setdefault(path, {})[var] = (typ, val)
    return data


def release_extras(rel):
    """(modes {path: {octal mode as the release shipped it}}, old FFmpeg files {path: {sha256}})."""
    modes, legacy = {}, {}
    for r, _var, path, typ, val, mode in _release_rows():
        if r != rel:
            continue
        if typ == "x":
            legacy.setdefault(path, set()).add(val)
            if mode:
                legacy.setdefault(path + "\0mode", set()).add(mode)
        elif typ == "f" and mode:
            modes.setdefault(path, set()).add(mode)
    return modes, legacy


def card_value(path):
    """(type, sha256 or link target) of a file on this card, as releases.tsv records it; None if absent."""
    try:
        if os.path.islink(path):
            return ("l", os.readlink(path))
        if os.path.isfile(path):
            return ("f", sha256(path))
    except OSError:
        pass
    return None


def _root_files(paths):
    # The module rows are for adoption. Adding or deleting a module must not change identification.
    return {p for p in paths if p.startswith("/") and not p.startswith((FAT + "/", "/usr/lib/modules/"))}


def identify(data):
    """(release, variant, share of its files that match). The release whose files this card matches
    best, but only when it is clear-cut: almost all of the files only that release has are on the
    card, almost none of the files only the other releases have, and the boot partition's
    rootfix.cpio is one of that release's variants (DDR3 / DDR4). Anything else is refused."""
    scores = []
    for rel, paths in data.items():
        files = _root_files(paths)
        ok = sum(1 for p in files if card_value(p) in paths[p].values())
        scores.append((ok / max(1, len(files)), rel))
    scores.sort(reverse=True)
    share, rel = scores[0] if scores else (0, None)
    if share < 0.9:
        raise Fail("this card doesn't look like Handtop v0.4.x (best match %s, %d%% of its files)"
                   % (rel or "none", 100 * share))
    own = _root_files(data[rel])
    others = set().union(*[_root_files(data[r]) for r in data if r != rel]) if len(data) > 1 else set()
    mine, theirs = own - others, others - own
    have_mine = sum(1 for p in mine if card_value(p)) / max(1, len(mine))
    have_theirs = sum(1 for p in theirs if card_value(p)) / max(1, len(theirs))
    # Mixed card: any file only another release has. A few of this release's own files may be missing
    # (deleted by the user; they come back with the packages), at most 2 % of them.
    if mine and have_mine < 0.98 or theirs and have_theirs > 0:
        raise Fail("this card mixes files of more than one Handtop release (%s's own files: %d%% there; "
                   "other releases' own files: %d%% there), so changed files can't be told apart: "
                   "nothing changed; flash v0.5.0 instead" % (rel, 100 * have_mine, 100 * have_theirs))
    if not os.path.ismount(FAT):
        raise Fail("the boot partition is not mounted (%s)" % FAT)
    have = card_value(FAT + "/rootfix.cpio")
    variants = data[rel].get(FAT + "/rootfix.cpio", {})
    if not have or have[0] != "f" or not variants:          # missing = no evidence (review 2026-11-26 #65)
        raise Fail("this card's boot partition has no rootfix.cpio to recognise it by: nothing changed; flash "
                   "v0.5.0 instead")
    var = next((v for v, tv in variants.items() if tv == have and v != "*"), None)
    if var is None and variants.get("*") != have:
        raise Fail("this card's boot partition (rootfix.cpio) is not %s's: nothing changed; flash v0.5.0 "
                   "instead" % rel)
    return rel, var, share


def identity_files(data, rel, variant):
    abi = data[rel]["@boot-abi"]["*"][1].replace(";", "\n") + "\n"
    model = "model=rg35xx-h\nram=%s\n" % (variant or "unknown")
    return {BOOT_ABI: abi, MODEL: model}


def deb_control(path):
    """(conffiles, {path: md5}) of a package file."""
    import tarfile
    import io
    data = subprocess.run(["dpkg-deb", "--ctrl-tarfile", path], stdout=subprocess.PIPE, check=True,
                          timeout=120).stdout
    conff, sums = set(), {}
    with tarfile.open(fileobj=io.BytesIO(data)) as tf:
        for m in tf.getmembers():
            n = os.path.basename(m.name)
            if n == "conffiles":
                conff = {l.strip() for l in tf.extractfile(m).read().decode().splitlines() if l.strip()}
            elif n == "md5sums":
                for l in tf.extractfile(m).read().decode("utf-8", "replace").splitlines():
                    md5, _, f = l.partition("  ")
                    if f:
                        sums["/" + f.strip()] = md5.strip()
    return conff, sums


def md5(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def adoption(plan, data):
    """What the migration does with each file the plan's Handtop packages ship that is already on
    the card, decided once when the plan is made (a retry uses the same decisions):
    "replace": [path, package md5] config files never changed: the package's copy takes their place;
    "keep": config files the user changed: they stay, the package's copy next to them (.dpkg-dist);
    "backup": [path, sha256] other files the user changed: copied to BACKUP, then replaced."""
    known = data.get(plan["from"]["release"], {})
    res = {"replace": [], "keep": [], "backup": [], "ffmpeg_backup": [], "deleted": [], "links": [], "modes": [],
           # every Handtop file still as the release shipped it: [path, sha256 then, package md5], so the
           # install can tell an edit made after the plan from its own writes (review #64)
           "stock": [], "deleted_md5": {}, "pkg_md5": {}}
    modes, legacy = release_extras(plan["from"]["release"])
    owned = None
    for p in plan["packages"]:
        ffmpeg = p["name"] in FFMPEG_FAMILY + FFMPEG_DEV
        if not is_handtop(p["name"]) and not ffmpeg:
            continue
        conff, sums = deb_control(os.path.join(CACHE, p["file"]))
        for path, pkg_md5 in sorted(sums.items()):
            cur = card_value(path)
            if not cur and path in conff and path in known:
                res["deleted"].append(path)          # the user deleted a config file the release had
                res["deleted_md5"][path] = pkg_md5
                continue
            if cur and cur[0] == "l" and cur not in known.get(path, {}).values():
                res["links"].append([path, cur[1]])  # the user made it a link: keep where it pointed
                continue
            if not cur or cur[0] != "f":
                continue
            if ffmpeg:
                # v0.4.x's own FFmpeg build put files no package owns (the ffmpeg binary, headers,
                # BUILDINFO); Handtop's FFmpeg packages replace them: keep a copy of any the user
                # changed (one still as the release shipped it needs none).
                owned = owned if owned is not None else dpkg_owned()
                if path not in owned and cur[1] not in legacy.get(path, ()) and md5(path) != pkg_md5:
                    res["ffmpeg_backup"].append([path, cur[1]])
                    res["pkg_md5"][path] = [pkg_md5]
                elif path not in owned and cur[1] in legacy.get(path, ()):
                    res["stock"].append([path, cur[1], pkg_md5])   # as shipped: a later edit is kept (#86)
                continue
            if cur in known.get(path, {}).values():
                res["stock"].append([path, cur[1], pkg_md5])
                if path in conff and md5(path) != pkg_md5:
                    res["replace"].append([path, pkg_md5])
                m = "%o" % stat.S_IMODE(os.stat(path).st_mode)
                if modes.get(path) and m not in modes[path]:
                    res["modes"].append([path, m])       # same content, permissions changed by the user
            elif md5(path) != pkg_md5:
                if path in conff:
                    res["keep"].append(path)
                else:
                    res["backup"].append([path, cur[1]])
                    res["pkg_md5"][path] = [pkg_md5]
    return res


def _aliases(path):
    """The spellings dpkg may have recorded for a path on a merged-/usr system."""
    res = {path}
    for a, b in (("/usr/lib/", "/lib/"), ("/usr/bin/", "/bin/"), ("/usr/sbin/", "/sbin/")):
        if path.startswith(a):
            res.add(b + path[len(a):])
        elif path.startswith(b):
            res.add(a + path[len(b):])
    return res


def remove_old_ffmpeg_files(rel, log):
    """After the packages: files (and unversioned .so links) of v0.4.x's own FFmpeg build that are still
    no package's and unchanged (old header location, examples, BUILDINFO) go, with folders left empty.
    Changed ones stay. Never through a folder that is a link (it could lead into another tree), never a
    path any package owns under any spelling, and each one checked again right before it goes
    (review 2026-11-26 #75)."""
    _, legacy = release_extras(rel)
    owned = dpkg_owned()
    dv = run(["dpkg-divert", "--list"], timeout=60, check=False)
    if dv.returncode != 0:
        log("could not list dpkg's diversions: v0.4.x's own FFmpeg files are left alone")
        return 0
    diverted = set()
    for line in dv.stdout.splitlines():
        m = re.match(r"^(?:local )?diversion of (\S+) to (\S+)", line)
        if m:
            for x in m.groups():
                diverted |= _aliases(x)                  # either /usr spelling (#75)
    gone = skipped = 0
    for path, sums in sorted(legacy.items()):
        if "\0" in path or path in diverted:
            continue
        d = os.path.dirname(path)
        if os.path.realpath(d) != d:
            skipped += os.path.lexists(path)
            continue
        if _aliases(path) & owned:          # (the folder is real, so this spelling is the path itself)
            continue
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(st.st_mode):
            if "l:" + os.readlink(path) not in sums:
                continue
        elif not stat.S_ISREG(st.st_mode) or sha256(path) not in sums:
            continue
        elif legacy.get(path + "\0mode") and "%o" % stat.S_IMODE(st.st_mode) not in legacy[path + "\0mode"]:
            continue                              # permissions changed by the user: not as shipped (#75)
        os.unlink(path)
        gone += 1
        while d not in ("/", "/usr", "/usr/include", "/usr/share", "/usr/bin", "/usr/share/doc") \
                and os.path.isdir(d) and not os.path.islink(d) and not os.listdir(d) and not (_aliases(d) & owned):
            os.rmdir(d)
            d = os.path.dirname(d)
    if gone:
        log("removed %d unchanged file(s) of v0.4.x's own FFmpeg build that no package owns" % gone)
    if skipped:
        log("left %d file(s) of v0.4.x's own FFmpeg build alone: their folder is a link" % skipped)
    return gone


def dpkg_owned():
    """Every path some installed package owns (dpkg's file lists)."""
    res = set()
    d = "/var/lib/dpkg/info"
    for f in os.listdir(d):
        if f.endswith(".list"):
            with open(os.path.join(d, f), errors="replace") as fh:
                res.update(l.rstrip("\n") for l in fh)
    return res


def backup(items, log, pkg_md5s=None):
    """Copy each changed file to BACKUP before the package replaces it: temporary file, checked
    against the recorded checksum, synced, renamed; owner and mode kept. An existing backup counts
    only when its checksum is the recorded one (an earlier attempt may have been cut mid-copy)."""
    pkg_md5s = pkg_md5s or {}
    for path, digest in items:
        dst = BACKUP + path
        if os.path.isfile(path) and not os.path.islink(path) and sha256(path) != digest \
                and md5(path) not in pkg_md5s.get(path, ()):
            save_newest(path, sha256(path), log)   # changed again since the plan: the newest is kept (#86)
        if os.path.isfile(dst) and sha256(dst) == digest:
            continue
        if not os.path.isfile(path) or sha256(path) != digest:
            continue                               # the approved version is gone; the newest is saved
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".tmp"
        shutil.copy2(path, tmp)
        st = os.stat(path)
        os.chown(tmp, st.st_uid, st.st_gid)
        with open(tmp, "rb") as f:
            os.fsync(f.fileno())
        if sha256(tmp) != digest:
            raise Fail("backup of %s did not verify" % path)
        os.rename(tmp, dst)
        _sync_up(dst)
        log("backed up (changed by the user): %s" % path)


def fat_uuid():
    """The filesystem UUID of the partition mounted on /boot/firmware, or None."""
    if not os.path.ismount(FAT):
        return None
    p = run(["findmnt", "-n", "-o", "UUID", FAT], timeout=30, check=False)
    return p.stdout.strip() or None


def fat_on_root_disk():
    """The partition on /boot/firmware is on the same disk as / (images share the FAT's serial, so the
    UUID alone can't tell this card's boot partition from another card in a reader; #115)."""
    def disk(target):                            # by device number: also when / shows as /dev/root
        try:
            st = os.stat(target)
            dev = os.path.realpath("/sys/dev/block/%d:%d" % (os.major(st.st_dev), os.minor(st.st_dev)))
        except OSError:
            return None
        if not os.path.isdir(dev):
            return None                          # not a block device (tmpfs, overlay)
        return os.path.dirname(dev) if os.path.isfile(os.path.join(dev, "partition")) else dev
    if not os.path.ismount(FAT):
        return False
    a, b = disk(FAT), disk("/")
    if a is None or b is None:
        return CHROOT_TEST                       # tests: a tmpfs boot partition in a chroot
    return a == b


def fat_write(name, data, log):
    """Write a file on the boot partition (temp file, sync, rename); only when it is really mounted.
    A write error (full, I/O error) is False too, never an exception: the packages are installed by
    then, and the file waits for a later start (review 2026-11-26 #72)."""
    if not os.path.ismount(FAT) or not os.access(FAT, os.W_OK):
        log("boot partition not writable: %s not written" % name)
        return False
    try:
        write_atomic(os.path.join(FAT, name), data)
    except OSError as e:
        log("could not write %s on the boot partition: %s" % (name, e))
        try:
            unlink(os.path.join(FAT, name + ".new"))
        except OSError:
            pass                                  # best effort: a read-only FAT can't drop it either
        return False
    return True


def migrate_boot_files(plan, data, log):
    """recovery.txt where it's missing; v0.4.0's active rg35xxh-input.conf (unchanged by the user)
    becomes the rescue template, the old one kept next to it. A file that can't be written (FAT not
    mounted or read-only) is left pending: boot-check writes it at a later start."""
    notes, pending = [], []
    rel = plan["from"]["release"]
    tpl = lambda n: open(os.path.join(BOOT_TEMPLATES, n), "rb").read()
    # Recorded before writing: a cut (or an error) in the middle still leaves the work to finish. Bound
    # to this card's boot partition (its rootfix.cpio and KERNEL): only that FAT, mounted, counts; with
    # it missing, /boot/firmware is a folder on ext4 whose files say nothing (review 2026-11-27 #93).
    pend = read_json(BOOT_PENDING) or {}
    ident = pend.get("ident") or {
        "rootfix": ((data.get(rel, {}).get(FAT + "/rootfix.cpio") or {}).get(plan["from"].get("variant") or "*")
                    or (None, None))[1],
        "kernel": plan.get("kernel_sha256") or boot_abi().get("kernel_sha256"),
        "uuid": plan.get("fat_uuid"), "plan": plan.get("id")}
    if not pend:
        write_json(BOOT_PENDING, {"release": rel, "files": ["recovery.txt", "rg35xxh-input.conf"], "ident": ident})
    if not fat_on_root_disk() or (ident.get("uuid") and fat_uuid() != ident["uuid"]) or not ident.get("kernel") \
            or any(v and card_value(FAT + "/" + n) != ("f", v)
                   for n, v in (("rootfix.cpio", ident.get("rootfix")), ("KERNEL", ident.get("kernel")))):
        return ["boot partition files not written yet (this card's boot partition isn't mounted or can't be "
                "read): written at a later start"]
    def readable(path):              # absent (False), there (True), or unreadable (None): #105
        try:
            with open(path, "rb"):
                return True
        except FileNotFoundError:
            return False
        except OSError:
            return None
    if readable(FAT + "/recovery.txt") is None or readable(FAT + "/rg35xxh-input.conf") is None:
        return ["boot partition files not written yet (the boot partition can't be read): written at a later start"]
    if not os.path.exists(FAT + "/recovery.txt"):
        if fat_write("recovery.txt", tpl("recovery.txt"), log):
            notes.append("recovery.txt added to the boot partition")
        else:
            pending.append("recovery.txt")
    known = data.get(rel, {}).get(FAT + "/rg35xxh-input.conf", {})
    cur = card_value(FAT + "/rg35xxh-input.conf")
    if cur is None and os.path.lexists(FAT + "/rg35xxh-input.conf"):
        # There but its content can't be read: decided at a later start, the record kept (#115).
        return ["boot partition files not written yet (rg35xxh-input.conf can't be read): written at a later start"]
    new = tpl("rg35xxh-input.conf")
    if cur and cur in known.values() and cur[1] != hashlib.sha256(new).hexdigest():
        done = True
        if rel == "v0.4.0":
            keep = "rg35xxh-input.conf.v0.4.0"
            if not os.path.exists(os.path.join(FAT, keep)):
                done = fat_write(keep, open(FAT + "/rg35xxh-input.conf", "rb").read(), log)
        done = done and fat_write("rg35xxh-input.conf", new, log)
        if done:
            if rel == "v0.4.0":
                notes.append("rg35xxh-input.conf is now the rescue file (all commented out; the old one is "
                             "rg35xxh-input.conf.v0.4.0)")
        else:
            pending.append("rg35xxh-input.conf")
    elif cur and cur not in known.values():
        notes.append("rg35xxh-input.conf was changed by you and stays as it is: its settings override "
                     "the Controls app")
    if pending:
        write_json(BOOT_PENDING, {"release": rel, "files": pending, "ident": ident})
        notes.append("not written yet (boot partition not writable): %s; written at a later start"
                     % ", ".join(pending))
    else:
        unlink(BOOT_PENDING)
    return notes


def add_missing_settings(path, log):
    """A settings file the user changed (/etc/rg35xxh/*.conf, KEY=value, read by sh) stays as it is;
    settings the release added since (v0.4.0's power.conf has no MUSIC_SCREEN_OFF_MINUTES, which then
    reads as 0) are appended with Handtop's default from the package's copy next to it. A key the
    file sets in any form (also "export KEY=", or commented out: the user's choice) is left alone."""
    new = path + ".dpkg-dist"
    if not (path.startswith("/etc/rg35xxh/") and path.endswith(".conf") and os.path.isfile(new)):
        return
    key = re.compile(r"^\s*(?:#\s*)?(?:export\s+)?([A-Z][A-Z0-9_]*)=")
    text = open(path, errors="replace").read()
    have = {m.group(1) for m in map(key.match, text.splitlines()) if m}
    add, seen = [], set()
    for line in open(new, errors="replace").read().splitlines():
        m = key.match(line)
        if m and not line.lstrip().startswith("#") and m.group(1) not in have | seen:
            add.append(line)
            seen.add(m.group(1))
    if not add:
        return
    if text and not text.endswith("\n"):
        text += "\n"
    text += ("# Added when this card moved onto packages (Handtop's defaults; your settings above are kept):\n"
             + "\n".join(add) + "\n")
    st = os.stat(path)
    write_atomic(path, text, stat.S_IMODE(st.st_mode))
    os.chown(path, st.st_uid, st.st_gid)
    log("%s: added %s" % (path, ", ".join(a.split("=")[0].strip() for a in add)))


UNITS_DIR = "/etc/systemd/system"
RECOVERY_UNITS = ("handtop-recovery.service", "handtop-update-boot-check.service")
RECOVERY_UNIT_TARGETS = {"handtop-recovery.service": "sysinit.target",
                         "handtop-update-boot-check.service": "multi-user.target"}


def _sync_up(path):
    d = os.path.dirname(path)
    while d.startswith(BACKUP):
        fsync_dir(d)
        d = os.path.dirname(d)


def save_newest(path, sha, log):
    """The user's current bytes of path to BACKUP<path>.changed-after-plan (verified, synced)."""
    dst = BACKUP + path + ".changed-after-plan"
    if os.path.isfile(dst) and sha256(dst) == sha:
        return
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(path, dst + ".tmp")
    with open(dst + ".tmp", "rb") as f:
        os.fsync(f.fileno())
    if sha256(dst + ".tmp") != sha:
        raise Fail("backup of %s did not verify" % path)
    os.rename(dst + ".tmp", dst)
    _sync_up(dst)
    log("changed after the plan, kept in the backup folder: %s" % path)


def load_edits(plan):
    """later-edits.json for this plan, every field present (#114)."""
    j = read_json(LATER_EDITS) or {}
    if j.get("plan") != plan["id"]:
        j = {}
    return {"plan": plan["id"], "files": j.get("files") or {}, "recreated": j.get("recreated") or [],
            "deleted_done": j.get("deleted_done") or []}


def later_edits(plan, plan_ad, log):
    """Before the packages, every attempt: Handtop files the plan found as shipped but which the user
    changed since are kept as they are now: the current bytes go to BACKUP (<path>.changed-after-plan)
    before dpkg replaces an ordinary file; a config file stays (dpkg keeps it) and is not replaced
    afterwards (decision 2026-11-25: keep the newest edit). A config file the user had deleted and made
    again before this install stays, whatever it holds. Files already as the package has them are the
    install's own writes (an earlier attempt). Journal later-edits.json, bound to the plan (#86)."""
    j = load_edits(plan)
    changed, recreated = dict(j["files"]), set(j["recreated"])
    for path, orig, pkg_md5 in plan_ad.get("stock", []):
        cur = card_value(path)
        if cur == ("f", orig) or cur is None:
            continue
        if cur[0] == "l":
            changed[path] = "l:" + cur[1]          # made a link since: its target kept in the backup (#103)
            dst = BACKUP + path + ".changed-after-plan.link"
            if not os.path.isfile(dst) or open(dst).read() != cur[1]:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                write_atomic(dst, cur[1])
                _sync_up(dst)
            continue
        if md5(path) == pkg_md5:
            continue
        save_newest(path, cur[1], log)
        changed[path] = cur[1]
    if not plan_changed(plan):                     # before dpkg has written anything of this plan
        recreated |= {p for p in plan_ad.get("deleted", []) if os.path.lexists(p)}
    # Deleted again by an earlier attempt, there now: made again by the user since (dpkg doesn't bring a
    # config file of an installed package back by itself; #103).
    recreated |= {p for p in j.get("deleted_done", []) if os.path.lexists(p)}
    if changed != j["files"] or recreated != set(j["recreated"]):
        write_json(LATER_EDITS, dict(j, plan=plan["id"], files=changed, recreated=sorted(recreated)))
    return changed, recreated


def migrate_packaged_modes(plan, paths, budget):
    import tarfile

    # releases.tsv describes the old card. Use the verified .debs for what is being installed.
    packaged = {}
    sudoers = {path for path in paths if path.startswith("/etc/sudoers.d/")}
    for p in plan["packages"]:
        if not is_handtop(p["name"]):
            continue
        deb = os.path.join(CACHE, p["file"])
        conff, sums = deb_control(deb)
        sudoers.update(path for path in conff if path.startswith("/etc/sudoers.d/"))
        wanted = paths & sums.keys()
        if not wanted:
            continue
        # Stream the tar headers to avoid holding the unpacked package in memory.
        cmd = ["timeout", "-k", "5", str(budget(120)), "dpkg-deb", "--fsys-tarfile", deb]
        with subprocess.Popen(cmd, stdout=subprocess.PIPE, env=APT_ENV) as proc:
            try:
                with tarfile.open(fileobj=proc.stdout, mode="r|") as tf:
                    for member in tf:
                        path = "/" + member.name.removeprefix("./").lstrip("/")
                        if path in wanted:
                            packaged[path] = member.mode if member.isfile() else None
            except tarfile.TarError as e:
                raise Fail("could not read permissions from %s (%s)" % (p["file"], e)) from e
            # Consume any padding after the tar end marker so dpkg-deb can finish writing.
            while proc.stdout.read(65536):
                pass
            if proc.wait() != 0:
                raise Fail("could not read permissions from %s" % p["file"])
    return packaged, sudoers


def migrate_sudoers_warnings(paths, missing_ok, log):
    warnings = []
    for path in sorted(paths):
        issues = []
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            if path in missing_ok:
                continue
            issues.append("file missing")
        except OSError:
            issues.append("could not check file type and mode")
        else:
            if not stat.S_ISREG(mode):
                issues.append("expected a regular file")
            else:
                if stat.S_IMODE(mode) != 0o440:
                    issues.append("mode %04o, expected 0440" % stat.S_IMODE(mode))
                try:
                    if run(["visudo", "-cf", path], timeout=10, check=False).returncode:
                        issues.append("visudo rejected it")
                except (OSError, subprocess.SubprocessError):
                    issues.append("could not run visudo")
        if issues:
            warning = "Sudoers file %s (%s)" % (path, ", ".join(issues))
            warnings.append(warning)
            log(warning)
    return warnings


def migrate_mode_notes(modes, packaged, log):
    if not modes:
        return []
    os.makedirs(BACKUP, exist_ok=True)
    write_json(BACKUP + "/modes.json", modes)
    restored, added_access, kept, failed = 0, [], [], []
    for path, saved in sorted(modes.items()):
        before, expected = int(saved, 8), packaged.get(path)
        actual = None
        try:
            mode = os.lstat(path).st_mode
            if stat.S_ISREG(mode):
                actual = stat.S_IMODE(mode)
        except OSError as e:
            log("could not check permissions on %s (%s)" % (path, e))
        # Only observe what dpkg and conffile adoption did. The record is for reporting.
        if actual is not None and actual == expected:
            restored += 1
            outcome = "restored Handtop's permissions"
            if actual & ~before:
                added_access.append("%s (%04o to %04o)" % (path, before, actual))
        elif expected is not None and actual == before:
            kept.append(path)
            outcome = "kept your permissions"
        else:
            failed.append(path)
            outcome = "could not restore permissions"
        log("%s on %s (was %04o, now %s, package %s)" %
            (outcome, path, before, "%04o" % actual if actual is not None else "unavailable",
             "%04o" % expected if expected is not None else "no regular file"))

    def listed(paths):
        return ", ".join(paths[:3]) + (" and %d more (see the update log)" % (len(paths) - 3)
                                       if len(paths) > 3 else "")

    notes = []
    if failed:
        notes.append("Could not restore permissions on " + listed(failed))
    if kept:
        notes.append("Kept your permissions on " + listed(kept))
    if restored:
        notes.append("Restored Handtop's permissions on %d file%s" % (restored, "s" if restored != 1 else ""))
        if added_access:
            notes[-1] += ". Added access on " + listed(added_access)
    notes[-1] += ". Your old permissions are in %s/modes.json" % BACKUP
    return notes


def install_migrate(plan, log, budget):
    data = release_data()
    # Before any change: the boot partition is there and still has the kernel the plan was made for.
    if not os.path.ismount(FAT):
        raise Fail("the boot partition is not mounted: nothing changed; run the command again")
    if plan.get("kernel_sha256") and card_value(FAT + "/KERNEL") != ("f", plan["kernel_sha256"]):
        raise Fail("this card's kernel changed since the download: nothing changed; flash the new image")
    # The RAM type written to /etc/handtop/model comes from rootfix.cpio: still the one planned (#65)
    want_rf = (data.get(plan["from"]["release"], {}).get(FAT + "/rootfix.cpio") or {}).get(
        plan["from"].get("variant") or "*")
    if want_rf and card_value(FAT + "/rootfix.cpio") != tuple(want_rf):
        raise Fail("this card's boot partition (rootfix.cpio) changed since the download: nothing changed")
    dpkg_state_check(plan)
    opts = apt_opts(True)
    if plan_changed(plan):
        run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    plan_ad = plan.get("adoption") or adoption(plan, data)
    modes = dict(plan_ad.get("modes", []))
    packaged_modes, sudoers = migrate_packaged_modes(plan, modes.keys(), budget)
    backup(plan_ad["backup"] + plan_ad.get("ffmpeg_backup", []), log, plan_ad.get("pkg_md5"))
    edited, recreated = later_edits(plan, plan_ad, log)
    if plan_ad.get("links"):
        os.makedirs(BACKUP, exist_ok=True)
        write_json(BACKUP + "/links.json", dict(plan_ad["links"]))   # path -> where your link pointed
    # Before the packages: the modules package's preinst checks /etc/handtop/boot-abi (the card's
    # KERNEL was matched against this release's when the plan was made).
    for path, text in identity_files(data, plan["from"]["release"], plan["from"]["variant"]).items():
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            write_atomic(path, text.encode())
    # Units the card had before the plan count as enabled once: the packages' postinst then leaves the
    # user's choice alone (a unit they disabled stays disabled); only units new to the card get enabled.
    units = UNITS_DIR
    present = set(plan["units_present"]) if "units_present" in plan else {
        f for f in os.listdir(units) if f.endswith((".service", ".timer")) and os.path.isfile(os.path.join(units, f))}
    seen = set(open(UNITS_SEEN).read().split()) if os.path.isfile(UNITS_SEEN) else set()
    if present - seen:
        os.makedirs(os.path.dirname(UNITS_SEEN), exist_ok=True)
        write_atomic(UNITS_SEEN, "".join(u + "\n" for u in sorted(seen | present)))
    check_against_plan(plan, opts)
    mark_changed(plan)
    try:
        run(["apt-get", "-q", "-y", "--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE]
            + opts + ["install"] + plan_targets(plan), timeout=budget(3600), log=log)
        run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log)
    except Fail as e:
        # The package's postinst can reject a sudoers file before the final check runs.
        warnings = migrate_sudoers_warnings(sudoers, sudoers, log)
        if warnings:
            raise Fail("%s. %s" % (". ".join(warnings), e)) from e
        raise
    if plan.get("auto"):
        run(["apt-mark", "auto"] + plan["auto"], timeout=120, log=log)
    have = installed()
    wrong = [p["name"] for p in plan["packages"] if have.get(p["name"]) != p["new"]]
    if wrong:
        raise Fail("not at the planned version afterwards: %s" % ", ".join(wrong))
    # The packaged units skip the maintenance boot themselves: handtop-migrate's drop-ins can go.
    for u in MIGRATE_DROPINS:
        unlink("%s/%s.d/%s" % (units, u, DROPIN_NAME))
    # dpkg kept the card's copy of each config file (--force-confold) and wrote the package's next to
    # it: where the card's copy was the old release's, the package's takes its place.
    # Not a file the user changed after the plan was made: that one stays (decision 2026-11-25).
    stock_then = {p: orig for p, orig, _ in plan_ad.get("stock", [])}
    kept_new = []
    for path, pkg_md5 in plan_ad["replace"]:
        if path in edited or card_value(path) not in (("f", stock_then.get(path)), None):
            if os.path.isfile(path) and md5(path) != pkg_md5:
                kept_new.append(path)
            continue
        for ext in (".dpkg-dist", ".dpkg-new"):
            if os.path.isfile(path + ext) and md5(path + ext) == pkg_md5:
                os.replace(path + ext, path)
                log("config file from the package: %s" % path)
                break
    for path in plan_ad["keep"]:
        add_missing_settings(path, log)
    mode_notes = migrate_mode_notes(modes, packaged_modes, log)
    removed = remove_old_ffmpeg_files(plan["from"]["release"], log)
    for path in plan_ad.get("deleted", []):              # stays deleted (dpkg won't bring it back later)
        aside = "%s.handtop-deleting-%s" % (path, plan["id"])   # this plan's own name only (#123)
        if os.path.lexists(aside):                         # a cut in the middle of the step below
            j = load_edits(plan)
            if os.path.lexists(path):                      # made again since the cut: the user's (#123)
                recreated.add(path)
                j["recreated"] = sorted(set(j["recreated"]) | {path})
            write_json(LATER_EDITS, dict(j, deleted_done=sorted(set(j["deleted_done"]) | {path})))
            os.unlink(aside)
        want = plan_ad.get("deleted_md5", {}).get(path)
        if path in recreated:
            if os.path.lexists(path):
                kept_new.append(path)                  # made again by the user before the install: stays
            continue
        if os.path.lexists(path) and (not want or (os.path.isfile(path) and md5(path) == want)):
            # Moved aside first, then recorded, then removed: a cut never makes the package's copy look
            # like one the user made again (#114).
            os.rename(path, aside)
            fsync_dir(os.path.dirname(path))
            j = load_edits(plan)
            write_json(LATER_EDITS, dict(j, deleted_done=sorted(set(j["deleted_done"]) | {path})))
            os.unlink(aside)
            log("config file you had deleted, deleted again: %s" % path)
        elif os.path.lexists(path):
            kept_new.append(path)                      # made again by the user since the plan: stays
    # Recovery without a screen needs these two enabled, whatever happened on the way (review #83).
    # Not done until both are: the move stays kept and resumable instead of "succeeding" without
    # screenless recovery (review 2026-11-27 #94).
    off = []
    for u in RECOVERY_UNITS:
        # Wanted by its own boot target (the link), not just "enabled" somewhere (#107, #118)
        link = "%s/%s.wants/%s" % (UNITS_DIR, RECOVERY_UNIT_TARGETS[u], u)
        good = lambda: os.path.islink(link) and os.path.isfile(link)   # a link systemd follows (#125)
        if not good():
            if os.path.lexists(link) and not os.path.islink(link):
                os.unlink(link)                  # a plain file there is ignored by systemd
            run(["systemctl", "enable", u], timeout=60, check=False)
            if not good():
                off.append(u)
    if off:
        raise Fail("installed, but %s could not be enabled (needed for recovery.txt): the move is kept; "
                   "run the command again to finish it" % ", ".join(off))
    permissions = migrate_sudoers_warnings(sudoers, plan_ad.get("deleted", []), log) + mode_notes
    notes = [".\n".join(permissions)] if permissions else []  # the app shows the first six notes
    later = sorted(set(kept_new) | set(edited))
    if later:
        notes.append("you changed these after the move was planned; your version is kept (config files stay, "
                     "Handtop's next to them as .dpkg-dist; other files are in %s as .changed-after-plan): %s"
                     % (BACKUP, ", ".join(later)))
    notes += migrate_boot_files(plan, data, log)
    unlink(MIGRATE_HOLDS)                # the released v0.4.x holds stay released (after the boot files)
    unlink(NO_PREDECESSOR)
    return notes + (
        ["%d changed file(s) backed up in %s" % (len(plan_ad["backup"]), BACKUP)] if plan_ad["backup"] else []) + (
        ["%d leftover file(s) of v0.4.x's own FFmpeg build removed" % removed] if removed else [])


def cmd_migrate():
    with lock():
        if our_marker():
            raise Fail("an update is scheduled: cancel it first")
        if (read_json(PLAN) or {}).get("kind") == "migrate":
            raise Fail("a move onto packages is already downloaded: schedule it again to resume it")
        require_clean_dpkg()
        have = installed()
        if any(is_handtop(n) for n in have):
            raise Fail("this card has Handtop's packages already: use the Update app")
        data = release_data()
        rel, var, share = identify(data)
        ids = identity_files(data, rel, var)
        ksha = re.search(r"^kernel_sha256=(\S+)$", ids[BOOT_ABI], re.M).group(1)
        if card_value(FAT + "/KERNEL") != ("f", ksha):
            raise Fail("this card's kernel is not %s's: flash the new image instead" % rel)
        p = run(["apt-get", "update", "-q", "--error-on=any"], timeout=600, check=False)
        if p.returncode != 0:
            raise Fail("could not refresh every package list: %s" % "; ".join(
                l for l in p.stdout.splitlines() if l.startswith(("E:", "Err:")))[-600:])
        release_legacy_holds()               # after the refresh: the pin is checked against today's lists
        warnings = hold_warnings()
        write_json(CHECKED, {"ok": True, "time": int(time.time())})
        freeze_lists()
        opts = apt_opts(True)
        what = ("install",) + MIGRATE_TARGETS
        inst = simulate(opts, what=what)
        if not any(i["name"] == "handtop" for i in inst):
            raise Fail("Handtop's packages are not in the package lists (is Handtop's source set up?)")
        bad = modules_mismatch(inst, opts, want=ksha)
        if bad:
            raise Fail("the release's kernel modules don't fit this card's kernel (%s): flash the new image"
                       % ", ".join(bad))
        pkgs, total = fetch_plan(inst, opts, False, what=what)
        autos = set(run(["apt-mark", "showauto"], timeout=60).stdout.split())
        plan = {"id": uuid.uuid4().hex[:12], "kind": "migrate", "created": int(time.time()),
                "packages": pkgs, "handtop_held": False, "new_image_needed": [], "size_mb": round(total, 1),
                "from": {"release": rel, "variant": var, "match": round(100 * share)},
                "kernel_sha256": ksha,
                "fat_uuid": fat_uuid(),           # boot files go to this partition only (#105)
                # the two targets stay manually installed; new dependencies and upgraded auto ones are auto
                "auto": sorted(p["name"] for p in pkgs if p["name"] not in MIGRATE_TARGETS
                               and (p["name"] in autos or not p["old"])),
                # nothing packaged to go back to: the release before is the image's copied files
                "rollback": {"needed": False, "possible": True, "reason": None, "no_predecessor": True}}
        ad = plan["adoption"] = adoption(plan, data)
        # The units this card has before anything is installed, decided once (a retry after the packages
        # added theirs must not count those: review 2026-11-26 #83).
        plan["units_present"] = sorted(f for f in os.listdir(UNITS_DIR) if f.endswith((".service", ".timer"))
                                       and os.path.isfile(os.path.join(UNITS_DIR, f)))
        plan["backup_mb"] = round(sum(os.path.getsize(b[0]) for b in ad["backup"] + ad["ffmpeg_backup"]
                                      if os.path.isfile(b[0])) / (1 << 20), 1)
        mb, inodes = free_space(STATE)
        if mb < 2 * total + plan["backup_mb"] + 200 or inodes < MIN_INODES:
            raise Fail("not enough free space for the move: %d MB, %d inodes free" % (mb, inodes))
        write_json(PLAN, plan)
        unlink(SCHEDULE)
        rmtree(NEXT)
        out({"ok": True, "plan": plan["id"], "from": plan["from"], "packages": len(pkgs),
             "core": next((p["new"] for p in pkgs if p["name"] == "handtop-core"), None),
             "download_mb": round(total, 1), "warnings": warnings,
             "config_kept": ad["keep"], "config_replaced": len(ad["replace"]),
             "backed_up": [b[0] for b in ad["backup"]], "ffmpeg_backed_up": len(ad["ffmpeg_backup"]),
             "config_deleted": ad["deleted"], "links": [l[0] for l in ad["links"]]})
        return 0


# ---- schedule / cancel / channel / status ---------------------------------------------------------

def cmd_schedule(after="restart", expected=None):
    """expected: the plan id the app showed; refused when the downloaded plan is another one by now."""
    if after not in ("restart", "poweroff"):
        raise Fail("schedule: restart or poweroff")
    if expected is not None and not re.fullmatch(r"[0-9a-f]{12}", expected):
        raise Fail("schedule: bad plan id")
    with lock():
        finish_cleanup()                         # an earlier cleanup first, never after this schedule (#104)
        plan = read_json(PLAN)
        if not plan or plan.get("kind") not in ("update", "migrate"):
            raise Fail("nothing downloaded")
        if expected is not None and plan.get("id") != expected:
            raise Fail("the downloaded update changed since it was shown: look at it again")
        mk = our_marker()
        if mk is False:
            raise Fail("another offline update is scheduled (/system-update); not touching it")
        sched = read_json(SCHEDULE) or {}
        if mk and sched.get("plan") == plan["id"]:
            if sched.get("after") != after:
                write_json(SCHEDULE, dict(sched, after=after))
            out({"ok": True, "restart": True, "after": after, "plan": plan["id"]})
            return 0
        # Our marker without this plan's schedule: never start the attempt count again silently
        # (review 2026-11-26 #56). Another plan's schedule: that one has to be cancelled first.
        attempts = 0
        if mk:
            if sched and sched.get("plan") != plan["id"]:
                raise Fail("an earlier install is still scheduled: cancel it first")
            prog = read_json(INPROGRESS) or {}
            if prog.get("plan") == plan["id"]:
                attempts = int(prog.get("attempt") or 0)
            elif not sched:
                raise Fail("an install is marked but its schedule is missing: cancel it first")
        if not plan["rollback"]["possible"] and not plan["rollback"]["no_predecessor"]:
            raise Fail("going back would not be possible: %s" % plan["rollback"]["reason"])
        verify_files(plan["packages"], CACHE)
        check_kept_release(plan)
        mb, inodes = free_space(STATE)
        if mb < 2 * plan["size_mb"] + plan.get("backup_mb", 0) + 200 or inodes < MIN_INODES:
            raise Fail("not enough free space to install: %d MB, %d inodes free" % (mb, inodes))
        why = power_ok(MIN_BATTERY)
        if why:
            raise Fail("%s: connect the charger or charge to %d%% first" % (why, MIN_BATTERY))
        active = controller_mode_active()
        if active:
            raise Fail("a controller mode is running (%s): end it first" % active)
        en = subprocess.run(["systemctl", "is-enabled", APPLY_UNIT], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, timeout=15).stdout.strip()
        if en != "enabled":
            raise Fail("%s is not enabled (%s): the update could not be installed" % (APPLY_UNIT, en or "?"))
        if not plan.get("first_scheduled"):      # kept-config files are listed from here (#60)
            plan["first_scheduled"] = int(time.time())
            write_json(PLAN, plan)
        # gen: this scheduling, so a result is matched to it exactly (not by clock: review #34)
        if plan["kind"] == "migrate":
            # Held again after a failed attempt; released only now that every check passed (#92).
            release_legacy_holds()
        write_json(SCHEDULE, {"plan": plan["id"], "after": after, "attempts": attempts, "deferrals": 0,
                              "at": int(time.time()), "gen": uuid.uuid4().hex[:12]})
        set_marker()
        out({"ok": True, "restart": True, "after": after, "plan": plan["id"]})
        return 0


def kept_migration():
    """The migration plan on this card (kept after a failed attempt, or downloaded and not yet
    installed), or None. Not one whose cleanup was cut short (it is finished, not kept: #91)."""
    plan = read_json(PLAN)
    c = read_json(CLEANUP) or {}
    if c.get("plan") and c.get("plan") == (plan or {}).get("id") and not c.get("keep_plan"):
        return None
    return plan if plan and plan.get("kind") == "migrate" else None


def refuse_if_migration_kept():
    """A kept migration plan is the only way to finish moving this card onto packages: app actions
    that would replace or drop it are refused (review 2026-11-26 #63, decision 3)."""
    if kept_migration():
        raise Fail("the move onto packages hasn't finished: resume it (Apps > Update, or the same command "
                   "again); to give it up instead: sudo handtop-update abandon-migration (docs/migrate.md)")


def forget_plan():
    remove_marker()
    for p in (PLAN, SCHEDULE, CHANGED):
        unlink(p)
    for d in (CACHE, LISTS, PREFS, NEXT):
        rmtree(d)


def cmd_cancel():
    with lock():
        if our_marker() is False:
            raise Fail("the scheduled offline update is not Handtop's; not touching it")
        mig = kept_migration()
        if mig and plan_changed(mig):
            raise Fail("the move onto packages has started installing and can only be finished: resume it "
                       "(the same command again); to give it up: sudo handtop-update abandon-migration")
        migrating = bool(mig)
        forget_plan()
        if (migrating or os.path.exists(MIGRATE_HOLDS)) and not restore_legacy_holds():
            raise Fail("could not hold FFmpeg's packages again (apt-mark): try again")   # (#98)
        out({"ok": True})
        return 0


def cmd_repair():
    """A kept migration plan whose downloaded files went missing or got damaged: fetch exactly those
    again, at the plan's versions, from the plan's frozen package lists, each checked against the
    SHA-256 the plan recorded. The plan and its decisions stay as they are (review 2026-11-26 #63)."""
    with lock():
        mig = kept_migration()
        if not mig:
            raise Fail("no move onto packages is kept on this card")
        if not os.path.isdir(LISTS):
            raise Fail("the move's package lists are gone: give it up (abandon-migration) and run the command again")
        bad = [p for p in mig["packages"] if not file_ok(os.path.join(CACHE, p["file"]), p["algo"], p["hash"])]
        if bad:
            os.makedirs(CACHE, exist_ok=True)
            tmp = CACHE + "/repair"
            rmtree(tmp)
            os.makedirs(tmp)
            stage_for_apt(tmp)
            for p in bad:
                unlink(os.path.join(CACHE, p["file"]))
            run(["apt-get", "download", "-q"] + apt_opts(True) + ["%s=%s" % (p["name"], p["new"]) for p in bad],
                timeout=1800, cwd=tmp, check=False)
            for p in bad:
                f = os.path.join(tmp, p["file"])
                if os.path.isfile(f) and file_ok(f, p["algo"], p["hash"]):
                    os.chown(f, 0, 0)
                    os.rename(f, os.path.join(CACHE, p["file"]))
            rmtree(tmp)
            verify_files(mig["packages"], CACHE)
        out({"ok": True, "plan": mig["id"], "repaired": [p["name"] for p in bad]})
        return 0


def cmd_abandon_migration():
    """Give up a kept migration plan explicitly (docs/migrate.md): its plan, downloads and decisions go,
    the FFmpeg holds it released come back. Packages it already installed stay; reflash if the card
    doesn't work."""
    with lock():
        mig = kept_migration()
        if not mig:
            raise Fail("no move onto packages is kept on this card")
        if our_marker() is False:
            raise Fail("another offline update is scheduled (/system-update); not touching it")
        started = plan_changed(mig)
        if os.path.exists(MIGRATE_HOLDS) and not restore_legacy_holds():   # first: a failure keeps the plan (#117)
            raise Fail("FFmpeg's packages could not be held again (apt-mark): nothing given up; run this again")
        forget_plan()
        out({"ok": True, "abandoned": mig["id"], "had_started": started,
             "note": "packages it already installed stay; if the card doesn't work, flash v0.5.0" if started else ""})
        return 0


def cmd_channel(which=None):
    """testing: an extra source for trixie-testing in a file of its own (handtop.sources stays
    untouched). Switching cancels a downloaded or scheduled update."""
    if which not in ("stable", "testing"):
        raise Fail("channel: stable or testing")
    with lock():
        if our_marker() is False:
            raise Fail("another offline update is scheduled (/system-update)")
        refuse_if_migration_kept()
        cancelled = os.path.exists(PLAN)
        forget_plan()
        unlink(CHECKED)
        if which == "testing":
            write_atomic(CHANNEL_SOURCES, TESTING_STANZA)
        else:
            unlink(CHANNEL_SOURCES)
        out({"ok": True, "channel": which, "cancelled_update": cancelled})
        return 0


def joypad_override_active():
    k = boot_abi().get("kernel") or os.uname().release
    return os.path.exists("/usr/lib/modules/%s/updates/handtop-recovery/rocknix-singleadc-joypad.ko" % k)


def cmd_status():
    have = installed_any()
    pend = read_json(BOOT_PENDING) or {}
    plan = read_json(PLAN)
    sched = read_json(SCHEDULE) or {}
    prev = read_json(PREVIOUS + "/manifest.json")
    out({"downloaded": bool(plan), "kind": plan.get("kind") if plan else None,
         "plan": plan.get("id") if plan else None, "packages": len(plan["packages"]) if plan else 0,
         "rollback": plan.get("rollback") if plan else None,
         "scheduled": bool(our_marker()) and bool(plan) and bool(plan.get("id"))
                      and sched.get("plan") == plan.get("id"),
         "after": sched.get("after") if our_marker() else None,
         "foreign_offline_update": our_marker() is False,
         # The kept release counts only when going back would change something (after handtop=previous
         # it is what's installed); checked package by package, so a half-done install still offers it.
         "previous_release": prev.get("release") if prev and prev.get("complete") and (any(
             have.get(p["name"]) != p["version"] for p in prev.get("packages", []))
             or any(is_handtop(n) and n not in NEVER_ROLLED_BACK and n not in {p["name"] for p in prev["packages"]}
                    for n in have)) else None,      # going back would remove something (#52)
         "last_result": read_json(RESULT), "joypad_override": joypad_override_active(),
         # files the boot partition still needs (written at a later start: review #72)
         "boot_pending": pend.get("files") or [],
         "migration_kept": bool(plan and plan.get("kind") == "migrate"
                                and not (our_marker() and sched.get("plan") == plan.get("id"))),
         "channel": "testing" if os.path.exists(CHANNEL_SOURCES) else "stable",
         "reboot_required": os.path.exists("/run/reboot-required")})
    return 0


# ---- the release kept for going back ----------------------------------------------------------------

def repair_previous():
    """Finish promote_previous() after a cut: previous -> previous.old, previous.next -> previous.
    A release that was being deleted (previous.drop) goes."""
    if os.path.isdir(DROP):
        if not os.path.isdir(PREVIOUS) and not os.path.isdir(OLD):
            os.rename(DROP, PREVIOUS)            # cut between the two renames of settle_previous
        else:
            rmtree(DROP)
    if not os.path.isdir(PREVIOUS):
        if os.path.isdir(NEXT) and os.path.isdir(OLD):
            os.rename(NEXT, PREVIOUS)
        elif os.path.isdir(OLD):
            os.rename(OLD, PREVIOUS)
    if os.path.isdir(PREVIOUS) and os.path.isdir(OLD) and (read_json(PLAN) or {}).get("kind") != "update":
        rmtree(OLD)                      # an update in progress keeps it (settle_previous decides)
    fsync_dir(STATE)


def settle_previous(plan, ok):
    """At the end of an update: installed, the release set aside goes; failed before any of the plan's
    packages changed, it is the kept release again (the newer one would equal what is installed)."""
    if (plan or {}).get("kind") != "update" or not os.path.isdir(OLD):
        return
    if not ok:
        m = read_json(PREVIOUS + "/manifest.json") or {}
        have = installed_healthy()
        # Only Handtop's packages and FFmpeg build decide (what going back reinstalls): an update that
        # changed only Debian's packages before failing leaves the set-aside release the useful one (#102).
        mine = [p for p in plan["packages"] if p["name"].split(":")[0] not in NEVER_ROLLED_BACK and (
                is_handtop(p["name"].split(":")[0]) or p["name"].split(":")[0] in FFMPEG_FAMILY + FFMPEG_DEV)]
        untouched = all(have.get(p["name"].split(":")[0]) == p.get("old") for p in mine)
        if m.get("for_plan") == plan.get("id") and untouched:
            os.rename(PREVIOUS, DROP)            # aside first: a cut never leaves neither (#102)
            os.rename(OLD, PREVIOUS)
            fsync_dir(STATE)
            rmtree(DROP)
            return
    os.rename(OLD, DROP)
    fsync_dir(STATE)
    rmtree(DROP)


def check_kept_release(plan):
    """An update that changes Handtop needs the release it replaces kept for going back: staged for
    this plan (previous.next), or already promoted for it (a resumed install), complete, every file
    as downloaded. Checked when scheduling and again right before the install starts."""
    if plan.get("kind") != "update" or not plan.get("rollback", {}).get("needed"):
        return
    for where in (NEXT, PREVIOUS):
        m = read_json(where + "/manifest.json")
        if m and m.get("for_plan") == plan["id"]:
            if not m.get("complete"):
                raise Fail("the release kept for going back is incomplete (%s): download again"
                           % ", ".join(m.get("missing") or []))
            verify_files(m["packages"], where)
            return
    raise Fail("the release kept for going back is missing: download again")


def promote_previous(plan_id):
    m = read_json(NEXT + "/manifest.json")
    if not m or m.get("for_plan") != plan_id:
        return
    if os.path.isdir(PREVIOUS):
        rmtree(OLD)
        os.rename(PREVIOUS, OLD)
    os.rename(NEXT, PREVIOUS)
    fsync_dir(STATE)                     # previous.old stays until settle_previous()


# ---- maintenance boot -----------------------------------------------------------------------------

def policy_rc(on):
    """A policy-rc.d denying service starts for the maintenance boot; an administrator's own is set
    aside and put back. boot-check cleans up after a killed run."""
    if on:
        if os.path.lexists(POLICY_RC) and not ours_policy():
            os.rename(POLICY_RC, POLICY_SAVED)
        write_atomic(POLICY_RC, POLICY_BODY, 0o755)
    else:
        if ours_policy():
            os.unlink(POLICY_RC)
        if os.path.lexists(POLICY_SAVED) and not os.path.lexists(POLICY_RC):
            os.rename(POLICY_SAVED, POLICY_RC)


def ours_policy():
    try:
        with open(POLICY_RC) as f:
            return f.read() == POLICY_BODY
    except OSError:
        return False


class Budget:
    def __init__(self, seconds):
        self.end = time.time() + seconds

    def __call__(self, want):
        left = self.end - time.time() - 120
        if left < 60:
            raise Fail("out of time for this maintenance boot")
        return min(want, left)


def plan_targets(plan):
    return ["%s=%s" % (p["name"], p["new"]) for p in plan["packages"]]


def check_against_plan(plan, opts):
    """What apt would do now must be (part of) the plan: same packages, same versions, no removals.
    The plan's versions are named explicitly: after a power cut that is what lets apt repair the
    half-installed set (a plain dist-upgrade refuses to start then)."""
    inst = simulate(opts, ["--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE],
                    ["install"] + plan_targets(plan))
    want = {(p["name"], p["new"]) for p in plan["packages"]}
    extra = ["%s %s" % (i["name"], i["new"]) for i in inst if (i["name"], i["new"]) not in want]
    # Configure-only work (a package left unpacked at another version) must be the plan's too.
    extra += ["%s %s (configure)" % c for c in getattr(parse_sim, "confs", []) if c not in want]
    if extra:
        raise Drift("this card changed since the download (%s); download the update again" % ", ".join(extra))


def install_update(plan, log, budget):
    opts = apt_opts(True, plan.get("handtop_held"))
    dpkg_state_check(plan)
    for p in plan["packages"]:
        if not p["name"].startswith("handtop-modules-"):
            continue
        # Before any change: the kernel on the boot partition is the one boot-abi names and the one
        # the planned modules package is built for (review 2026-11-26 #58).
        want = boot_abi().get("kernel_sha256")
        built = run(["dpkg-deb", "-f", os.path.join(CACHE, p["file"]), "Handtop-Kernel-SHA256"],
                    timeout=60).stdout.strip()
        if not os.path.ismount(FAT) or not want or built != want or card_value(FAT + "/KERNEL") != ("f", want):
            raise Fail("the boot partition's kernel can't be checked, or isn't the one %s names and %s is "
                       "built for: nothing changed" % (BOOT_ABI, p["name"]))
    if plan_changed(plan):
        # After a power cut, packages unpacked at the new version may wait for siblings still at the
        # old one: this pass then fails, and the install below completes the set.
        run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    check_against_plan(plan, opts)
    t_install, t_conf = budget(3600), budget(1200)    # out of time = refused here, nothing changed (#89)
    # Every check passed: only now does the release this card runs become the one kept for going
    # back (the one kept until now stays while a check can still refuse; review 2026-11-26 #66). The
    # older one is set aside (previous.old), not deleted, until this update has installed: if it fails
    # before any package changed, it is the kept release again (review 2026-11-27 #89).
    mark_changed(plan)
    promote_previous(plan["id"])
    run(["apt-get", "-q", "-y", "--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE]
        + opts + ["install"] + plan_targets(plan), timeout=t_install, log=log)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=t_conf, log=log)
    # Naming packages makes apt mark them manually installed: give back the marks of the plan
    # (dependencies stay removable by autoremove).
    if plan.get("auto"):
        run(["apt-mark", "auto"] + plan["auto"], timeout=120, log=log)
    have = installed()
    wrong = [p["name"] for p in plan["packages"] if have.get(p["name"]) != p["new"]]
    if wrong:
        raise Fail("not at the planned version afterwards: %s" % ", ".join(wrong))


def install_recovery(plan, log, budget):
    dpkg_state_check(plan, any_version=True)
    # Before the first change, against the card as it is now (it may have changed since the update
    # was planned): would the end state satisfy every dependency? (review 2026-11-27 #88)
    kept = read_json(PREVIOUS + "/manifest.json")
    reason = trial_rollback(plan, kept, PREVIOUS, live=True) if kept else "no kept release"
    if reason:
        raise Drift("going back can't be done safely on this card as it is now (%s): nothing changed" % reason)
    # What going back removes must still be exactly what the request planned (the card can change
    # between the request and this boot; #112).
    # After a cut part-way (some removals done), what is left must be a part of it (#121).
    gone_now = set(n for n in installed_any() if is_handtop(n) and n not in NEVER_ROLLED_BACK
                   and n not in {p["name"] for p in kept["packages"]})
    planned = set(plan.get("remove", []))
    if not (gone_now <= planned if plan_changed(plan) else gone_now == planned):
        raise Drift("this card's Handtop packages changed since going back was requested: nothing changed")
    # The kept release's packages the plan leaves alone must still be as kept (#112).
    healthy, mine = installed_healthy(), {p["name"] for p in plan["packages"]}
    moved = [p["name"] for p in kept["packages"] if p["name"] not in mine and healthy.get(p["name"]) != p["version"]]
    if moved:
        raise Drift("%s changed since going back was requested: nothing changed" % ", ".join(moved[:6]))
    budget(1200 + 3600 + 1200)                   # enough time left for the whole of it, or nothing starts
    mark_changed(plan)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    dpkg_state_check(plan, any_version=True)     # still only the planned packages unfinished (#111)
    # The packages the newer release added go first: one of them may Break the kept release's
    # packages, and dpkg -i would refuse those then (review 2026-11-26 #69). The kept release's
    # packages, installed right after, satisfy what depended on them (the trial checked the end state).
    if plan.get("remove"):
        run(["dpkg", "--remove", "--force-depends", "--force-remove-reinstreq"] + plan["remove"],
            timeout=budget(1200), log=log)
    files = [os.path.join(PREVIOUS, p["file"]) for p in plan["packages"]]
    if files:
        run(["dpkg"] + CONF + ["-i"] + files, timeout=budget(3600), log=log)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log)
    run(["apt-get", "check", "-q"] + APT_CONF, timeout=300, log=log)   # every dependency satisfied
    have = installed_healthy()
    wrong = [p["name"] for p in kept["packages"] if have.get(p["name"]) != p["version"]]   # the whole release (#112)
    wrong += [n for n in plan.get("remove", []) if n in installed_any()]
    if wrong:
        raise Fail("not as planned afterwards: %s" % ", ".join(wrong))


def power(action):
    """Request a restart or power-off; if systemd refuses, force it (everything is synced)."""
    if NO_POWER_ACTION:
        print("handtop-update: would %s now" % action, flush=True)
        return
    try:
        subprocess.run(["sync"], timeout=120)
    except subprocess.SubprocessError:
        pass
    try:
        # Queued while the unit still runs, so the shutdown cancels system-update-cleanup.service.
        if subprocess.run(["systemctl", action, "--no-block"], timeout=60).returncode == 0:
            return
    except subprocess.SubprocessError:
        pass
    subprocess.run(["systemctl", "--force", "--force", action], timeout=60)


def finish(plan, ok, message, log, resume=False, extra=None):
    """Result first (synced), then the FAT copy, then the plan's files and the marker, then the
    restart / power-off. A cut anywhere repeats only these steps (apply() sees the result)."""
    policy_rc(False)
    sched = read_json(SCHEDULE) or {}
    action = "poweroff" if resume or sched.get("after") == "poweroff" else "reboot"
    res = dict(extra or {}, plan=(plan or {}).get("id"), ok=ok, message=message, time=int(time.time()),
               log=log.path, action=action, final=not resume, gen=sched.get("gen"))
    write_json(RESULT, res)
    console(message)
    log(message)
    log.sync()
    copy_log_to_fat(log.path, "update")
    if not resume:
        settle_previous(plan, ok)
        # A failed migration keeps its plan (lists, downloads, decisions): the same command resumes it.
        # Meanwhile v0.4.x's FFmpeg holds are back (decision 2026-11-24); resuming releases them again.
        if not ok and (plan or {}).get("kind") == "migrate":
            try:
                restore_legacy_holds(keep_journal=True)
            except Exception as e:      # noqa: BLE001 - never stops the finish
                log("could not hold FFmpeg again: %r" % e)
        complete(ok, keep_plan=not ok and (plan or {}).get("kind") == "migrate")
    power(action)


def complete(ok, keep_plan=False):
    """The plan's files and the link go. Recorded first (cleanup.json: plan id and the schedule's gen),
    so a cut in the middle is finished at the next start (review #91)."""
    plan, sched = read_json(PLAN) or {}, read_json(SCHEDULE) or {}
    c = {"plan": plan.get("id"), "gen": sched.get("gen"), "ok": ok, "keep_plan": keep_plan}
    write_json(CLEANUP, c)
    _cleanup(c)


def _cleanup(c):
    """Delete what still belongs to the plan and scheduling c names, nothing else (#104, #113)."""
    plan, sched = read_json(PLAN) or {}, read_json(SCHEDULE) or {}
    if plan.get("id") and plan["id"] != c.get("plan"):
        mine_plan = False                        # another plan was made since: none of it is touched
    else:
        mine_plan = bool(plan) and (not sched or sched.get("plan") != c.get("plan") or sched.get("gen") == c.get("gen"))
    mine_sched = bool(sched) and sched.get("plan") == c.get("plan") and sched.get("gen") == c.get("gen")
    if sched and not plan:
        mine_sched = True                        # a schedule with no plan left installs nothing (#113)
    if mine_plan and not c.get("keep_plan"):
        unlink(PLAN)
    if mine_sched:
        remove_marker()
        unlink(SCHEDULE)
    if not read_json(SCHEDULE) and our_marker():
        remove_marker()                          # a link with nothing scheduled to install (#113)
    if (read_json(INPROGRESS) or {}).get("plan") == c.get("plan") and (mine_sched or not read_json(SCHEDULE)):
        unlink(INPROGRESS)
    if not c.get("keep_plan") and not read_json(PLAN):
        for f in (CHANGED, LATER_EDITS):
            if (read_json(f) or {}).get("plan") in (None, c.get("plan")):
                unlink(f)
        for d in (LISTS, PREFS, NEXT) + ((CACHE,) if c.get("ok") else ()):
            rmtree(d)
    fsync_dir(STATE)
    unlink(CLEANUP)
    fsync_dir(STATE)


def finish_cleanup():
    """A cleanup cut short: finish it for its own plan and scheduling only. True when there was one."""
    c = read_json(CLEANUP)
    if not c:
        return False
    _cleanup(c)
    return True


def kept_config(since):
    """Config files dpkg kept because they were edited: the package's version sits next to them
    (.dpkg-dist), written by this install."""
    res = []
    for top, dirs, files in os.walk("/etc"):
        for f in files:
            if f.endswith(".dpkg-dist"):
                p = os.path.join(top, f)
                try:
                    # ctime: dpkg gives the file the package's modification time, not the install's
                    if os.lstat(p).st_ctime >= since - 1:
                        res.append(p)
                except OSError:
                    pass
    return sorted(res)


def cmd_apply():
    if not our_marker():
        return 0                      # no marker, or another updater's: not ours to act on
    log = Log("update")
    with lock(wait=60):
        if not our_marker():          # checked again under the lock: it may have changed meanwhile
            log("the marker is gone or not ours any more: nothing to do")
            return 0
        if finish_cleanup():          # the last run's result is recorded; only its cleanup was cut
            log("finished the cleanup a cut interrupted")
            power((read_json(RESULT) or {}).get("action", "reboot"))
            return 0
        plan, sched, res = read_json(PLAN), read_json(SCHEDULE), read_json(RESULT) or {}
        try:
            repair_previous()
            # A result for this plan written during this schedule: a cut came after it. Finish only.
            # (An older result for the same plan, e.g. an interruption before it was scheduled again, is not.)
            if (res.get("final") and plan and res.get("plan") == plan.get("id") and sched and (
                    res.get("gen") == sched["gen"] if sched.get("gen") else res.get("time", 0) >= sched.get("at", 0))):
                log("the result was recorded before a cut: finishing")       # idempotent end
                copy_log_to_fat(res["log"] if os.path.isfile(res.get("log") or "") else log.path, "update")
                settle_previous(plan, res.get("ok"))
                if not res.get("ok") and plan.get("kind") == "migrate":
                    restore_legacy_holds(keep_journal=True)        # as finish() does (#92)
                complete(res.get("ok"), keep_plan=not res.get("ok") and plan.get("kind") == "migrate")
                power(res.get("action", "reboot"))
                return 0
            if not plan or not sched or sched.get("plan") != plan.get("id"):
                finish(plan, False, "no matching downloaded update found; starting normally", log)
                return 1
            attempts = sched.get("attempts")
            if not isinstance(attempts, int) or attempts >= MAX_ATTEMPTS:
                finish(plan, False, ("the move onto packages stopped after %s attempts; it is kept: run the same "
                                     "command again to resume it" if plan.get("kind") == "migrate" else
                                     "update stopped after %s attempts; recovery.txt can go back") % attempts, log)
                return 1
            for _ in range(20):        # the fuel gauge can take a moment after power-on
                why = power_ok(STOP_BATTERY)
                if not why or "can't be read" not in why:
                    break
                time.sleep(1)
            if why:
                deferrals = sched.get("deferrals", 0) + 1
                if deferrals >= MAX_DEFERRALS:
                    finish(plan, False, "update cancelled: %s at %d starts in a row" % (why, MAX_DEFERRALS), log)
                    return 1
                write_json(SCHEDULE, dict(sched, deferrals=deferrals))
                finish(plan, None, "%s: switching off. Charge, then switch on: the update continues." % why,
                       log, resume=True)
                return 1
            write_json(SCHEDULE, dict(sched, attempts=attempts + 1, deferrals=0))
            prog_start = int(time.time())
            write_json(INPROGRESS, {"plan": plan["id"], "attempt": attempts + 1, "started": prog_start,
                                    "gen": sched.get("gen")})
            budget = Budget(APPLY_BUDGET)
            try:
                if plan["kind"] in ("update", "migrate"):
                    verify_files(plan["packages"], CACHE)
                    mb, inodes = free_space(STATE)
                    if mb < plan.get("size_mb", 0) + plan.get("backup_mb", 0) + 150 or inodes < MIN_INODES:
                        raise Fail("not enough free space to install (%d MB, %d inodes free)" % (mb, inodes))
                    if plan["kind"] == "update":
                        check_kept_release(plan)          # promoted by install_update, after its checks
                else:
                    verify_files(plan["packages"], PREVIOUS)
            except Fail as e:
                finish(plan, False, "update not installed: %s" % e, log)
                return 1
            console("%s. Do not switch off (attempt %d of %d)." % (
                "Going back to the previous Handtop release" if plan["kind"] == "recovery"
                else "Moving Handtop %s onto packages (%d to install)" % (plan["from"]["release"], len(plan["packages"]))
                if plan["kind"] == "migrate"
                else "Installing %d updates" % len(plan["packages"]), attempts + 1, MAX_ATTEMPTS))
            log("attempt %d of %d" % (attempts + 1, MAX_ATTEMPTS))
            log("plan: %s" % json.dumps(plan))
            log.sync()
            policy_rc(True)
            error, notes = None, []
            installer = {"update": install_update, "recovery": install_recovery, "migrate": install_migrate}
            for _ in range(2):                    # one retry in place
                try:
                    notes = installer[plan["kind"]](plan, log, budget) or []
                    error = None
                    break
                except (Drift, subprocess.TimeoutExpired) as e:   # a time-out: no second run (#90)
                    error = e
                    break
                except (Fail, OSError, subprocess.SubprocessError) as e:
                    error = e
                    log("FAILED: %s" % e)
            if error:
                finish(plan, False, "update failed: %s" % error, log)
                return 1
            # since the plan was scheduled: a file kept by an earlier, cut attempt counts too
            extra = {"kept_config": kept_config(min(prog_start, (read_json(SCHEDULE) or {}).get("at") or prog_start,
                                                    plan.get("first_scheduled") or prog_start)),
                     "notes": notes}
            if plan["kind"] == "migrate":
                extra["migrated_from"] = plan["from"]["release"]
            if plan["kind"] == "update":
                manifest = read_json(PREVIOUS + "/manifest.json")
                if manifest and manifest.get("for_plan") == plan["id"]:
                    extra["rollback_available"] = manifest.get("complete", False)
            finish(plan, True, ("back to the previous Handtop release; " if plan["kind"] == "recovery"
                                else "Handtop moved onto packages (updates from now on); "
                                if plan["kind"] == "migrate" else "update installed; ") + (
                "switching off" if (read_json(SCHEDULE) or {}).get("after") == "poweroff" else "restarting"),
                log, extra=extra)
            return 0
        except Exception as e:               # noqa: BLE001 - always end with a result and a restart
            log("INTERNAL ERROR: %r" % e)
            finish(plan, False, "update failed (internal error: %s)" % e, log)
            return 1


# ---- normal boot --------------------------------------------------------------------------------

def self_test_ok(path):
    try:
        return subprocess.run([path, "--self-test"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def cmd_boot_check():
    """Every normal boot: report a maintenance boot that was stopped (time-out, crash), remove its
    service blocker, finish a cut promotion of the kept release, keep working copies of the tools."""
    log = None
    with lock(wait=60):
        repair_previous()
        if not our_marker():
            finish_cleanup()                   # a cleanup a cut interrupted (#91)
            if kept_migration() and os.path.exists(MIGRATE_HOLDS):
                restore_legacy_holds(keep_journal=True)   # a kept move: FFmpeg stays held meanwhile (#92)
        prog = read_json(INPROGRESS)
        res = read_json(RESULT) or {}
        if prog and not our_marker() and res.get("final") and res.get("plan") == prog.get("plan") and (
                res.get("gen") == prog["gen"] if prog.get("gen") else res.get("time", 0) >= prog.get("started", 0)):
            unlink(INPROGRESS)        # the result was written, then a cut: keep it (and the plan's cleanup)
            if res.get("ok") or (read_json(PLAN) or {}).get("kind") != "migrate":
                complete(res.get("ok"))
            prog = None
        if prog and not our_marker():
            log = Log("update")
            audit = run(["dpkg", "--audit"], timeout=300, check=False).stdout.strip()
            msg = ("the maintenance boot was stopped before the update finished (time-out or crash)%s"
                   % ("; some packages need repair: run the update again or use recovery.txt" if audit else ""))
            write_json(RESULT, {"plan": prog.get("plan"), "ok": False, "message": msg, "time": int(time.time()),
                                "log": log.path, "interrupted": True, "final": True, "dpkg_audit": audit[-2000:]})
            log(msg + ("\n" + audit if audit else ""))
            unlink(INPROGRESS)
            copy_log_to_fat(log.path, "update")
        pend = read_json(BOOT_PENDING)
        if pend and not our_marker() and os.path.ismount(FAT) and os.access(FAT, os.W_OK):
            log = log or Log("update")
            notes = migrate_boot_files({"from": {"release": pend.get("release")}}, release_data(), log)
            log("boot partition files: %s" % "; ".join(notes))
            res = read_json(RESULT)
            owner = (pend.get("ident") or {}).get("plan")
            if res and not os.path.exists(BOOT_PENDING) and res.get("migrated_from") and \
                    owner and res.get("plan") == owner:   # the migration's own result only (#72, #105, #115)
                res["notes"] = [n for n in res.get("notes", []) if "not written yet" not in n] + \
                    ["boot partition files written at a later start"]
                write_json(RESULT, res)
        if not our_marker():
            policy_rc(False)
        os.makedirs(LKG, exist_ok=True)
        for tool in ("handtop-update", "handtop-recovery"):
            cur = "/usr/local/sbin/" + tool
            keep = os.path.join(LKG, tool)
            if os.path.isfile(cur) and self_test_ok(cur):
                if not os.path.isfile(keep) or sha256(keep) != sha256(cur):
                    shutil.copy2(cur, keep + ".new")
                    os.chmod(keep + ".new", 0o755)
                    os.rename(keep + ".new", keep)
        fsync_dir(LKG)
    return 0


def self_test():
    inst, rem = parse_sim("Inst a [1] (2 Handtop:trixie-stable [arm64])\nPurg b\n")
    assert inst[0]["new"] == "2" and inst[0]["arch"] == "arm64" and rem == ["b"]
    assert _deps("a (>= 1), b | c:any")[1][1][0] == "c"
    return 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    cmds = {"status": cmd_status, "check": cmd_check, "download": cmd_download, "schedule": cmd_schedule,
            "migrate": cmd_migrate,
            "cancel": cmd_cancel, "apply": cmd_apply, "boot-check": cmd_boot_check, "channel": cmd_channel,
            "repair": cmd_repair, "abandon-migration": cmd_abandon_migration}
    args = sys.argv[2:]
    if len(sys.argv) < 2 or sys.argv[1] not in cmds or len(args) > {"schedule": 2, "channel": 1}.get(sys.argv[1], 0):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("handtop-update: run as root (the Update app uses sudo)", file=sys.stderr)
        return 2
    os.makedirs(STATE, mode=0o755, exist_ok=True)
    try:
        return cmds[sys.argv[1]](*args)
    except Fail as e:
        out({"ok": False, "error": str(e)})
        return 1
    except subprocess.TimeoutExpired as e:
        out({"ok": False, "error": "timed out: %s" % " ".join(e.cmd[:2])})
        return 1
    except Exception as e:                   # noqa: BLE001 - the app always gets JSON
        out({"ok": False, "error": "internal error: %r" % e})
        return 1


if __name__ == "__main__":
    sys.exit(main())
