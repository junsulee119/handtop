#!/usr/bin/python3
"""Handtop's update worker (docs/services/update.md).

    handtop-update status      downloaded / scheduled / going back possible / last result (JSON)
    handtop-update check       refresh the package lists and list the available updates (JSON)
    handtop-update download    download the update, the release to go back to, and save the plan
    handtop-update schedule [restart|poweroff]
                               after checks, install at the next restart; then start the desktop
                               (restart, default) or switch off
    handtop-update migrate     v0.4.x card (no Handtop packages yet): check, download and save the plan
                               that moves it onto packages (handtop-migrate runs it; schedule next)
    handtop-update cancel      forget the downloaded update
    handtop-update channel stable|testing
                               where Handtop's packages come from (cancels a downloaded update)
    handtop-update apply       maintenance boot only (handtop-update-apply.service)
    handtop-update boot-check  normal boot only (handtop-update-boot-check.service)
    handtop-update --self-test exit 0 if this copy works (handtop-run uses it)

Updates are never installed in the running desktop. They are downloaded here, then installed in
systemd's offline-update boot (system-update.target, entered while the /system-update link
exists), where no session, input daemon or controller mode runs. The plan is exact: the package
lists are frozen at download, every file's SHA-256 is recorded, and the maintenance boot refuses
to do anything the plan didn't approve. The Update app runs status, check, download, schedule,
cancel and channel through sudo (/etc/sudoers.d/rg35xxh-update). recovery.txt is handled by
handtop-recovery, a separate small script.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
import uuid

STATE = "/var/lib/handtop-update"
PLAN = STATE + "/plan.json"
SCHEDULE = STATE + "/schedule.json"     # {plan, after, attempts, deferrals}
INPROGRESS = STATE + "/in-progress.json"
RESULT = STATE + "/last-result.json"
CHECKED = STATE + "/checked.json"
CACHE = STATE + "/cache"                # the plan's .debs
LISTS = STATE + "/lists"                # the package lists the plan was made from (hard links)
PREFS = STATE + "/prefs.d"              # preferences for a plan that holds Handtop back (new image)
EMPTY = STATE + "/empty"
PREVIOUS = STATE + "/previous"          # the release to go back to (handtop=previous)
NEXT = PREVIOUS + ".next"               # staged by download, becomes PREVIOUS when the install starts
OLD = PREVIOUS + ".old"
LKG = STATE + "/lkg"                    # last copies of the worker and handtop-recovery that worked
NO_PREDECESSOR = STATE + "/no-predecessor"   # a plan whose installed release can't be kept for going back
RELEASES = "/usr/local/share/handtop/releases.tsv"   # files Handtop put on v0.4.x cards (tools/release-data.py)
BOOT_TEMPLATES = "/usr/local/share/handtop/boot"     # recovery.txt, rg35xxh-input.conf as images write them
BACKUP = "/var/backups/handtop-migrate"              # files the user changed that the migration replaced
MIGRATE_TARGETS = ("handtop", "handtop-platform-h700")
MODEL = "/etc/handtop/model"
BOOT_PENDING = STATE + "/boot-files-pending.json"    # a migration's FAT files not written yet
UNITS_SEEN = "/var/lib/handtop/units-enabled"         # the packages' postinst enables a unit once
MIGRATE_DROPINS = ("rg35xxh-bootlogo.service", "rg35xxh-bt-check.service")   # handtop-migrate's
DROPIN_NAME = "handtop-migrate-maintenance.conf"
FATSEQ = STATE + "/fat-seq"
MARKER = "/system-update"
LOCK = "/run/handtop-update.lock"
LOGDIR = "/var/log/handtop-update"
FAT = "/boot/firmware"
BOOT_ABI = "/etc/handtop/boot-abi"
MAIN_SOURCES = "/etc/apt/sources.list.d/handtop.sources"             # handtop-keyring's; never edited
CHANNEL_SOURCES = "/etc/apt/sources.list.d/handtop-testing.sources"  # 'channel testing'
TESTING_STANZA = """\
# Written by 'handtop-update channel testing' (Update app); 'channel stable' removes it.
# Packages from testing stay installed until stable has the same or newer versions.
Types: deb
URIs: https://junsulee119.github.io/handtop-apt
Suites: trixie-testing
Components: main
Signed-By: /usr/share/keyrings/handtop-archive.asc
"""
POLICY_RC = "/usr/sbin/policy-rc.d"
POLICY_SAVED = POLICY_RC + ".handtop-saved"
POLICY_BODY = "#!/bin/sh\n# handtop-update: no service starts during the maintenance boot\nexit 101\n"
APPLY_UNIT = "handtop-update-apply.service"
SYSFS = os.environ.get("HANDTOP_UPDATE_SYSFS", "/sys")          # tests point it at a fake tree
NO_POWER_ACTION = os.environ.get("HANDTOP_UPDATE_NO_POWER_ACTION") == "1"   # tests: chroot
CHROOT_TEST = os.environ.get("HANDTOP_UPDATE_CHROOT") == "1"   # tests: systemd can't answer is-active
MAX_ATTEMPTS = 3          # maintenance boots per plan that start installing (power cuts included)
MAX_DEFERRALS = 3         # maintenance boots that switch off without installing (unknown battery)
MIN_BATTERY = 40          # to schedule without the charger
STOP_BATTERY = 10         # the maintenance boot switches off below this and continues later
CHECK_MAX_AGE = 24 * 3600
APPLY_BUDGET = 100 * 60   # handtop-update-apply.service has TimeoutStartSec=120min
CONTROLLER_UNITS = ("rg35xxh-btpad", "rg35xxh-btclassic", "rg35xxh-usbpad",
                    "rg35xxh-switchpad", "rg35xxh-switchbt")
FFMPEG_FAMILY = ("ffmpeg", "libavcodec61", "libavdevice61", "libavfilter10", "libavformat61",
                 "libavutil59", "libpostproc58", "libswresample5", "libswscale8")
FFMPEG_DEV = ("libavcodec-dev", "libavdevice-dev", "libavfilter-dev", "libavformat-dev",
              "libavutil-dev", "libpostproc-dev", "libswresample-dev", "libswscale-dev")
LEGACY_HOLDS = FFMPEG_FAMILY[1:]   # the 8 libraries v0.4.x images held (the ffmpeg CLI was unowned)
MIGRATE_HOLDS = STATE + "/migrate-holds.json"   # holds the migration released (put back on cancel)
NEVER_ROLLED_BACK = ("handtop-keyring",)    # an old keyring could lack the current signing key
APT_ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C",
               APT_LISTCHANGES_FRONTEND="none", PATH="/usr/sbin:/usr/bin:/sbin:/bin")
CONF = ["--force-confdef", "--force-confold"]
APT_CONF = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


class Fail(Exception):
    pass


class Drift(Fail):
    """The card no longer matches the plan: retrying can't help."""


def out(obj):
    print(json.dumps(obj, indent=1, sort_keys=True), flush=True)


# ---- files ------------------------------------------------------------------------------------

def fsync_dir(path):
    d = os.open(path, os.O_RDONLY)
    try:
        os.fsync(d)
    finally:
        os.close(d)


def write_atomic(path, data, mode=0o644):
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb" if isinstance(data, bytes) else "w") as f:      # text or bytes
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.rename(tmp, path)
    fsync_dir(os.path.dirname(path) or ".")


def write_json(path, obj):
    write_atomic(path, json.dumps(obj, indent=1, sort_keys=True))


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def unlink(path):
    if os.path.lexists(path):
        os.unlink(path)


def rmtree(path):
    if os.path.lexists(path):
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path)
        else:
            os.unlink(path)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def free_space(path):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize // (1 << 20), st.f_favail


# ---- logs -------------------------------------------------------------------------------------

class Log:
    """Root log in /var/log/handtop-update; command output is streamed into it as it comes."""

    def __init__(self, kind):
        os.makedirs(LOGDIR, exist_ok=True)
        self.path = os.path.join(LOGDIR, "%s-%s.log" % (kind, time.strftime("%Y%m%d-%H%M%S")))
        self.f = open(self.path, "a", buffering=1)

    def __call__(self, text):
        self.f.write(time.strftime("%H:%M:%S ") + text.rstrip("\n") + "\n")
        self.f.flush()

    def sync(self):
        try:
            os.fsync(self.f.fileno())
        except OSError:
            pass


def tail(path, n):
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - n))
        return f.read().decode("utf-8", "replace")


def run(cmd, timeout, log=None, check=True, cwd=None):
    """Run cmd. With a log, output goes straight to the log file (so a power cut leaves what the
    command printed so far); the result's stdout is then the last part of it."""
    if log:
        log("$ " + " ".join(cmd))
        start = log.f.tell()
        # Saved to the card every 2 s while the command runs: a power cut keeps what it printed so far.
        p = subprocess.Popen(cmd, env=APT_ENV, cwd=cwd, stdout=log.f, stderr=subprocess.STDOUT)
        deadline = time.monotonic() + timeout
        try:
            while True:
                try:
                    p.wait(timeout=2)
                    break
                except subprocess.TimeoutExpired:
                    log.sync()
                    if time.monotonic() > deadline:
                        p.kill()
                        p.wait()
                        raise subprocess.TimeoutExpired(cmd, timeout)
        finally:
            log.f.flush()
            log.sync()
        with open(log.path, "rb") as f:
            f.seek(start)
            text = f.read()[-20000:].decode("utf-8", "replace")
        p.stdout = text
    else:
        p = subprocess.run(cmd, env=APT_ENV, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, errors="replace", timeout=timeout)
    if check and p.returncode != 0:
        raise Fail("%s failed (%d): %s" % (" ".join(cmd[:2]), p.returncode, p.stdout.strip()[-600:]))
    return p


def copy_log_to_fat(path, kind):
    """A short copy on the boot partition (logs\\<kind>-NNNNNN.txt), readable from any PC; the last
    5 are kept. Best effort: never part of a transaction."""
    try:
        if not os.path.ismount(FAT) or not os.access(FAT, os.W_OK):
            return
        logs = FAT + "/logs"
        os.makedirs(logs, exist_ok=True)
        seq = (read_json(FATSEQ) or {}).get(kind, 0) + 1
        write_json(FATSEQ, dict(read_json(FATSEQ) or {}, **{kind: seq}))
        name = "%s-%06d.txt" % (kind, seq % 1000000)
        write_atomic(os.path.join(logs, name), tail(path, 60000).replace("\r", "").replace("\n", "\r\n"))
        mine = sorted((f for f in os.listdir(logs) if re.match(kind + r"-\d{6}\.txt$", f)),
                      key=lambda f: os.path.getmtime(os.path.join(logs, f)))
        for f in mine[:-5]:
            os.unlink(os.path.join(logs, f))
    except Exception:       # noqa: BLE001 - a broken FAT must never stop an update from finishing
        pass


def console(msg):
    line = "Handtop: %s" % msg
    print(line, flush=True)
    try:
        with open("/dev/tty1", "w") as t:
            t.write("\r\n" + line + "\r\n")
    except OSError:
        pass


# ---- system state -------------------------------------------------------------------------------

def lock(wait=0):
    f = open(LOCK, "w")
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except OSError:
            if time.time() >= end:
                f.close()
                raise Fail("another update operation is running")
            time.sleep(1)


_NATIVE = []


def native_arch():
    if not _NATIVE:
        _NATIVE.append(run(["dpkg", "--print-architecture"], timeout=30).stdout.strip())
    return _NATIVE[0]


def installed():
    """{package: version} of the installed packages, held ones included. Names as apt prints them:
    plain for the native architecture and all, name:arch for a foreign one."""
    p = run(["dpkg-query", "-W", "-f", "${Package}\\t${Architecture}\\t${Version}\\t${db:Status-Abbrev}\\n"],
            timeout=60)
    res = {}
    for line in p.stdout.splitlines():
        name, arch, ver, st = line.split("\t")
        if len(st) > 1 and st[1] == "i":
            res[name if arch in (native_arch(), "all") else "%s:%s" % (name, arch)] = ver
    return res


def boot_abi():
    res = {}
    try:
        for line in open(BOOT_ABI):
            k, _, v = line.strip().partition("=")
            res[k] = v
    except OSError:
        pass
    return res


def our_marker():
    """True: the marker is ours. None: no marker. False: someone else's offline update."""
    if not os.path.lexists(MARKER):
        return None
    try:
        return os.path.islink(MARKER) and os.readlink(MARKER) == STATE
    except OSError:
        return False


def set_marker():
    if our_marker() is False:
        raise Fail("another offline update is scheduled (/system-update); not touching it")
    if our_marker() is None:
        os.symlink(STATE, MARKER)
    fsync_dir("/")


def remove_marker():
    if our_marker():
        os.unlink(MARKER)
        fsync_dir("/")


def battery():
    """(capacity or None, charging, has_battery)."""
    def rd(p):
        try:
            with open(os.path.join(SYSFS, p)) as f:
                return f.read().strip()
        except OSError:
            return None
    has = os.path.isdir(os.path.join(SYSFS, "class/power_supply/battery"))
    cap = rd("class/power_supply/battery/capacity")
    cap = int(cap) if cap and cap.isdigit() and 0 <= int(cap) <= 100 else None
    return cap, rd("class/power_supply/axp20x-usb/online") == "1", has


def handheld():
    """A battery-powered Anbernic handheld (its device tree says so), as opposed to a test machine."""
    try:
        with open("/proc/device-tree/compatible", "rb") as f:
            return b"anbernic," in f.read()
    except OSError:
        return False


def power_ok(minimum):
    """None if fine, else the reason. Unknown is only fine on a machine without a battery: on the
    handheld a battery that hasn't shown up yet counts as unreadable, not as absent."""
    cap, charging, has = battery()
    if charging or not (has or handheld()):
        return None
    if cap is None:
        return "the battery level can't be read"
    if cap < minimum:
        return "battery at %d%%" % cap
    return None


def controller_mode_active():
    if CHROOT_TEST:
        return None
    for u in CONTROLLER_UNITS:
        p = subprocess.run(["systemctl", "is-active", u + ".service"], stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, text=True, timeout=15)
        state = p.stdout.strip()
        if state in ("active", "activating", "reloading", "deactivating", "refreshing"):
            return u
        if state not in ("inactive", "failed", "unknown"):
            raise Fail("can't tell whether %s is running (%s)" % (u, state or "no answer from systemd"))
    return None


# ---- what apt would do ----------------------------------------------------------------------------

def apt_opts(frozen=False, held=False):
    o = []
    if frozen:
        o += ["-o", "Dir::State::Lists=" + LISTS, "-o", "Dir::Cache::pkgcache=",
              "-o", "Dir::Cache::srcpkgcache="]
    if held:
        o += ["-o", "Dir::Etc::PreferencesParts=" + PREFS]
    return o + APT_CONF


def parse_sim(text):
    inst, removes = [], []
    for line in text.splitlines():
        m = re.match(r"^Inst (\S+) (?:\[(\S+)\] )?\((\S+) (.*?)(?: \[(\S+)\])?\)", line)
        if m:
            inst.append({"name": m.group(1), "old": m.group(2), "new": m.group(3),
                         "origin": m.group(4), "arch": m.group(5)})
        m = re.match(r"^(?:Remv|Purg) (\S+)", line)
        if m:
            removes.append(m.group(1))
    return inst, removes


def simulate(opts, extra=(), what=("dist-upgrade",)):
    p = run(["apt-get", "-s", "-q"] + list(extra) + opts + list(what), timeout=300)
    inst, removes = parse_sim(p.stdout)
    if removes:
        raise Fail("the update would remove packages (%s); not doing it" % ", ".join(removes))
    return inst


def is_handtop(name):
    return name == "handtop" or name.startswith("handtop-")


def write_held_prefs():
    """Preferences for a Debian-only plan: Handtop's packages and FFmpeg build stay where they are."""
    rmtree(PREFS)
    os.makedirs(PREFS)
    if os.path.isdir("/etc/apt/preferences.d"):
        for f in os.listdir("/etc/apt/preferences.d"):
            src = os.path.join("/etc/apt/preferences.d", f)
            if os.path.isfile(src):
                shutil.copy(src, os.path.join(PREFS, f))
    # apt uses the first matching pin and reads the files in name order: this one must come first.
    write_atomic(PREFS + "/00-handtop-new-image", (
        "# handtop-update: this card needs a new image for the next Handtop release; until then\n"
        "# only Debian's updates are installed.\n"
        "Package: handtop handtop-* %s %s\nPin: release o=Handtop\nPin-Priority: -1\n")
        % (" ".join(FFMPEG_FAMILY), " ".join(FFMPEG_DEV)))


def modules_mismatch(inst, opts, want=None):
    """Modules packages in the plan whose kernel (Handtop-Kernel-SHA256) isn't this card's."""
    want = want or boot_abi().get("kernel_sha256")
    bad = []
    for i in inst:
        if not i["name"].startswith("handtop-modules-"):
            continue
        tmp = STATE + "/modcheck"
        rmtree(tmp)
        os.makedirs(tmp)
        stage_for_apt(tmp)
        try:
            run(["apt-get", "download", "-q"] + opts + ["%s=%s" % (i["name"], i["new"])], timeout=600, cwd=tmp)
            debs = [f for f in os.listdir(tmp) if f.endswith(".deb")]
            have = run(["dpkg-deb", "-f", os.path.join(tmp, debs[0]), "Handtop-Kernel-SHA256"],
                       timeout=60).stdout.strip() if debs else ""
        finally:
            rmtree(tmp)
        if not want or not have or have != want:
            bad.append(i["name"])
    return bad


def plan_transaction(frozen):
    """(updates, handtop_held, new_image_packages)."""
    inst = simulate(apt_opts(frozen))
    bad = modules_mismatch(inst, apt_opts(frozen))
    if not bad:
        return inst, False, []
    write_held_prefs()
    inst = simulate(apt_opts(frozen, held=True))
    still = [i["name"] for i in inst if is_handtop(i["name"]) or i["name"] in FFMPEG_FAMILY + FFMPEG_DEV]
    if still:    # e.g. an administrator's pin outranks ours: refuse rather than install them
        raise Fail("this card needs a new image, but the Debian-only update would still change %s "
                   "(check /etc/apt/preferences.d)" % ", ".join(still))
    return inst, True, bad


def ffmpeg_pin_effective():
    """Handtop's pin works for every FFmpeg package: each one's Debian versions are at -1, and each has
    at least one (a failed query or no evidence = not shown to work, so holds stay)."""
    p = run(["apt-cache", "policy"] + list(FFMPEG_FAMILY), timeout=120, check=False)
    if p.returncode != 0:
        return False
    sections = re.split(r"^(\S+):\s*$", p.stdout, flags=re.M)
    found = {sections[i]: sections[i + 1] for i in range(1, len(sections) - 1, 2)}
    return all(n in found and debian_versions_pinned_out(found[n], need_evidence=True) for n in FFMPEG_FAMILY)


def debian_versions_pinned_out(policy, need_evidence=False):
    """apt-cache policy's version table: each version line ("[***] VERSION PIN") is followed by its
    sources ("PRIORITY URI ..."). True when every version a debian.org source offers has pin -1
    (need_evidence: and at least one such version is listed)."""
    pins, cur = [], None
    for line in policy.splitlines():
        m = re.match(r"^\s+(?:\*\*\* )?(\S+) (-?\d+)$", line)
        if m:
            cur = int(m.group(2))
            continue
        if cur is not None and re.match(r"^\s+-?\d+ \S*debian\.org", line):
            pins.append(cur)
    return all(x == -1 for x in pins) and (bool(pins) or not need_evidence)


def held_ffmpeg():
    """Handtop's FFmpeg packages the user (or a v0.4.x image) holds; updates to them are skipped."""
    held = set(run(["apt-mark", "showhold"], timeout=60).stdout.split())
    return [n for n in FFMPEG_FAMILY + FFMPEG_DEV if n in held]


def hold_warnings():
    h = held_ffmpeg()
    return ["held, so not updated: %s (apt-mark unhold to allow it)" % ", ".join(h)] if h else []


def release_legacy_holds():
    """Migration only: release the holds v0.4.x images set on FFmpeg's libraries, once Handtop's pin is
    shown to work, and remember them (cancel puts them back)."""
    rel = [n for n in held_ffmpeg() if n in LEGACY_HOLDS]
    if not rel:
        return
    if not ffmpeg_pin_effective():
        raise Fail("Handtop's FFmpeg pin is not in effect (/etc/apt/preferences.d/handtop.pref); "
                   "FFmpeg stays held and nothing was changed")
    prev = (read_json(MIGRATE_HOLDS) or {}).get("released", [])
    write_json(MIGRATE_HOLDS, {"released": sorted(set(prev) | set(rel))})
    run(["apt-mark", "unhold"] + rel, timeout=60)


def restore_legacy_holds():
    rel = (read_json(MIGRATE_HOLDS) or {}).get("released", [])
    have = installed()
    rel = [n for n in rel if n in have]
    if rel:
        run(["apt-mark", "hold"] + rel, timeout=60, check=False)
    unlink(MIGRATE_HOLDS)


def release_notes(version):
    """The Handtop release and its short notes, from the handtop metapackage's control data in the
    signed index (Handtop-Release, Handtop-Changes)."""
    p = run(["apt-cache", "show", "handtop=%s" % version], timeout=60, check=False)
    rel, lines, inside = None, [], False
    for line in p.stdout.splitlines():
        if line.startswith("Handtop-Release:"):
            rel = line.split(":", 1)[1].strip()
            inside = False
        elif line.startswith("Handtop-Changes:"):
            inside = True
            first = line.split(":", 1)[1].strip()
            if first:
                lines.append(first)
        elif inside and line.startswith(" "):
            lines.append(line.strip())
        elif line.strip() == "":
            if rel or lines:
                break
        else:
            inside = False
    return {"release": rel, "lines": lines}


def cmd_check():
    with lock():
        warnings = hold_warnings()
        p = run(["apt-get", "update", "-q", "--error-on=any"], timeout=600, check=False)
        problems = [l for l in p.stdout.splitlines() if l.startswith(("E:", "W:", "Err:"))]
        if p.returncode != 0:
            write_json(CHECKED, {"ok": False, "time": int(time.time())})
            out({"ok": False, "error": "could not refresh every package list", "details": problems})
            return 1
        write_json(CHECKED, {"ok": True, "time": int(time.time())})
        inst, held, bad = plan_transaction(frozen=False)
        handtop = [i for i in inst if "Handtop" in i["origin"] or is_handtop(i["name"])]
        meta = next((i for i in inst if i["name"] == "handtop"), None)
        size = sum(v["size"] for v in archive_info(apt_opts(False, held), held, hashes=False).values()) \
            if inst else 0
        out({"ok": True, "updates": inst, "handtop": handtop, "debian": len(inst) - len(handtop),
             "warnings": warnings + problems, "new_image_needed": bad, "handtop_held": held,
             "download_mb": round(size / (1 << 20), 1),
             "release_notes": release_notes(meta["new"]) if meta else None})
        return 0


# ---- download -------------------------------------------------------------------------------------

def stage_for_apt(path):
    """apt-get download keeps its network sandbox only where _apt can write."""
    try:
        import pwd
        os.chown(path, pwd.getpwnam("_apt").pw_uid, 0)
    except (KeyError, OSError):
        pass


def freeze_lists():
    tmp = LISTS + ".new"
    rmtree(tmp)
    os.makedirs(tmp + "/partial")
    src = "/var/lib/apt/lists"
    for f in os.listdir(src):
        p = os.path.join(src, f)
        if os.path.isfile(p) and not os.path.islink(p) and f != "lock":
            os.link(p, os.path.join(tmp, f))   # apt replaces lists by rename: the link keeps this copy
    rmtree(LISTS)
    os.rename(tmp, LISTS)


def archive_info(opts, held, hashes=True, what=("dist-upgrade",)):
    """{(name, version, arch): {file, size, algo, hash}} for every archive of the plan. Names and sizes
    come from apt's download list (asked against an empty archive directory, so already-downloaded
    files count too); the SHA-256 from the signed package indexes (apt-cache show), because the
    download list gives only the weakest hash, or none (Debian's security archive, apt 3.0)."""
    rmtree(EMPTY)
    os.makedirs(EMPTY + "/partial")
    p = run(["apt-get", "-qq", "--print-uris", "-o", "Dir::Cache::archives=" + EMPTY] + opts
            + list(what), timeout=300)
    rmtree(EMPTY)
    res = {}
    from urllib.parse import unquote
    for line in p.stdout.splitlines():
        m = re.match(r"^'(\S+)' (\S+) (\d+)", line)
        if not m:
            continue
        fname = m.group(2)
        parts = fname[:-4].split("_") if fname.endswith(".deb") else []
        if len(parts) != 3:
            continue
        res[(parts[0], unquote(parts[1]), parts[2])] = {"file": fname, "size": int(m.group(3)),
                                                         "algo": "sha256", "hash": None}
    if hashes and res:
        add_sha256(res, opts)
    return res


def add_sha256(res, opts):
    """Fill in each archive's SHA-256 from the package indexes; refuse an archive without one."""
    p = run(["apt-cache", "show"] + opts + ["%s:%s=%s" % (n, a, v) for n, v, a in res], timeout=300)
    for st in p.stdout.split("\n\n"):
        f = dict(re.findall(r"^(Package|Version|Architecture|SHA256|Size): (\S+)$", st, re.M))
        key = (f.get("Package"), f.get("Version"), f.get("Architecture"))
        if key in res and f.get("SHA256") and int(f.get("Size", -1)) == res[key]["size"]:
            res[key]["hash"] = f["SHA256"].lower()
    missing = ["%s %s" % (n, v) for (n, v, _), r in res.items() if not r["hash"]]
    if missing:
        raise Fail("no SHA-256 in the package indexes for %s" % ", ".join(missing))


def file_ok(path, algo, digest):
    if not os.path.isfile(path):
        return False
    if algo == "sha256":
        return sha256(path) == digest
    h = hashlib.new({"md5sum": "md5", "sha1": "sha1", "sha512": "sha512"}.get(algo, algo))
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest() == digest


def verify_files(packages, where):
    bad = [p["name"] for p in packages if not file_ok(os.path.join(where, p["file"]), p["algo"], p["hash"])]
    if bad:
        raise Fail("downloaded files missing or damaged: %s; download again" % ", ".join(bad))


def rollback_set(have):
    """Packages to keep for going back: Handtop's own (but the keyring) and Handtop's FFmpeg build."""
    names = [n for n in have if is_handtop(n) and n not in NEVER_ROLLED_BACK]
    names += [n for n in FFMPEG_FAMILY + FFMPEG_DEV if n in have and "+handtop" in have[n]]
    return sorted(names)


def stage_previous(plan_id, opts):
    """Download the installed release into previous.next (previous/ stays as it is until the
    install starts). Returns its manifest."""
    have = installed()
    names = rollback_set(have)
    tmp = NEXT + ".tmp"
    rmtree(tmp)
    os.makedirs(tmp)
    stage_for_apt(tmp)
    want = ["%s=%s" % (n, have[n]) for n in names]
    p = run(["apt-get", "download", "-q"] + opts + want, timeout=1800, check=False, cwd=tmp) if want else None
    os.chown(tmp, 0, 0)
    pkgs, missing = [], []
    for n in names:
        f = [x for x in os.listdir(tmp) if x.startswith(n + "_") and x.endswith(".deb")]
        if not f:
            missing.append(n)
            continue
        path = os.path.join(tmp, f[0])
        os.chown(path, 0, 0)
        ver = run(["dpkg-deb", "-f", path, "Version"], timeout=60).stdout.strip()
        if ver != have[n]:
            missing.append(n)
            continue
        pkgs.append({"name": n, "version": ver, "file": f[0], "algo": "sha256", "hash": sha256(path)})
    manifest = {"for_plan": plan_id, "release": have.get("handtop"), "packages": pkgs,
                "complete": not missing and bool(pkgs), "missing": missing,
                "warnings": [l for l in (p.stdout.splitlines() if p else []) if l.startswith(("W:", "E:"))]}
    write_json(tmp + "/manifest.json", manifest)
    rmtree(NEXT)
    os.rename(tmp, NEXT)
    fsync_dir(STATE)
    return manifest


# ---- going back: trial (changes nothing) ----------------------------------------------------------

def _vcmp(a, op, b):
    try:
        import apt_pkg
        apt_pkg.init_system()
        c = apt_pkg.version_compare(a, b)
    except ImportError:
        if subprocess.run(["dpkg", "--compare-versions", a, "eq", b]).returncode == 0:
            c = 0
        else:
            c = -1 if subprocess.run(["dpkg", "--compare-versions", a, "lt", b]).returncode == 0 else 1
    return {"<<": c < 0, "<=": c <= 0, "=": c == 0, ">=": c >= 0, ">>": c > 0}[op]


def _deps(text):
    res = []
    for group in filter(None, (g.strip() for g in (text or "").split(","))):
        alts = []
        for a in group.split("|"):
            m = re.match(r"^\s*([a-z0-9][a-z0-9+.-]*)(?::\S+)?\s*(?:\(\s*(<<|<=|=|>=|>>)\s*([^)\s]+)\s*\))?", a.strip())
            if m:
                alts.append((m.group(1), m.group(2), m.group(3)))
        res.append(alts)
    return res


def _fields(deb):
    p = run(["dpkg-deb", "-f", deb, "Package", "Version", "Depends", "Pre-Depends", "Provides"], timeout=60)
    f = dict(re.findall(r"^(\S+): (.*)$", p.stdout, re.M))
    return f.get("Package"), f.get("Version"), ", ".join(x for x in (f.get("Depends"), f.get("Pre-Depends")) if x), f.get("Provides", "")


def trial_rollback(plan, manifest):
    """Would installing the kept release on top of the planned state satisfy every dependency?
    Static check of Depends / Pre-Depends; returns None or the reason."""
    if not manifest or not manifest.get("complete"):
        return "the release to go back to isn't complete (%s)" % ", ".join((manifest or {}).get("missing", []) or ["none kept"])
    p = run(["dpkg-query", "-W", "-f", "${binary:Package}\\t${Version}\\t${Depends}, ${Pre-Depends}\\t${Provides}\\t${db:Status-Abbrev}\\n"], timeout=120)
    state = {}
    for line in p.stdout.splitlines():
        n, v, d, pr, st = line.split("\t")
        if len(st) > 1 and st[1] == "i":
            state[n.split(":")[0]] = (v, d, pr)
    for i in plan["packages"]:                                   # after the update
        state[i["name"].split(":")[0]] = _fields(os.path.join(CACHE, i["file"]))[1:]
    back = set()
    for i in manifest["packages"]:                               # after going back
        n, v, d, pr = _fields(os.path.join(NEXT, i["file"]))
        state[n] = (v, d, pr)
        back.add(n)
    provides = {}
    for n, (v, d, pr) in state.items():
        for name, _, pv in sum(_deps(pr), []):
            provides.setdefault(name, []).append(pv or v)
    for n, (v, d, pr) in state.items():
        deps = _deps(d)
        if n not in back and not any(a[0] in back for g in deps for a in g):
            continue
        for g in deps:
            ok = False
            for name, op, ver in g:
                if name in state and (not op or _vcmp(state[name][0], op, ver)):
                    ok = True
                elif name in provides and (not op or any(_vcmp(x, op, ver) for x in provides[name])):
                    ok = True
                if ok:
                    break
            if not ok:
                return "after going back, %s would need %s" % (n, " | ".join(
                    "%s%s" % (a[0], " (%s %s)" % (a[1], a[2]) if a[1] else "") for a in g))
    return None


def fetch_plan(inst, opts, held, what=("dist-upgrade",)):
    """Download the archives of a simulated transaction into the cache; each one's SHA-256 from the
    signed indexes is checked. Returns (packages with file/size/hash, MB)."""
    info = archive_info(opts, held, what=what)
    pkgs = []
    for i in inst:
        name = i["name"].split(":")[0]
        arch = i["arch"] or (i["name"].split(":")[1] if ":" in i["name"] else None)
        key = next((k for k in info if k[0] == name and k[1] == i["new"] and (arch is None or k[2] == arch)), None)
        if not key:
            raise Fail("no archive information for %s %s" % (i["name"], i["new"]))
        pkgs.append(dict(i, **info[key]))
    total = sum(p["size"] for p in pkgs) / (1 << 20)
    mb, inodes = free_space(STATE)
    need = 3 * total + 300
    if mb < need or inodes < 5000:
        raise Fail("not enough free space: about %d MB needed, %d MB free" % (need, mb))
    os.makedirs(CACHE + "/partial", exist_ok=True)
    stage_for_apt(CACHE + "/partial")
    for p in pkgs:      # apt reuses a cached file of the right size even when it is damaged
        f = os.path.join(CACHE, p["file"])
        if os.path.exists(f) and not file_ok(f, p["algo"], p["hash"]):
            os.unlink(f)
    run(["apt-get", "-q", "-y", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE] + opts
        + ["--download-only"] + list(what), timeout=3600)
    verify_files(pkgs, CACHE)
    return pkgs, total


def cmd_download():
    with lock():
        if our_marker():
            raise Fail("an update is scheduled: cancel it first")
        chk = read_json(CHECKED) or {}
        if not chk.get("ok") or time.time() - chk.get("time", 0) > CHECK_MAX_AGE:
            raise Fail("check for updates first")
        freeze_lists()
        inst, held, bad = plan_transaction(frozen=True)
        if not inst:
            out({"ok": True, "nothing": True, "new_image_needed": bad})
            return 0
        opts = apt_opts(True, held)
        pkgs, total = fetch_plan(inst, opts, held)
        autos = set(run(["apt-mark", "showauto"], timeout=60).stdout.split())
        plan = {"id": uuid.uuid4().hex[:12], "kind": "update", "created": int(time.time()),
                "packages": pkgs, "handtop_held": held, "new_image_needed": bad,
                "size_mb": round(total, 1),
                # installed as dependencies (or new ones a dist-upgrade pulls in): auto after the install
                "auto": sorted(p["name"] for p in pkgs if p["name"] in autos or not p["old"])}
        rmtree(NEXT)
        if any(is_handtop(p["name"]) or p["name"] in FFMPEG_FAMILY + FFMPEG_DEV for p in pkgs):
            # Plain apt options: the pins of a Debian-only plan must not stop this download.
            manifest = stage_previous(plan["id"], apt_opts(True))
            reason = trial_rollback(plan, manifest)
            plan["rollback"] = {"needed": True, "possible": reason is None, "reason": reason,
                                "no_predecessor": False}
        else:       # Debian's packages only: going back to the kept Handtop release still works
            plan["rollback"] = {"needed": False, "possible": True, "reason": None, "no_predecessor": False}
        write_json(PLAN, plan)
        unlink(SCHEDULE)
        out({"ok": True, "plan": plan["id"], "packages": len(pkgs), "download_mb": round(total, 1),
             "handtop_held": held, "new_image_needed": bad, "rollback": plan["rollback"],
             "warnings": hold_warnings()})
        return 0



# ---- migration: a v0.4.x card (files copied by the image, no Handtop packages) onto packages ------
# handtop-migrate (published with each release) sets up Handtop's key and source, takes this worker
# out of the release's handtop-core package and runs 'migrate' and 'schedule'. The maintenance boot
# installs the packages; afterwards config files the user never changed get the package's version
# and the ones they changed stay (the package's next to them), other changed files are backed up.

def release_data():
    """{release: {path: {variant: (type, value)}}} from releases.tsv."""
    data = {}
    with open(RELEASES) as f:
        for line in f:
            if line.startswith("#") or not line.strip():
                continue
            rel, var, path, typ, val = line.rstrip("\n").split("\t")
            data.setdefault(rel, {}).setdefault(path, {})[var] = (typ, val)
    return data


def card_value(path):
    """(type, sha256 or link target) of a file on this card, as releases.tsv records it; None if absent."""
    try:
        if os.path.islink(path):
            return ("l", os.readlink(path))
        if os.path.isfile(path):
            return ("f", sha256(path))
    except OSError:
        pass
    return None


def _root_files(paths):
    return {p for p in paths if p.startswith("/") and not p.startswith(FAT + "/")}


def identify(data):
    """(release, variant, share of its files that match). The release whose files this card matches
    best, but only when it is clear-cut: almost all of the files only that release has are on the
    card, almost none of the files only the other releases have, and the boot partition's
    rootfix.cpio is one of that release's variants (DDR3 / DDR4). Anything else is refused."""
    scores = []
    for rel, paths in data.items():
        files = _root_files(paths)
        ok = sum(1 for p in files if card_value(p) in paths[p].values())
        scores.append((ok / max(1, len(files)), rel))
    scores.sort(reverse=True)
    share, rel = scores[0] if scores else (0, None)
    if share < 0.9:
        raise Fail("this card doesn't look like Handtop v0.4.x (best match %s, %d%% of its files)"
                   % (rel or "none", 100 * share))
    own = _root_files(data[rel])
    others = set().union(*[_root_files(data[r]) for r in data if r != rel]) if len(data) > 1 else set()
    mine, theirs = own - others, others - own
    have_mine = sum(1 for p in mine if card_value(p)) / max(1, len(mine))
    have_theirs = sum(1 for p in theirs if card_value(p)) / max(1, len(theirs))
    if mine and have_mine < 0.98 or theirs and have_theirs > 0.02:
        raise Fail("this card mixes files of more than one Handtop release (%s's own files: %d%% there; "
                   "other releases' own files: %d%% there), so changed files can't be told apart: "
                   "nothing changed; flash v0.5.0 instead" % (rel, 100 * have_mine, 100 * have_theirs))
    if not os.path.ismount(FAT):
        raise Fail("the boot partition is not mounted (%s)" % FAT)
    have = card_value(FAT + "/rootfix.cpio")
    variants = data[rel].get(FAT + "/rootfix.cpio", {})
    var = next((v for v, tv in variants.items() if tv == have and v != "*"), None)
    if var is None and variants.get("*") != have:
        raise Fail("this card's boot partition (rootfix.cpio) is not %s's: nothing changed; flash v0.5.0 "
                   "instead" % rel)
    return rel, var, share


def identity_files(data, rel, variant):
    abi = data[rel]["@boot-abi"]["*"][1].replace(";", "\n") + "\n"
    model = "model=rg35xx-h\nram=%s\n" % (variant or "unknown")
    return {BOOT_ABI: abi, MODEL: model}


def deb_control(path):
    """(conffiles, {path: md5}) of a package file."""
    import tarfile
    import io
    data = subprocess.run(["dpkg-deb", "--ctrl-tarfile", path], stdout=subprocess.PIPE, check=True,
                          timeout=120).stdout
    conff, sums = set(), {}
    with tarfile.open(fileobj=io.BytesIO(data)) as tf:
        for m in tf.getmembers():
            n = os.path.basename(m.name)
            if n == "conffiles":
                conff = {l.strip() for l in tf.extractfile(m).read().decode().splitlines() if l.strip()}
            elif n == "md5sums":
                for l in tf.extractfile(m).read().decode("utf-8", "replace").splitlines():
                    md5, _, f = l.partition("  ")
                    if f:
                        sums["/" + f.strip()] = md5.strip()
    return conff, sums


def md5(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def adoption(plan, data):
    """What the migration does with each file the plan's Handtop packages ship that is already on
    the card, decided once when the plan is made (a retry uses the same decisions):
    "replace": [path, package md5] config files never changed: the package's copy takes their place;
    "keep": config files the user changed: they stay, the package's copy next to them (.dpkg-dist);
    "backup": [path, sha256] other files the user changed: copied to BACKUP, then replaced."""
    known = data.get(plan["from"]["release"], {})
    res = {"replace": [], "keep": [], "backup": [], "ffmpeg_backup": []}
    owned = None
    for p in plan["packages"]:
        ffmpeg = p["name"] in FFMPEG_FAMILY + FFMPEG_DEV
        if not is_handtop(p["name"]) and not ffmpeg:
            continue
        conff, sums = deb_control(os.path.join(CACHE, p["file"]))
        for path, pkg_md5 in sorted(sums.items()):
            cur = card_value(path)
            if not cur or cur[0] != "f":
                continue
            if ffmpeg:
                # v0.4.x's own FFmpeg build put files no package owns (the ffmpeg binary, headers,
                # BUILDINFO); Handtop's FFmpeg packages replace them: keep a copy of any that differ.
                owned = owned if owned is not None else dpkg_owned()
                if path not in owned and md5(path) != pkg_md5:
                    res["ffmpeg_backup"].append([path, cur[1]])
                continue
            if cur in known.get(path, {}).values():
                if path in conff and md5(path) != pkg_md5:
                    res["replace"].append([path, pkg_md5])
            elif md5(path) != pkg_md5:
                if path in conff:
                    res["keep"].append(path)
                else:
                    res["backup"].append([path, cur[1]])
    return res


def dpkg_owned():
    """Every path some installed package owns (dpkg's file lists)."""
    res = set()
    d = "/var/lib/dpkg/info"
    for f in os.listdir(d):
        if f.endswith(".list"):
            with open(os.path.join(d, f), errors="replace") as fh:
                res.update(l.rstrip("\n") for l in fh)
    return res


def backup(items, log):
    """Copy each changed file to BACKUP before the package replaces it: temporary file, checked
    against the recorded checksum, synced, renamed; owner and mode kept. An existing backup counts
    only when its checksum is the recorded one (an earlier attempt may have been cut mid-copy)."""
    for path, digest in items:
        dst = BACKUP + path
        if os.path.isfile(dst) and sha256(dst) == digest:
            continue
        if not os.path.isfile(path) or sha256(path) != digest:
            raise Fail("%s changed since the download and its backup is missing: run the command again"
                       % path)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".tmp"
        shutil.copy2(path, tmp)
        st = os.stat(path)
        os.chown(tmp, st.st_uid, st.st_gid)
        with open(tmp, "rb") as f:
            os.fsync(f.fileno())
        if sha256(tmp) != digest:
            raise Fail("backup of %s did not verify" % path)
        os.rename(tmp, dst)
        d = os.path.dirname(dst)
        while d.startswith(BACKUP):
            fsync_dir(d)
            d = os.path.dirname(d)
        log("backed up (changed by the user): %s" % path)


def fat_write(name, data, log):
    """Write a file on the boot partition (temp file, sync, rename); only when it is really mounted."""
    if not os.path.ismount(FAT) or not os.access(FAT, os.W_OK):
        log("boot partition not writable: %s not written" % name)
        return False
    write_atomic(os.path.join(FAT, name), data)
    return True


def migrate_boot_files(plan, data, log):
    """recovery.txt where it's missing; v0.4.0's active rg35xxh-input.conf (unchanged by the user)
    becomes the rescue template, the old one kept next to it. A file that can't be written (FAT not
    mounted or read-only) is left pending: boot-check writes it at a later start."""
    notes, pending = [], []
    rel = plan["from"]["release"]
    tpl = lambda n: open(os.path.join(BOOT_TEMPLATES, n), "rb").read()
    if not os.path.exists(FAT + "/recovery.txt"):
        if fat_write("recovery.txt", tpl("recovery.txt"), log):
            notes.append("recovery.txt added to the boot partition")
        else:
            pending.append("recovery.txt")
    known = data.get(rel, {}).get(FAT + "/rg35xxh-input.conf", {})
    cur = card_value(FAT + "/rg35xxh-input.conf")
    new = tpl("rg35xxh-input.conf")
    if cur and cur in known.values() and cur[1] != hashlib.sha256(new).hexdigest():
        done = True
        if rel == "v0.4.0":
            keep = "rg35xxh-input.conf.v0.4.0"
            if not os.path.exists(os.path.join(FAT, keep)):
                done = fat_write(keep, open(FAT + "/rg35xxh-input.conf", "rb").read(), log)
        done = done and fat_write("rg35xxh-input.conf", new, log)
        if done:
            if rel == "v0.4.0":
                notes.append("rg35xxh-input.conf is now the rescue file (all commented out; the old one is "
                             "rg35xxh-input.conf.v0.4.0)")
        else:
            pending.append("rg35xxh-input.conf")
    elif cur and cur not in known.values():
        notes.append("rg35xxh-input.conf was changed by you and stays as it is: its settings override "
                     "the Controls app")
    if pending:
        write_json(BOOT_PENDING, {"release": rel, "files": pending})
        notes.append("not written yet (boot partition not writable): %s; written at a later start"
                     % ", ".join(pending))
    else:
        unlink(BOOT_PENDING)
    return notes


def add_missing_settings(path, log):
    """A settings file the user changed (/etc/rg35xxh/*.conf, KEY=value, read by sh) stays as it is;
    settings the release added since (v0.4.0's power.conf has no MUSIC_SCREEN_OFF_MINUTES, which then
    reads as 0) are appended with Handtop's default from the package's copy next to it. A key the
    file sets in any form (also "export KEY=", or commented out: the user's choice) is left alone."""
    new = path + ".dpkg-dist"
    if not (path.startswith("/etc/rg35xxh/") and path.endswith(".conf") and os.path.isfile(new)):
        return
    key = re.compile(r"^\s*(?:#\s*)?(?:export\s+)?([A-Z][A-Z0-9_]*)=")
    text = open(path, errors="replace").read()
    have = {m.group(1) for m in map(key.match, text.splitlines()) if m}
    add, seen = [], set()
    for line in open(new, errors="replace").read().splitlines():
        m = key.match(line)
        if m and not line.lstrip().startswith("#") and m.group(1) not in have | seen:
            add.append(line)
            seen.add(m.group(1))
    if not add:
        return
    if text and not text.endswith("\n"):
        text += "\n"
    text += ("# Added when this card moved onto packages (Handtop's defaults; your settings above are kept):\n"
             + "\n".join(add) + "\n")
    st = os.stat(path)
    write_atomic(path, text, stat.S_IMODE(st.st_mode))
    os.chown(path, st.st_uid, st.st_gid)
    log("%s: added %s" % (path, ", ".join(a.split("=")[0].strip() for a in add)))


def install_migrate(plan, log, budget):
    data = release_data()
    # Before any change: the boot partition is there and still has the kernel the plan was made for.
    if not os.path.ismount(FAT):
        raise Fail("the boot partition is not mounted: nothing changed; run the command again")
    if plan.get("kernel_sha256") and card_value(FAT + "/KERNEL") != ("f", plan["kernel_sha256"]):
        raise Fail("this card's kernel changed since the download: nothing changed; flash the new image")
    opts = apt_opts(True)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    plan_ad = plan.get("adoption") or adoption(plan, data)
    backup(plan_ad["backup"] + plan_ad.get("ffmpeg_backup", []), log)
    # Before the packages: the modules package's preinst checks /etc/handtop/boot-abi (the card's
    # KERNEL was matched against this release's when the plan was made).
    for path, text in identity_files(data, plan["from"]["release"], plan["from"]["variant"]).items():
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            write_atomic(path, text.encode())
    # Units the card has already count as enabled once: the packages' postinst then leaves the
    # user's choice alone (a unit they disabled stays disabled); only units new to the card get enabled.
    units = "/etc/systemd/system"
    present = {f for f in os.listdir(units) if f.endswith((".service", ".timer"))
               and os.path.isfile(os.path.join(units, f))}
    seen = set(open(UNITS_SEEN).read().split()) if os.path.isfile(UNITS_SEEN) else set()
    if present - seen:
        os.makedirs(os.path.dirname(UNITS_SEEN), exist_ok=True)
        write_atomic(UNITS_SEEN, "".join(u + "\n" for u in sorted(seen | present)))
    check_against_plan(plan, opts)
    run(["apt-get", "-q", "-y", "--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE]
        + opts + ["install"] + plan_targets(plan), timeout=budget(3600), log=log)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log)
    if plan.get("auto"):
        run(["apt-mark", "auto"] + plan["auto"], timeout=120, log=log)
    have = installed()
    wrong = [p["name"] for p in plan["packages"] if have.get(p["name"]) != p["new"]]
    if wrong:
        raise Fail("not at the planned version afterwards: %s" % ", ".join(wrong))
    # The packaged units skip the maintenance boot themselves: handtop-migrate's drop-ins can go.
    for u in MIGRATE_DROPINS:
        unlink("%s/%s.d/%s" % (units, u, DROPIN_NAME))
    # dpkg kept the card's copy of each config file (--force-confold) and wrote the package's next to
    # it: where the card's copy was the old release's, the package's takes its place.
    for path, pkg_md5 in plan_ad["replace"]:
        for ext in (".dpkg-dist", ".dpkg-new"):
            if os.path.isfile(path + ext) and md5(path + ext) == pkg_md5:
                os.replace(path + ext, path)
                log("config file from the package: %s" % path)
                break
    for path in plan_ad["keep"]:
        add_missing_settings(path, log)
    unlink(MIGRATE_HOLDS)                # the released v0.4.x holds stay released
    unlink(NO_PREDECESSOR)
    return migrate_boot_files(plan, data, log) + (
        ["%d changed file(s) backed up in %s" % (len(plan_ad["backup"]), BACKUP)] if plan_ad["backup"] else [])


def cmd_migrate():
    with lock():
        if our_marker():
            raise Fail("an update is scheduled: cancel it first")
        if (read_json(PLAN) or {}).get("kind") == "migrate":
            raise Fail("a move onto packages is already downloaded: schedule it again to resume it")
        have = installed()
        if any(is_handtop(n) for n in have):
            raise Fail("this card has Handtop's packages already: use the Update app")
        data = release_data()
        rel, var, share = identify(data)
        ids = identity_files(data, rel, var)
        ksha = re.search(r"^kernel_sha256=(\S+)$", ids[BOOT_ABI], re.M).group(1)
        if card_value(FAT + "/KERNEL") != ("f", ksha):
            raise Fail("this card's kernel is not %s's: flash the new image instead" % rel)
        p = run(["apt-get", "update", "-q", "--error-on=any"], timeout=600, check=False)
        if p.returncode != 0:
            raise Fail("could not refresh every package list: %s" % "; ".join(
                l for l in p.stdout.splitlines() if l.startswith(("E:", "Err:")))[-600:])
        release_legacy_holds()               # after the refresh: the pin is checked against today's lists
        warnings = hold_warnings()
        write_json(CHECKED, {"ok": True, "time": int(time.time())})
        freeze_lists()
        opts = apt_opts(True)
        what = ("install",) + MIGRATE_TARGETS
        inst = simulate(opts, what=what)
        if not any(i["name"] == "handtop" for i in inst):
            raise Fail("Handtop's packages are not in the package lists (is Handtop's source set up?)")
        bad = modules_mismatch(inst, opts, want=ksha)
        if bad:
            raise Fail("the release's kernel modules don't fit this card's kernel (%s): flash the new image"
                       % ", ".join(bad))
        pkgs, total = fetch_plan(inst, opts, False, what=what)
        autos = set(run(["apt-mark", "showauto"], timeout=60).stdout.split())
        plan = {"id": uuid.uuid4().hex[:12], "kind": "migrate", "created": int(time.time()),
                "packages": pkgs, "handtop_held": False, "new_image_needed": [], "size_mb": round(total, 1),
                "from": {"release": rel, "variant": var, "match": round(100 * share)},
                "kernel_sha256": ksha,
                # the two targets stay manually installed; new dependencies and upgraded auto ones are auto
                "auto": sorted(p["name"] for p in pkgs if p["name"] not in MIGRATE_TARGETS
                               and (p["name"] in autos or not p["old"])),
                # nothing packaged to go back to: the release before is the image's copied files
                "rollback": {"needed": False, "possible": True, "reason": None, "no_predecessor": True}}
        ad = plan["adoption"] = adoption(plan, data)
        write_json(PLAN, plan)
        unlink(SCHEDULE)
        rmtree(NEXT)
        out({"ok": True, "plan": plan["id"], "from": plan["from"], "packages": len(pkgs),
             "core": next((p["new"] for p in pkgs if p["name"] == "handtop-core"), None),
             "download_mb": round(total, 1), "warnings": warnings,
             "config_kept": ad["keep"], "config_replaced": len(ad["replace"]),
             "backed_up": [b[0] for b in ad["backup"]], "ffmpeg_backed_up": len(ad["ffmpeg_backup"])})
        return 0


# ---- schedule / cancel / channel / status ---------------------------------------------------------

def cmd_schedule(after="restart"):
    if after not in ("restart", "poweroff"):
        raise Fail("schedule: restart or poweroff")
    with lock():
        plan = read_json(PLAN)
        if not plan or plan.get("kind") not in ("update", "migrate"):
            raise Fail("nothing downloaded")
        mk = our_marker()
        if mk is False:
            raise Fail("another offline update is scheduled (/system-update); not touching it")
        sched = read_json(SCHEDULE) or {}
        if mk and sched.get("plan") == plan["id"]:
            if sched.get("after") != after:
                write_json(SCHEDULE, dict(sched, after=after))
            out({"ok": True, "restart": True, "after": after, "plan": plan["id"]})
            return 0
        if not plan["rollback"]["possible"] and not plan["rollback"]["no_predecessor"]:
            raise Fail("going back would not be possible: %s" % plan["rollback"]["reason"])
        verify_files(plan["packages"], CACHE)
        check_kept_release(plan)
        mb, _ = free_space(STATE)
        if mb < 2 * plan["size_mb"] + 200:
            raise Fail("not enough free space to install: %d MB free" % mb)
        why = power_ok(MIN_BATTERY)
        if why:
            raise Fail("%s: connect the charger or charge to %d%% first" % (why, MIN_BATTERY))
        active = controller_mode_active()
        if active:
            raise Fail("a controller mode is running (%s): end it first" % active)
        en = subprocess.run(["systemctl", "is-enabled", APPLY_UNIT], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, timeout=15).stdout.strip()
        if en != "enabled":
            raise Fail("%s is not enabled (%s): the update could not be installed" % (APPLY_UNIT, en or "?"))
        write_json(SCHEDULE, {"plan": plan["id"], "after": after, "attempts": 0, "deferrals": 0,
                              "at": int(time.time())})
        set_marker()
        out({"ok": True, "restart": True, "after": after, "plan": plan["id"]})
        return 0


def forget_plan():
    remove_marker()
    for p in (PLAN, SCHEDULE):
        unlink(p)
    for d in (CACHE, LISTS, PREFS, NEXT):
        rmtree(d)


def cmd_cancel():
    with lock():
        if our_marker() is False:
            raise Fail("the scheduled offline update is not Handtop's; not touching it")
        migrating = (read_json(PLAN) or {}).get("kind") == "migrate"
        forget_plan()
        if migrating or os.path.exists(MIGRATE_HOLDS):
            restore_legacy_holds()
        out({"ok": True})
        return 0


def cmd_channel(which=None):
    """testing: an extra source for trixie-testing in a file of its own (handtop.sources stays
    untouched). Switching cancels a downloaded or scheduled update."""
    if which not in ("stable", "testing"):
        raise Fail("channel: stable or testing")
    with lock():
        if our_marker() is False:
            raise Fail("another offline update is scheduled (/system-update)")
        cancelled = os.path.exists(PLAN)
        forget_plan()
        unlink(CHECKED)
        if which == "testing":
            write_atomic(CHANNEL_SOURCES, TESTING_STANZA)
        else:
            unlink(CHANNEL_SOURCES)
        out({"ok": True, "channel": which, "cancelled_update": cancelled})
        return 0


def joypad_override_active():
    k = boot_abi().get("kernel") or os.uname().release
    return os.path.exists("/usr/lib/modules/%s/updates/handtop-recovery/rocknix-singleadc-joypad.ko" % k)


def cmd_status():
    plan = read_json(PLAN)
    sched = read_json(SCHEDULE) or {}
    prev = read_json(PREVIOUS + "/manifest.json")
    out({"downloaded": bool(plan), "kind": plan.get("kind") if plan else None,
         "plan": plan.get("id") if plan else None, "packages": len(plan["packages"]) if plan else 0,
         "rollback": plan.get("rollback") if plan else None,
         "scheduled": bool(our_marker()) and sched.get("plan") == (plan or {}).get("id"),
         "after": sched.get("after") if our_marker() else None,
         "foreign_offline_update": our_marker() is False,
         # The kept release counts only when it isn't the installed one (after handtop=previous it is).
         "previous_release": prev.get("release") if prev and prev.get("complete")
         and prev.get("release") != installed().get("handtop") else None,
         "last_result": read_json(RESULT), "joypad_override": joypad_override_active(),
         "channel": "testing" if os.path.exists(CHANNEL_SOURCES) else "stable",
         "reboot_required": os.path.exists("/run/reboot-required")})
    return 0


# ---- the release kept for going back ----------------------------------------------------------------

def repair_previous():
    """Finish promote_previous() after a cut: previous -> previous.old, previous.next -> previous."""
    if not os.path.isdir(PREVIOUS):
        if os.path.isdir(NEXT) and os.path.isdir(OLD):
            os.rename(NEXT, PREVIOUS)
        elif os.path.isdir(OLD):
            os.rename(OLD, PREVIOUS)
    if os.path.isdir(PREVIOUS) and os.path.isdir(OLD):
        rmtree(OLD)
    fsync_dir(STATE)


def check_kept_release(plan):
    """An update that changes Handtop needs the release it replaces kept for going back: staged for
    this plan (previous.next), or already promoted for it (a resumed install), complete, every file
    as downloaded. Checked when scheduling and again right before the install starts."""
    if plan.get("kind") != "update" or not plan.get("rollback", {}).get("needed"):
        return
    for where in (NEXT, PREVIOUS):
        m = read_json(where + "/manifest.json")
        if m and m.get("for_plan") == plan["id"]:
            if not m.get("complete"):
                raise Fail("the release kept for going back is incomplete (%s): download again"
                           % ", ".join(m.get("missing") or []))
            verify_files(m["packages"], where)
            return
    raise Fail("the release kept for going back is missing: download again")


def promote_previous(plan_id):
    m = read_json(NEXT + "/manifest.json")
    if not m or m.get("for_plan") != plan_id:
        return
    if os.path.isdir(PREVIOUS):
        rmtree(OLD)
        os.rename(PREVIOUS, OLD)
    os.rename(NEXT, PREVIOUS)
    fsync_dir(STATE)
    rmtree(OLD)


# ---- maintenance boot -----------------------------------------------------------------------------

def policy_rc(on):
    """A policy-rc.d denying service starts for the maintenance boot; an administrator's own is set
    aside and put back. boot-check cleans up after a killed run."""
    if on:
        if os.path.lexists(POLICY_RC) and not ours_policy():
            os.rename(POLICY_RC, POLICY_SAVED)
        write_atomic(POLICY_RC, POLICY_BODY, 0o755)
    else:
        if ours_policy():
            os.unlink(POLICY_RC)
        if os.path.lexists(POLICY_SAVED) and not os.path.lexists(POLICY_RC):
            os.rename(POLICY_SAVED, POLICY_RC)


def ours_policy():
    try:
        with open(POLICY_RC) as f:
            return f.read() == POLICY_BODY
    except OSError:
        return False


class Budget:
    def __init__(self, seconds):
        self.end = time.time() + seconds

    def __call__(self, want):
        left = self.end - time.time() - 120
        if left < 60:
            raise Fail("out of time for this maintenance boot")
        return min(want, left)


def plan_targets(plan):
    return ["%s=%s" % (p["name"], p["new"]) for p in plan["packages"]]


def check_against_plan(plan, opts):
    """What apt would do now must be (part of) the plan: same packages, same versions, no removals.
    The plan's versions are named explicitly: after a power cut that is what lets apt repair the
    half-installed set (a plain dist-upgrade refuses to start then)."""
    inst = simulate(opts, ["--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE],
                    ["install"] + plan_targets(plan))
    want = {(p["name"], p["new"]) for p in plan["packages"]}
    extra = ["%s %s" % (i["name"], i["new"]) for i in inst if (i["name"], i["new"]) not in want]
    if extra:
        raise Drift("this card changed since the download (%s); download the update again" % ", ".join(extra))


def install_update(plan, log, budget):
    opts = apt_opts(True, plan.get("handtop_held"))
    if any(p["name"].startswith("handtop-modules-") for p in plan["packages"]):
        # Before any change: the kernel on the boot partition is still the one boot-abi names.
        want = boot_abi().get("kernel_sha256")
        if not os.path.ismount(FAT) or not want or card_value(FAT + "/KERNEL") != ("f", want):
            raise Fail("the boot partition's kernel can't be checked or isn't the one %s names: "
                       "nothing changed" % BOOT_ABI)
    # After a power cut, packages unpacked at the new version may wait for siblings still at the old
    # one: this pass then fails, and the install below completes the set.
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    check_against_plan(plan, opts)
    run(["apt-get", "-q", "-y", "--no-download", "--no-remove", "-o", "Dir::Cache::archives=" + CACHE]
        + opts + ["install"] + plan_targets(plan), timeout=budget(3600), log=log)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log)
    # Naming packages makes apt mark them manually installed: give back the marks of the plan
    # (dependencies stay removable by autoremove).
    if plan.get("auto"):
        run(["apt-mark", "auto"] + plan["auto"], timeout=120, log=log)
    have = installed()
    wrong = [p["name"] for p in plan["packages"] if have.get(p["name"]) != p["new"]]
    if wrong:
        raise Fail("not at the planned version afterwards: %s" % ", ".join(wrong))


def install_recovery(plan, log, budget):
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log, check=False)
    files = [os.path.join(PREVIOUS, p["file"]) for p in plan["packages"]]
    if files:
        run(["dpkg"] + CONF + ["-i"] + files, timeout=budget(3600), log=log)
    if plan.get("remove"):
        run(["dpkg", "--remove"] + plan["remove"], timeout=budget(1200), log=log)
    run(["dpkg"] + CONF + ["--configure", "-a"], timeout=budget(1200), log=log)
    have = installed()
    wrong = [p["name"] for p in plan["packages"] if have.get(p["name"]) != p["version"]]
    wrong += [n for n in plan.get("remove", []) if n in have]
    if wrong:
        raise Fail("not as planned afterwards: %s" % ", ".join(wrong))


def power(action):
    """Request a restart or power-off; if systemd refuses, force it (everything is synced)."""
    if NO_POWER_ACTION:
        print("handtop-update: would %s now" % action, flush=True)
        return
    try:
        subprocess.run(["sync"], timeout=120)
    except subprocess.SubprocessError:
        pass
    try:
        # Queued while the unit still runs, so the shutdown cancels system-update-cleanup.service.
        if subprocess.run(["systemctl", action, "--no-block"], timeout=60).returncode == 0:
            return
    except subprocess.SubprocessError:
        pass
    subprocess.run(["systemctl", "--force", "--force", action], timeout=60)


def finish(plan, ok, message, log, resume=False, extra=None):
    """Result first (synced), then the FAT copy, then the plan's files and the marker, then the
    restart / power-off. A cut anywhere repeats only these steps (apply() sees the result)."""
    policy_rc(False)
    sched = read_json(SCHEDULE) or {}
    action = "poweroff" if resume or sched.get("after") == "poweroff" else "reboot"
    res = dict(extra or {}, plan=(plan or {}).get("id"), ok=ok, message=message, time=int(time.time()),
               log=log.path, action=action, final=not resume)
    write_json(RESULT, res)
    console(message)
    log(message)
    log.sync()
    copy_log_to_fat(log.path, "update")
    if not resume:
        # A failed migration keeps its plan (lists, downloads, decisions): the same command resumes it.
        complete(ok, keep_plan=not ok and (plan or {}).get("kind") == "migrate")
    power(action)


def complete(ok, keep_plan=False):
    remove_marker()
    for p in (SCHEDULE, INPROGRESS) + (() if keep_plan else (PLAN,)):
        unlink(p)
    if not keep_plan:
        for d in (LISTS, PREFS, NEXT) + ((CACHE,) if ok else ()):
            rmtree(d)
    fsync_dir(STATE)


def kept_config(since):
    """Config files dpkg kept because they were edited: the package's version sits next to them
    (.dpkg-dist), written by this install."""
    res = []
    for top, dirs, files in os.walk("/etc"):
        for f in files:
            if f.endswith((".dpkg-dist", ".dpkg-new")):
                p = os.path.join(top, f)
                try:
                    # ctime: dpkg gives the file the package's modification time, not the install's
                    if os.lstat(p).st_ctime >= since - 1:
                        res.append(p)
                except OSError:
                    pass
    return sorted(res)[:50]


def cmd_apply():
    if not our_marker():
        return 0                      # no marker, or another updater's: not ours to act on
    log = Log("update")
    with lock(wait=60):
        plan, sched, res = read_json(PLAN), read_json(SCHEDULE), read_json(RESULT) or {}
        try:
            repair_previous()
            # A result for this plan written during this schedule: a cut came after it. Finish only.
            # (An older result for the same plan, e.g. an interruption before it was scheduled again, is not.)
            if (res.get("final") and plan and res.get("plan") == plan.get("id") and sched
                    and res.get("time", 0) >= sched.get("at", 0)):
                log("the result was recorded before a cut: finishing")       # idempotent end
                copy_log_to_fat(log.path, "update")
                complete(res.get("ok"), keep_plan=not res.get("ok") and plan.get("kind") == "migrate")
                power(res.get("action", "reboot"))
                return 0
            if not plan or not sched or sched.get("plan") != plan.get("id"):
                finish(plan, False, "no matching downloaded update found; starting normally", log)
                return 1
            attempts = sched.get("attempts")
            if not isinstance(attempts, int) or attempts >= MAX_ATTEMPTS:
                finish(plan, False, "update stopped after %s attempts; recovery.txt can go back" % attempts, log)
                return 1
            for _ in range(20):        # the fuel gauge can take a moment after power-on
                why = power_ok(STOP_BATTERY)
                if not why or "can't be read" not in why:
                    break
                time.sleep(1)
            if why:
                deferrals = sched.get("deferrals", 0) + 1
                if deferrals >= MAX_DEFERRALS:
                    finish(plan, False, "update cancelled: %s at %d starts in a row" % (why, MAX_DEFERRALS), log)
                    return 1
                write_json(SCHEDULE, dict(sched, deferrals=deferrals))
                finish(plan, None, "%s: switching off. Charge, then switch on: the update continues." % why,
                       log, resume=True)
                return 1
            write_json(SCHEDULE, dict(sched, attempts=attempts + 1, deferrals=0))
            prog_start = int(time.time())
            write_json(INPROGRESS, {"plan": plan["id"], "attempt": attempts + 1, "started": prog_start})
            budget = Budget(APPLY_BUDGET)
            try:
                if plan["kind"] in ("update", "migrate"):
                    verify_files(plan["packages"], CACHE)
                    mb, _ = free_space(STATE)
                    if mb < plan.get("size_mb", 0) + 150:
                        raise Fail("not enough free space to install (%d MB free)" % mb)
                    if plan["kind"] == "update":
                        check_kept_release(plan)
                        promote_previous(plan["id"])
                else:
                    verify_files(plan["packages"], PREVIOUS)
            except Fail as e:
                finish(plan, False, "update not installed: %s" % e, log)
                return 1
            console("%s. Do not switch off (attempt %d of %d)." % (
                "Going back to the previous Handtop release" if plan["kind"] == "recovery"
                else "Moving Handtop %s onto packages (%d to install)" % (plan["from"]["release"], len(plan["packages"]))
                if plan["kind"] == "migrate"
                else "Installing %d updates" % len(plan["packages"]), attempts + 1, MAX_ATTEMPTS))
            log("attempt %d of %d" % (attempts + 1, MAX_ATTEMPTS))
            log("plan: %s" % json.dumps(plan))
            log.sync()
            policy_rc(True)
            error, notes = None, []
            installer = {"update": install_update, "recovery": install_recovery, "migrate": install_migrate}
            for _ in range(2):                    # one retry in place
                try:
                    notes = installer[plan["kind"]](plan, log, budget) or []
                    error = None
                    break
                except Drift as e:
                    error = e
                    break
                except (Fail, OSError, subprocess.SubprocessError) as e:
                    error = e
                    log("FAILED: %s" % e)
            if error:
                finish(plan, False, "update failed: %s" % error, log)
                return 1
            extra = {"kept_config": kept_config(prog_start), "notes": notes}
            if plan["kind"] == "migrate":
                extra["migrated_from"] = plan["from"]["release"]
            if plan["kind"] == "update":
                manifest = read_json(PREVIOUS + "/manifest.json")
                if manifest and manifest.get("for_plan") == plan["id"]:
                    extra["rollback_available"] = manifest.get("complete", False)
            finish(plan, True, ("back to the previous Handtop release; " if plan["kind"] == "recovery"
                                else "Handtop moved onto packages (updates from now on); "
                                if plan["kind"] == "migrate" else "update installed; ") + (
                "switching off" if (read_json(SCHEDULE) or {}).get("after") == "poweroff" else "restarting"),
                log, extra=extra)
            return 0
        except Exception as e:               # noqa: BLE001 - always end with a result and a restart
            log("INTERNAL ERROR: %r" % e)
            finish(plan, False, "update failed (internal error: %s)" % e, log)
            return 1


# ---- normal boot --------------------------------------------------------------------------------

def self_test_ok(path):
    try:
        return subprocess.run([path, "--self-test"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def cmd_boot_check():
    """Every normal boot: report a maintenance boot that was stopped (time-out, crash), remove its
    service blocker, finish a cut promotion of the kept release, keep working copies of the tools."""
    log = None
    with lock(wait=60):
        repair_previous()
        prog = read_json(INPROGRESS)
        res = read_json(RESULT) or {}
        if prog and not our_marker() and res.get("final") and res.get("plan") == prog.get("plan") \
                and res.get("time", 0) >= prog.get("started", 0):
            unlink(INPROGRESS)        # the result was written, then a cut: keep it (and the plan's cleanup)
            if res.get("ok") or (read_json(PLAN) or {}).get("kind") != "migrate":
                complete(res.get("ok"))
            prog = None
        if prog and not our_marker():
            log = Log("update")
            audit = run(["dpkg", "--audit"], timeout=300, check=False).stdout.strip()
            msg = ("the maintenance boot was stopped before the update finished (time-out or crash)%s"
                   % ("; some packages need repair: run the update again or use recovery.txt" if audit else ""))
            write_json(RESULT, {"plan": prog.get("plan"), "ok": False, "message": msg, "time": int(time.time()),
                                "log": log.path, "interrupted": True, "final": True, "dpkg_audit": audit[-2000:]})
            log(msg + ("\n" + audit if audit else ""))
            unlink(INPROGRESS)
            copy_log_to_fat(log.path, "update")
        pend = read_json(BOOT_PENDING)
        if pend and not our_marker() and os.path.ismount(FAT) and os.access(FAT, os.W_OK):
            log = log or Log("update")
            notes = migrate_boot_files({"from": {"release": pend.get("release")}}, release_data(), log)
            log("boot partition files: %s" % "; ".join(notes))
        if not our_marker():
            policy_rc(False)
        os.makedirs(LKG, exist_ok=True)
        for tool in ("handtop-update", "handtop-recovery"):
            cur = "/usr/local/sbin/" + tool
            keep = os.path.join(LKG, tool)
            if os.path.isfile(cur) and self_test_ok(cur):
                if not os.path.isfile(keep) or sha256(keep) != sha256(cur):
                    shutil.copy2(cur, keep + ".new")
                    os.chmod(keep + ".new", 0o755)
                    os.rename(keep + ".new", keep)
        fsync_dir(LKG)
    return 0


def self_test():
    inst, rem = parse_sim("Inst a [1] (2 Handtop:trixie-stable [arm64])\nPurg b\n")
    assert inst[0]["new"] == "2" and inst[0]["arch"] == "arm64" and rem == ["b"]
    assert _deps("a (>= 1), b | c:any")[1][1][0] == "c"
    return 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    cmds = {"status": cmd_status, "check": cmd_check, "download": cmd_download, "schedule": cmd_schedule,
            "migrate": cmd_migrate,
            "cancel": cmd_cancel, "apply": cmd_apply, "boot-check": cmd_boot_check, "channel": cmd_channel}
    args = sys.argv[2:]
    if len(sys.argv) < 2 or sys.argv[1] not in cmds or len(args) > (1 if sys.argv[1] in ("schedule", "channel") else 0):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("handtop-update: run as root (the Update app uses sudo)", file=sys.stderr)
        return 2
    os.makedirs(STATE, mode=0o755, exist_ok=True)
    try:
        return cmds[sys.argv[1]](*args)
    except Fail as e:
        out({"ok": False, "error": str(e)})
        return 1
    except subprocess.TimeoutExpired as e:
        out({"ok": False, "error": "timed out: %s" % " ".join(e.cmd[:2])})
        return 1
    except Exception as e:                   # noqa: BLE001 - the app always gets JSON
        out({"ok": False, "error": "internal error: %r" % e})
        return 1


if __name__ == "__main__":
    sys.exit(main())
