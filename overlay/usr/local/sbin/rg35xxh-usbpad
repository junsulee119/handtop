#!/usr/bin/python3
"""Handtop wired controller mode: the handheld becomes a wired Xbox 360 controller for a PC
(or, with --switch, a wired Nintendo Switch controller).

USB device mode exists only on the right USB-C port (OTG2/DC; the H700's single device-capable
controller, MUSB). The left port (OTG1) is host-only. The handheld charges from the PC meanwhile.

How: a USB gadget (configfs) with VID/PID 045e:028e and a vendor interface (class ff/5d/01, the
Xbox 360 0x21 descriptor, interrupt IN 0x81 + OUT 0x01) served through FunctionFS. The 0x21
descriptor is refused by the kernel's built-in FunctionFS, so this uses usb_f_fs_xinput.ko, a
renamed copy that accepts it (build/06c-ffs-xinput.sh). Windows then binds its built-in Xbox 360
driver: XInput games work as with a real wired pad, at ~1000 reports/s.

Input comes from the input daemon over /run/rg35xxh-extpad.sock (one evdev event per packet,
struct "<HHi"), exactly as for rg35xxh-btpad; vibration requested by the PC (OUT report
00 08 00 <big> <small>) is sent back to it as b"rumble <big> <small>" for the handheld's motor.
Status for the screen: JSON lines on /run/rg35xxh-extpad-status.sock (same format as btpad).
Started by the External Controller app as rg35xxh-usbpad.service; stops when the input daemon
disconnects (Select + Start + L1 + R1) or never connects (60 s); removes the gadget on exit.

--switch (rg35xxh-switchpad.service): a wired Nintendo Switch controller instead. The gadget poses
as HORI's licensed wired pad (Pokken Tournament DX Pro Pad, 0f0d:0092), which the Switch accepts
without a handshake: one HID interface, an 8-byte input report (14 buttons incl. Home / Capture,
hat, 4 stick axes), sent at least every 8 ms. No vibration (the pad has none). The HID class
requests (report descriptor, idle, get/set report) are answered here on ep0. Buttons by label:
the handheld's A/B/X/Y are printed where the Switch has them. Home / Capture come from the input
daemon (F tap / hold, F + Select).
"""
import grp
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

from evdev import ecodes as E
from gi.repository import GLib

G = "/sys/kernel/config/usb_gadget/handtop-pad"
FUNC = "ffsxi.pad"
FFS = "/run/rg35xxh-ffs-pad"
SOCKET = "/run/rg35xxh-extpad.sock"
STATUS_SOCKET = "/run/rg35xxh-extpad-status.sock"
EVENT = struct.Struct("<HHi")
SWITCH = "--switch" in sys.argv[1:]
HOST_NAME = "Switch or PC (USB)" if SWITCH else "PC (USB)"   # it can't tell which
TRANSPORT = "switch" if SWITCH else "usb"

# Xbox 360 wButtons bits
X_BITS = {E.BTN_START: 4, E.BTN_SELECT: 5, E.BTN_THUMBL: 6, E.BTN_THUMBR: 7, E.BTN_TL: 8, E.BTN_TR: 9,
          E.BTN_MODE: 10, E.BTN_A: 12, E.BTN_B: 13, E.BTN_X: 14, E.BTN_Y: 15}
# status-screen report (same 9-byte layout as rg35xxh-btpad's HID report)
S_BITS = {E.BTN_A: 0, E.BTN_B: 1, E.BTN_X: 2, E.BTN_Y: 3, E.BTN_TL: 4, E.BTN_TR: 5,
          E.BTN_SELECT: 6, E.BTN_START: 7, E.BTN_THUMBL: 8, E.BTN_THUMBR: 9, E.BTN_MODE: 10}
HAT = {(0, -1): 0, (1, -1): 1, (1, 0): 2, (1, 1): 3, (0, 1): 4, (-1, 1): 5, (-1, 0): 6, (-1, -1): 7}

# Switch (HORI pad) button bits. The daemon sends Xbox-position codes (core.PAD_BUTTONS): BTN_A =
# bottom, BTN_B = right, BTN_X = left, BTN_Y = top. The Switch's B is bottom, A right, Y left, X top.
SW_BITS = {E.BTN_X: 0, E.BTN_A: 1, E.BTN_B: 2, E.BTN_Y: 3, E.BTN_TL: 4, E.BTN_TR: 5,
           E.BTN_SELECT: 8, E.BTN_START: 9, E.BTN_THUMBL: 10, E.BTN_THUMBR: 11,
           E.BTN_MODE: 12, E.KEY_RECORD: 13}               # ZL = bit 6, ZR = bit 7 (from ABS_Z / ABS_RZ)
SW_KEEPALIVE = 0.008       # resend the current report at least this often (s); a real pad streams
# HID report descriptor of the HORI Pokken pad (86 bytes): 16 buttons, hat (4 bits + 4 padding),
# X Y Z Rz (left X/Y, right X/Y; 0-255, centre 128), 1 vendor byte; 8-byte vendor output report.
SW_REPORT_DESC = bytes.fromhex(
    "05 01 09 05 a1 01"                                 # Generic Desktop, Game Pad, Collection
    "15 00 25 01 35 00 45 01 75 01 95 10"               # 16 x 1 bit
    "05 09 19 01 29 10 81 02"                           # buttons 1-16
    "05 01 25 07 46 3b 01 75 04 95 01 65 14 09 39 81 42"   # hat 0-7, null = centre
    "65 00 95 01 81 01"                                 # 4 bits padding
    "26 ff 00 46 ff 00 09 30 09 31 09 32 09 35 75 08 95 04 81 02"   # X Y Z Rz, 8 bit
    "06 00 ff 09 20 95 01 81 02"                        # vendor byte
    "0a 21 26 95 08 91 02"                              # 8-byte output report
    "c0")
SW_HID_DESC = bytes([9, 0x21, 0x11, 0x01, 0x00, 1, 0x22]) + struct.pack("<H", len(SW_REPORT_DESC))


def log(*a):
    print("rg35xxh-usbpad:", *a, flush=True)


def w(path, val):
    with open(path, "w") as f:
        f.write(val)


def unix_server(path, kind):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, kind)
    srv.bind(path)
    try:
        os.chown(path, 0, grp.getgrnam("input").gr_gid)       # the desktop user is in "input"
    except KeyError:
        pass
    os.chmod(path, 0o660)
    srv.listen(4)
    return srv


# ------------------------------------------------------------------ USB gadget
def descriptors():
    if SWITCH:
        intf = bytes([9, 4, 0, 0, 2, 0x03, 0x00, 0x00, 0])            # HID, no boot protocol
        ep_in = bytes([7, 5, 0x81, 3]) + struct.pack("<H", 64) + bytes([5])
        ep_out = bytes([7, 5, 0x01, 3]) + struct.pack("<H", 64) + bytes([5])
        fs = intf + SW_HID_DESC + ep_in + ep_out
        hs = intf + SW_HID_DESC + ep_in[:6] + bytes([4]) + ep_out[:6] + bytes([4])  # 1 ms at high speed
        body = struct.pack("<II", 4, 4) + fs + hs
        return struct.pack("<III", 3, 12 + len(body), 1 | 2) + body
    intf = bytes([9, 4, 0, 0, 2, 0xFF, 0x5D, 0x01, 0])
    xdesc = bytes([0x11, 0x21, 0x00, 0x01, 0x01, 0x25, 0x81, 0x14, 0, 0, 0, 0, 0x13, 0x01, 0x08, 0, 0])
    ep_in = bytes([7, 5, 0x81, 3]) + struct.pack("<H", 32) + bytes([4])
    ep_out = bytes([7, 5, 0x01, 3]) + struct.pack("<H", 32) + bytes([8])
    one = intf + xdesc + ep_in + ep_out          # endpoint numbers as assigned by the MUSB controller
    body = struct.pack("<II", 4, 4) + one + one   # full- and high-speed
    return struct.pack("<III", 3, 12 + len(body), 1 | 2) + body   # FUNCTIONFS_DESCRIPTORS_MAGIC_V2


def gadget_clean():
    """Remove this gadget and its FunctionFS mount if present (also leftovers of an earlier run)."""
    if os.path.exists(f"{G}/UDC"):
        try:
            w(f"{G}/UDC", "")
        except OSError:
            pass
    for _ in range(10):
        if subprocess.run(["mountpoint", "-q", FFS], stderr=subprocess.DEVNULL).returncode:
            break
        subprocess.run(["umount", FFS], stderr=subprocess.DEVNULL)
        time.sleep(0.2)
    else:
        subprocess.run(["umount", "-l", FFS])      # still busy (a blocked thread): detach it
    if os.path.islink(f"{G}/configs/c.1/{FUNC}"):
        os.unlink(f"{G}/configs/c.1/{FUNC}")
    for d in (f"{G}/configs/c.1/strings/0x409", f"{G}/configs/c.1", f"{G}/functions/{FUNC}",
              f"{G}/strings/0x409", G, FFS):
        try:
            os.rmdir(d)
        except OSError:
            pass


def gadget_up():
    gadget_clean()
    subprocess.run(["modprobe", "usb_f_fs_xinput"], check=True)
    os.makedirs(G, exist_ok=True)
    if SWITCH:      # HORI Pokken pad; class at interface level, like the real one
        ids = (("idVendor", "0x0f0d"), ("idProduct", "0x0092"), ("bcdDevice", "0x0100"), ("bcdUSB", "0x0200"),
               ("bDeviceClass", "0x00"), ("bDeviceSubClass", "0x00"), ("bDeviceProtocol", "0x00"),
               ("bMaxPacketSize0", "0x40"))
    else:
        ids = (("idVendor", "0x045e"), ("idProduct", "0x028e"), ("bcdDevice", "0x0114"), ("bcdUSB", "0x0200"),
               ("bDeviceClass", "0xff"), ("bDeviceSubClass", "0xff"), ("bDeviceProtocol", "0xff"),
               ("bMaxPacketSize0", "0x40"))
    for k, v in ids:
        w(f"{G}/{k}", v)
    # The real HORI pad is full speed, but no max_speed here: the MUSB controller refuses to start a
    # gadget limited to full speed (udc_start -EINVAL, tested). It runs at high speed, like the
    # Raspberry Pi Zero (dwc2) builds of Switch pads.
    os.makedirs(f"{G}/strings/0x409", exist_ok=True)
    w(f"{G}/strings/0x409/manufacturer", "Handtop")
    w(f"{G}/strings/0x409/product", "Handtop Controller")
    w(f"{G}/strings/0x409/serialnumber", "HANDTOP0001")
    os.makedirs(f"{G}/configs/c.1/strings/0x409", exist_ok=True)
    w(f"{G}/configs/c.1/MaxPower", "500")
    w(f"{G}/configs/c.1/bmAttributes", "0x80")
    os.makedirs(f"{G}/functions/{FUNC}", exist_ok=True)
    if not os.path.islink(f"{G}/configs/c.1/{FUNC}"):
        os.symlink(f"{G}/functions/{FUNC}", f"{G}/configs/c.1/{FUNC}")
    os.makedirs(FFS, exist_ok=True)
    if subprocess.run(["mountpoint", "-q", FFS]).returncode:
        subprocess.run(["mount", "-t", "functionfs_xinput", FUNC.split(".", 1)[1], FFS], check=True)


def gadget_down(fds):
    try:
        w(f"{G}/UDC", "")              # unbind first: wakes the threads blocked on the endpoints
    except OSError:
        pass
    time.sleep(0.3)
    for fd in fds:
        try:
            os.close(fd)
        except OSError:
            pass
    gadget_clean()
    log("gadget removed")


# ------------------------------------------------------------------ status (for the screen)
class Status:
    def __init__(self):
        self.clients = []
        self.st = {"transport": TRANSPORT, "state": "cable", "device": None, "rssi": None,
                   "rate": 0, "report": [0, 0, 8, 128, 128, 128, 128, 0, 0]}
        self.server = unix_server(STATUS_SOCKET, socket.SOCK_STREAM)
        GLib.io_add_watch(self.server.fileno(), GLib.IO_IN, self.on_accept)
        self.pending = False

    def on_accept(self, fd, cond):
        c, _ = self.server.accept()
        c.setblocking(False)
        self.clients.append(c)
        self.send(c)
        return True

    def send(self, only=None):
        line = (json.dumps(self.st) + "\n").encode()
        for c in ([only] if only else list(self.clients)):
            try:
                c.send(line)
            except OSError:
                c.close()
                self.clients.remove(c)

    def update(self, **kw):
        if any(self.st.get(k) != v for k, v in kw.items()):
            self.st.update(kw)
            self.send()

    def report(self, r):
        self.st["report"] = r
        if not self.pending:
            self.pending = True
            GLib.timeout_add(33, self._flush)

    def _flush(self):
        self.pending = False
        self.send()
        return False

    def close(self):
        for c in self.clients + [self.server]:
            c.close()
        try:
            os.unlink(STATUS_SOCKET)
        except FileNotFoundError:
            pass


# ------------------------------------------------------------------ the pad
class Pad:
    def __init__(self, status, on_exit):
        self.status, self.on_exit = status, on_exit
        self.buttons = set()
        self.hat = [0, 0]
        self.axes = {E.ABS_X: 0, E.ABS_Y: 0, E.ABS_RX: 0, E.ABS_RY: 0, E.ABS_Z: 0, E.ABS_RZ: 0}
        self.cond = threading.Condition()
        self.dirty = True
        self.sent = 0
        self.conn = None
        self.rumble_want = self.rumble_sent = (0, 0)
        self.rumble_scheduled = False
        self.server = unix_server(SOCKET, socket.SOCK_SEQPACKET)
        GLib.io_add_watch(self.server.fileno(), GLib.IO_IN, self.on_accept)

    # Xbox 360 input report (20 bytes)
    def x360_report(self):
        b = 0
        for code in self.buttons:
            if code in X_BITS:
                b |= 1 << X_BITS[code]
        hx, hy = self.hat
        b |= (hy < 0) << 0 | (hy > 0) << 1 | (hx < 0) << 2 | (hx > 0) << 3
        a = self.axes
        clamp = lambda v: max(-32768, min(32767, v))
        return struct.pack("<BBHBBhhhh6x", 0x00, 0x14, b, max(0, min(255, a[E.ABS_Z])), max(0, min(255, a[E.ABS_RZ])),
                           clamp(a[E.ABS_X]), clamp(-a[E.ABS_Y]), clamp(a[E.ABS_RX]), clamp(-a[E.ABS_RY]))

    # Switch input report (8 bytes, HORI pad): buttons, hat (8 = centre), LX LY RX RY, vendor
    def switch_report(self):
        b = 0
        for code in self.buttons:
            if code in SW_BITS:
                b |= 1 << SW_BITS[code]
        a = self.axes
        b |= (a[E.ABS_Z] > 64) << 6 | (a[E.ABS_RZ] > 64) << 7      # L2 / R2 -> ZL / ZR (digital)
        to8 = lambda v: (max(-32768, min(32767, v)) + 32768) >> 8   # HID: Y grows downwards, as evdev
        return struct.pack("<H6B", b, HAT.get(tuple(self.hat), 8), to8(a[E.ABS_X]), to8(a[E.ABS_Y]),
                           to8(a[E.ABS_RX]), to8(a[E.ABS_RY]), 0)

    def report(self):
        return self.switch_report() if SWITCH else self.x360_report()

    def current_report(self):
        with self.cond:
            return self.report()

    def screen_report(self):
        b = 0
        for code in self.buttons:
            if code in S_BITS:
                b |= 1 << S_BITS[code]
        a = self.axes
        to8 = lambda v: (max(-32768, min(32767, v)) + 32768) >> 8
        return [b & 0xFF, b >> 8, HAT.get(tuple(self.hat), 8), to8(a[E.ABS_X]), to8(a[E.ABS_Y]),
                to8(a[E.ABS_RX]), to8(a[E.ABS_RY]), max(0, min(255, a[E.ABS_Z])), max(0, min(255, a[E.ABS_RZ]))]

    def writer(self, ep_in):
        """Send a report whenever the state changes (the write returns when the PC has read it).
        Switch: also resend the current one every SW_KEEPALIVE, as a real pad streams its state."""
        while True:
            with self.cond:
                if SWITCH:
                    if not self.dirty:
                        self.cond.wait(SW_KEEPALIVE)
                else:
                    while not self.dirty:
                        self.cond.wait()
                self.dirty = False
                r = self.report()
            try:
                os.write(ep_in, r)
                self.sent += 1
            except OSError:
                time.sleep(0.2)           # not connected (cable out / PC asleep): keep the latest state
                with self.cond:
                    self.dirty = True

    def on_accept(self, fd, cond):
        conn, _ = self.server.accept()
        if self.conn:
            conn.close()
            return True
        self.conn = conn
        conn.send(b"hello switch" if SWITCH else b"hello usb")
        GLib.io_add_watch(conn.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_events)
        log("input daemon connected (%s controller mode)" % ("Switch" if SWITCH else "wired"))
        return True

    def on_events(self, fd, cond):
        try:
            data = self.conn.recv(EVENT.size)
        except OSError:
            data = b""
        if len(data) != EVENT.size:
            log("input daemon disconnected: stopping wired controller mode")
            self.conn.close()
            self.conn = None
            with self.cond:
                self.buttons.clear()
                self.hat = [0, 0]
                self.axes.update({k: 0 for k in self.axes})
                self.dirty = True
                self.cond.notify()
            GLib.timeout_add(300, self.on_exit)
            return False
        etype, code, value = EVENT.unpack(data)
        with self.cond:
            if etype == E.EV_KEY:
                (self.buttons.add if value else self.buttons.discard)(code)
            elif etype == E.EV_ABS:
                if code == E.ABS_HAT0X:
                    self.hat[0] = value
                elif code == E.ABS_HAT0Y:
                    self.hat[1] = value
                elif code in self.axes:
                    self.axes[code] = value
            self.dirty = True
            self.cond.notify()
        self.status.report(self.screen_report())
        return True

    # Vibration from the PC. Games / test pages can send these continuously; forwarding every one
    # once flooded the input daemon and (with a callback queued per packet) ran the system out of
    # memory. So: keep only the latest request, forward it when it changes, at most RUMBLE_HZ times
    # a second, and never block on the socket (a dropped message is replaced by the next one).
    RUMBLE_HZ = 20

    def rumble_request(self, big, small):
        """Called from the USB reader thread for every OUT report."""
        with self.cond:
            self.rumble_want = (big, small)
            if self.rumble_scheduled:
                return
            self.rumble_scheduled = True
        GLib.idle_add(self.rumble_forward)

    def rumble_forward(self):
        with self.cond:
            want = self.rumble_want
        if want != self.rumble_sent and self.conn:
            try:
                self.conn.send(f"rumble {want[0]} {want[1]}".encode(), socket.MSG_DONTWAIT)
                self.rumble_sent = want
            except OSError:
                pass                        # busy: retried below with the then-latest value
        # stay scheduled while a change is still pending, at most RUMBLE_HZ times a second
        with self.cond:
            if self.rumble_want != self.rumble_sent and self.conn:
                GLib.timeout_add(1000 // self.RUMBLE_HZ, self.rumble_forward)
                return False
            self.rumble_scheduled = False
        return False

    def close(self):
        for s in (self.conn, self.server):
            if s:
                s.close()
        try:
            os.unlink(SOCKET)
        except FileNotFoundError:
            pass


def main():
    # Everything from the first step that touches the USB controller is inside the try: a set-up
    # that fails halfway (no UDC, FunctionFS refused, endpoint not opening) still unbinds and
    # removes the gadget (docs/hardware-safety.md, rule 2.3). gadget_down() copes with any stage.
    loop = GLib.MainLoop()
    fds = []
    status = pad = None
    try:
        status = Status()
        pad = Pad(status, lambda: (loop.quit(), False)[1])
        gadget_up()
        ep0 = os.open(f"{FFS}/ep0", os.O_RDWR)
        fds.append(ep0)
        os.write(ep0, descriptors())
        os.write(ep0, struct.pack("<IIII", 2, 16, 0, 0))     # no strings
        udcs = os.listdir("/sys/class/udc")
        if not udcs:
            raise RuntimeError("no USB device controller (UDC) found")
        udc = udcs[0]
        w(f"{G}/UDC", udc)
        log("USB gadget on", udc, "(right USB-C port, OTG2/DC)")
        if os.environ.get("RG35XXH_USBPAD_TEST_FAIL"):     # testing: fail right after binding
            raise RuntimeError("test failure after binding the gadget (RG35XXH_USBPAD_TEST_FAIL)")
        ep_in = os.open(f"{FFS}/ep1", os.O_RDWR)
        fds.append(ep_in)
        ep_out = os.open(f"{FFS}/ep2", os.O_RDWR)
        fds.append(ep_out)

        def ep0_events():
            while True:
                try:
                    ev = os.read(ep0, 12 * 4)
                except OSError:
                    return
                for i in range(0, len(ev), 12):
                    setup, etype = ev[i:i + 8], ev[i + 8]
                    if etype == 2:                                   # ENABLE: PC configured us
                        GLib.idle_add(lambda: status.update(state="connected", device=HOST_NAME) and False)
                        log("connected to", "a Switch or PC" if SWITCH else "a PC")
                    elif etype in (1, 3, 5):                         # UNBIND / DISABLE / SUSPEND
                        GLib.idle_add(lambda: status.update(state="cable", device=None) and False)
                    elif etype == 6:                                 # RESUME
                        GLib.idle_add(lambda: status.update(state="connected", device=HOST_NAME) and False)
                    elif etype == 4:                                 # SETUP for our interface
                        answer_setup(setup)

        def answer_setup(setup):
            """Switch: the HID class requests. Xbox 360: vendor requests, not needed. The rest is
            stalled (FunctionFS: reading on an IN request / writing on an OUT one stalls it)."""
            rtype, req, value, _index, length = struct.unpack("<BBHHH", setup)
            data, ack = None, False
            if SWITCH:
                if rtype == 0x81 and req == 0x06 and value >> 8 == 0x22:     # GET_DESCRIPTOR: report
                    data = SW_REPORT_DESC
                elif rtype == 0x81 and req == 0x06 and value >> 8 == 0x21:   # GET_DESCRIPTOR: HID
                    data = SW_HID_DESC
                elif rtype == 0xA1 and req == 0x01:                          # GET_REPORT
                    data = pad.current_report()
                elif rtype == 0xA1 and req == 0x02:                          # GET_IDLE
                    data = bytes([0])
                elif rtype == 0xA1 and req == 0x03:                          # GET_PROTOCOL: report
                    data = bytes([1])
                elif rtype == 0x21 and req in (0x09, 0x0A, 0x0B):            # SET_REPORT / IDLE / PROTOCOL
                    ack = True
            try:
                if data is not None:
                    os.write(ep0, data[:length])
                elif ack:
                    os.read(ep0, length)                                     # data stage (if any) + status
                else:
                    os.read(ep0, 0) if rtype & 0x80 else os.write(ep0, b"")
            except OSError:
                pass

        def ep_out_reader():
            while True:
                try:
                    d = os.read(ep_out, 64)
                except OSError:
                    time.sleep(0.5)
                    continue
                if SWITCH:
                    continue                                         # HORI's vendor output: unused
                if len(d) >= 5 and d[0] == 0x00 and d[1] == 0x08:    # rumble: 00 08 00 big small ...
                    pad.rumble_request(d[3], d[4])

        for fn, args in ((ep0_events, ()), (ep_out_reader, ()), (pad.writer, (ep_in,))):
            threading.Thread(target=fn, args=args, daemon=True).start()

        def no_pad():
            if pad.conn is None:
                log("input daemon did not connect within 60 s: stopping")
                loop.quit()
            return False
        GLib.timeout_add_seconds(60, no_pad)

        def rate():
            status.update(rate=pad.sent)
            pad.sent = 0
            return True
        GLib.timeout_add_seconds(1, rate)
        for sig in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *a: (loop.quit(), False)[1])
        loop.run()
    finally:
        for part in (pad, status):
            if part is not None:
                try:
                    part.close()
                except Exception as e:
                    log("close:", e)
        gadget_down(fds)


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("rg35xxh-usbpad: must run as root")
    code = 0
    try:
        main()
    except Exception:
        import traceback
        traceback.print_exc()
        code = 1
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(code)           # daemon threads may be blocked in FunctionFS reads/writes
