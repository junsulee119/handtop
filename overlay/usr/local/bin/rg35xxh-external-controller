#!/usr/bin/python3
"""External Controller app: use the handheld as a game controller for a PC, phone or Switch.

  rg35xxh-external-controller                           choose (two cards, each split Xbox / Switch)
  rg35xxh-external-controller bt|usb|switch|switch-bt   start that mode directly (no questions)

Bluetooth: rg35xxh-btpad.service (Xbox Wireless Controller, BLE) or rg35xxh-switchbt.service
(Switch Pro Controller, classic Bluetooth, experimental). USB cable (right USB-C port only,
OTG2/DC): rg35xxh-usbpad.service (wired Xbox 360 controller) or rg35xxh-switchpad.service (wired
Switch controller). One at a time: starting one stops the others (the units also conflict).
Picking Bluetooth: Switch first lists the Bluetooth devices connected right now, which it
disconnects (bluetoothd restarts as a Pro Controller, without classic HID), and asks to go on.
After the service is up, the input daemon is told (SIGUSR2) to send it the controls, and the
full-screen status page opens. Select + Start + L1 + R1 ends the mode.
"""
import os
import socket
import subprocess
import sys
import time

SERVICES = {"bt": "rg35xxh-btpad.service", "usb": "rg35xxh-usbpad.service",
            "switch": "rg35xxh-switchpad.service", "switch-bt": "rg35xxh-switchbt.service"}
NAMES = {"bt": "BT Controller", "usb": "Wired Controller", "switch": "Switch Controller",
         "switch-bt": "Switch Controller (Bluetooth)"}
BLUETOOTH = ("bt", "switch-bt")
STATUS = "/run/rg35xxh-extpad-status.sock"
ICONS = "/usr/local/share/rg35xxh/icons"


def notify(title, text, ms=5000):
    subprocess.run(["notify-send", "-t", str(ms), title, text])


def active(unit):
    return subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def start(mode):
    unit = SERVICES[mode]
    if active(unit):
        notify(NAMES[mode], "Already on. Select + Start + L1 + R1 to stop.", 4000)
        return 0
    for other, u in SERVICES.items():           # one connection at a time
        if other != mode and active(u):
            subprocess.run(["systemctl", "stop", u])
            time.sleep(1)
    if subprocess.run(["systemctl", "start", unit]).returncode:
        notify(NAMES[mode], "Could not start" + (" (is Bluetooth on?)" if mode in BLUETOOTH else ""), 6000)
        return 1
    ready = False
    for _ in range(150):                       # wait until the service accepts connections (BT: up to
                                               # ~3 s more while bluetoothd restarts with its identity)
        try:                                   # (probe the status socket: the pad socket takes
            with socket.socket(socket.AF_UNIX) as c:   # a single client, the input daemon)
                c.connect(STATUS)
            ready = True
            break
        except OSError:
            if not active(unit):               # service died on start: don't switch modes or
                break                          # open the screen (it would show a stale/BT page)
            time.sleep(0.1)
    if not ready:
        subprocess.run(["systemctl", "stop", unit], stderr=subprocess.DEVNULL)
        notify(NAMES[mode], f"Could not start. Details: journalctl -u {unit}", 8000)
        return 1
    # Exact command line: only the daemon itself, not its wrapper or its on-screen keyboard
    # process, which would die from SIGUSR2 (docs/hardware-safety.md rule 4).
    if subprocess.run(["pkill", "-USR2", "-x", "-f", r"python3 -m rg35xxh_inputd\.daemon"]).returncode:
        subprocess.run(["systemctl", "stop", unit], stderr=subprocess.DEVNULL)
        notify(NAMES[mode], "The input daemon is not running. Log out and back in, then try again.", 8000)
        return 1
    subprocess.Popen(["rg35xxh-controller-screen"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def connected_bt_devices():
    """Names of the Bluetooth devices connected right now (bluetoothctl), [] if none or unknown."""
    try:
        out = subprocess.run(["bluetoothctl", "devices", "Connected"], capture_output=True, text=True,
                             timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    names = []
    for line in out.splitlines():
        parts = line.split(" ", 2)
        if len(parts) >= 2 and parts[0] == "Device":
            names.append(parts[2] if len(parts) == 3 else parts[1])
    return names


def choose():
    import cairo
    import gi
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, Gtk

    try:            # Handtop theme: light icons on the light theme
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                               "rg35xxh", "theme")) as f:
            suffix = "-light" if f.read().strip() == "light" else ""
    except OSError:
        suffix = ""

    def icon(name, z=3):
        try:
            img = cairo.ImageSurface.create_from_png(f"{ICONS}/{name}{suffix}.png")
        except (OSError, cairo.Error):
            return Gtk.Label()
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, img.get_width() * z, img.get_height() * z)
        cr = cairo.Context(surf)
        cr.scale(z, z)
        cr.set_source_surface(img, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()
        return Gtk.Image.new_from_pixbuf(Gdk.pixbuf_get_from_surface(surf, 0, 0, surf.get_width(), surf.get_height()))

    picked = {}
    win = Gtk.Window(title="External Controller")
    win.set_default_size(640, 440)
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=14)
    win.add(box)
    head = Gtk.Label(xalign=0)
    head.set_markup("<span size='x-large' weight='bold'>External Controller</span>\n"
                    "<small>Use the handheld as a game controller for a PC, phone or Switch.</small>")
    box.pack_start(head, False, False, 0)
    row = Gtk.Box(spacing=12, homogeneous=True)
    box.pack_start(row, True, True, 0)

    def go(mode):
        if mode == "switch-bt" and not confirm_switch_bt():
            return
        picked["mode"] = mode
        win.destroy()

    def confirm_switch_bt():
        """Bluetooth: Switch restarts Bluetooth as a Pro Controller: say which connections go away."""
        names = connected_bt_devices()
        if not names:
            return True
        esc = lambda t: t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        d = Gtk.MessageDialog(transient_for=win, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE, text="Bluetooth devices will disconnect")
        d.format_secondary_markup(
            "Bluetooth restarts as a Switch Pro Controller. These disconnect now:\n"
            + "".join(f"  • {esc(n)}\n" for n in names)
            + "\nKeyboards, mice and controllers on classic Bluetooth stay off until you end "
              "Switch mode. Others (headphones, BLE devices) may need reconnecting afterwards.")
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        d.add_button("Start Switch mode", Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        return ok

    def split_card(ic, title, sub, halves):
        """A card: icon and title on top, then halves to pick from, one above the other. A frame
        instead of a button, so only the halves are clickable."""
        frame = Gtk.Frame()
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=8)
        frame.add(col)
        col.pack_start(icon(ic), False, False, 4)
        lab = Gtk.Label(justify=Gtk.Justification.CENTER)
        lab.set_markup(f"<span size='large' weight='bold'>{title}</span>\n<small>{sub}</small>")
        col.pack_start(lab, False, False, 0)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.get_style_context().add_class("linked")
        first = None
        for mode, hic, htitle, text in halves:
            h = Gtk.Box(spacing=10, margin=4)
            h.pack_start(icon(hic, 2), False, False, 0)
            lab = Gtk.Label(xalign=0)
            lab.set_markup(f"<span weight='bold'>{htitle}</span>\n<small>{text}</small>")
            h.pack_start(lab, True, True, 0)
            b = Gtk.Button()
            b.add(h)
            b.connect("clicked", lambda _b, m=mode: go(m))
            box.pack_start(b, True, True, 0)
            first = first or b
        col.pack_start(box, True, True, 0)
        row.pack_start(frame, True, True, 0)
        return first

    # Two cards, Bluetooth and USB cable, each split in two: Xbox (PC / phone) above, Switch below.
    # (The usbtarget-* icons serve both cards.)
    bt = split_card("inputmode-bt", "Bluetooth", "Pairs once, then reconnects.",
                    (("bt", "usbtarget-pc", "Xbox", "PC or phone. Xbox controller."),
                     ("switch-bt", "usbtarget-console", "Switch", "Experimental. F = Home.")))
    split_card("inputmode-wired", "USB cable", "Right USB-C port (OTG2/DC).",
               (("usb", "usbtarget-pc", "Xbox", "PC: Xbox 360 controller."),
                ("switch", "usbtarget-console", "Switch", "Dock or OTG. F = Home.")))
    bt.grab_focus()
    foot = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
    foot.set_markup("<small>Select + Start + L1 + R1 ends the mode. One connection at a time.</small>")
    box.pack_start(foot, False, False, 0)
    win.show_all()
    Gtk.main()
    return start(picked["mode"]) if "mode" in picked else 0


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in SERVICES:
        sys.exit(start(arg))
    for m, u in SERVICES.items():
        if active(u):
            notify(NAMES[m], "Already on. Select + Start + L1 + R1 to stop.", 4000)
            sys.exit(0)
    sys.exit(choose())
