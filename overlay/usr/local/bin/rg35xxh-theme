#!/usr/bin/python3
"""Handtop's Theme app: picks a theme and applies it (docs/apps/theme.md).

  rg35xxh-theme                 open the Theme app: pick, apply, duplicate (new colours, icon set,
                                pointer and text size), import, export, delete (handtop_theme/app.py)
  rg35xxh-theme ID              apply a theme (dark / light = handtop-dark / handtop-light)
  rg35xxh-theme --get           print the current theme's id
  rg35xxh-theme --list          installed themes: id, built-in or user, name
  rg35xxh-theme --ensure        session start: render the current theme if its files are missing
                                or out of date (nothing is restarted)
  rg35xxh-theme --import FILE [--replace]   install a .handtop-theme (checked; refused on errors)
  rg35xxh-theme --export ID FILE            write a theme as a .handtop-theme

Themes are folders (built-in: /usr/share/rg35xxh/themes, yours: ~/.local/share/rg35xxh/themes).
Only this program reads them. Applying one renders every component's own files into
~/.local/state/rg35xxh/theme/ (src/theme/handtop_theme/render.py) and then:
  - taskbar, notifications, wallpaper: restarted through rg35xxh-themed (Waybar under its
    restart loop is only stopped);
  - window title bars: the user labwc theme "Handtop" links to the rendered themerc;
    labwc --reconfigure;
  - default-app names: the rendered .desktop copies go into ~/.local/share/applications;
  - terminal: ~/.config/foot/foot.ini links to the rendered foot.ini (new windows);
  - volume / brightness bar: rg35xxh-osd re-reads the theme's colours when theme.env changes;
  - app drawer, power menu, OSK, External Controller, Display: read the rendered files when
    they open; taskbar icons: Waybar's icon scripts are signalled;
  - GTK: colour scheme, GTK theme, the generated icon theme "Handtop-Current" (linked into
    ~/.local/share/icons), fonts (ui / mono at Handtop's 9 pt) and font scale (gsettings + ~/.config/gtk-3.0/settings.ini; open apps
    may need a restart);
  - the pointer (theme and size) changes at the next log-in, for labwc and GTK apps together
    (--ensure gives GTK the pointer labwc started with). A theme's own pointer is installed as
    ~/.local/share/icons/Handtop-Theme-<id>; sets no longer in use are removed at log-in;
  - a theme's own fonts: ~/.local/share/fonts/handtop-theme/ holds the current theme's (fc-cache);
  - a theme's CSS for apps: ~/.config/gtk-3.0/gtk.css links to the rendered gtk.css (a file of
    your own there wins; open apps follow after a restart).
The choice (a theme id) is ~/.config/rg35xxh/theme; v0.3.x's "dark" / "light" are read as the
built-in themes.
"""
import configparser
import os
import shutil
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/rg35xxh-theme")
from handtop_theme import package, render, xcursor  # noqa: E402
from handtop_theme import schema as S  # noqa: E402
from handtop_theme import theme as T  # noqa: E402
from handtop_theme.current import STATE  # noqa: E402

CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
CHOICE = os.path.join(CONFIG, "rg35xxh", "theme")
GTK_INI = os.path.join(CONFIG, "gtk-3.0", "settings.ini")
DEFAULT = "handtop-dark"
OLD_NAMES = {"dark": "handtop-dark", "light": "handtop-light"}
STAMP = os.path.join(STATE, ".stamp")
WAYBAR_SIGNALS = (8, 9)          # image#inputmode, image#battery
LABWC_USER_THEME = os.path.join(DATA, "themes", "Handtop", "labwc", "themerc")
LABWC_RENDERED = os.path.join(STATE, "labwc", "themerc")
OLD_LABWC_LIGHT = "/usr/share/themes/Handtop-Light/labwc/themerc"
ICON_LINK = os.path.join(DATA, "icons", render.ICON_THEME)
OUR_ICON_THEMES = ("Adwaita", "Handtop-Light", render.ICON_THEME)   # anything else: the user's choice
OLD_MARK = "X-Handtop-Theme=light"     # v0.3.x per-user .desktop copies with -light icons
LOG = os.path.expanduser("~/.local/state/session")
ICONS_DIR = os.path.join(DATA, "icons")
FONTS_DIR = os.path.join(DATA, "fonts", "handtop-theme")
FONTS_MARK = ".handtop-theme-fonts"
GTK_CSS = os.path.join(CONFIG, "gtk-3.0", "gtk.css")


def log(*a):
    print("rg35xxh-theme:", *a, file=sys.stderr)


# ---- the choice ------------------------------------------------------------------------------------
def current():
    try:
        with open(CHOICE) as f:
            tid = f.read().strip()
    except OSError:
        return DEFAULT
    return OLD_NAMES.get(tid, tid) or DEFAULT


def _save_choice(tid):
    os.makedirs(os.path.dirname(CHOICE), exist_ok=True)
    tmp = CHOICE + ".tmp"
    with open(tmp, "w") as f:
        f.write(tid + "\n")
    os.replace(tmp, CHOICE)


def _stamp(path):
    """What the rendered files were made from: renderer version, theme folder, newest file."""
    newest = 0
    for root, _d, files in os.walk(path):
        for n in files:
            try:
                newest = max(newest, os.stat(os.path.join(root, n)).st_mtime_ns)
            except OSError:
                pass
    return f"{render.RENDER_VERSION} {os.path.realpath(path)} {newest}"


def _load(tid):
    """Load theme tid, falling back to Handtop dark when it is missing or broken."""
    for cand in (tid, DEFAULT):
        path = package.find(cand)
        if path is None:
            log(f"theme {cand!r} is not installed")
            continue
        t = T.load(path, decode=not cand.startswith("handtop-"))
        for p in t.problems:
            log(f"{cand}: {p}")
        if not t.errors:
            return t
        log(f"theme {cand!r} has errors; not used")
    raise SystemExit("rg35xxh-theme: even the built-in Handtop theme cannot be loaded")


GTK_FONT_SIZE = 9               # Handtop's GTK text size (gschema override); the theme scales it
GTK_BUILTIN = ("Adwaita", "Adwaita-dark", "HighContrast", "HighContrastInverse")   # inside GTK 3
FALLBACK = {("gtk", "theme"): "Adwaita", ("gtk", "icon_theme"): "Adwaita",
            ("cursor", "theme"): "Handtop", ("fonts", "ui"): "Noto Sans", ("fonts", "mono"): "Noto Sans Mono"}


def _dirs(sub):
    return [os.path.join(DATA, sub), os.path.expanduser(f"~/.{sub}"), f"/usr/local/share/{sub}",
            f"/usr/share/{sub}"]


def _installed(kind, name):
    if kind == ("gtk", "theme"):
        return name in GTK_BUILTIN or any(os.path.isdir(os.path.join(d, name, "gtk-3.0")) for d in _dirs("themes"))
    if kind == ("gtk", "icon_theme"):
        return any(os.path.isfile(os.path.join(d, name, "index.theme")) for d in _dirs("icons"))
    if kind == ("cursor", "theme"):
        return any(os.path.isdir(os.path.join(d, name, "cursors")) for d in _dirs("icons"))
    r = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True)
    families = {f.strip() for line in r.stdout.splitlines() for f in line.split(",")}
    return r.returncode != 0 or name in families        # no fc-list: do not second-guess


def _check_installed(t):
    """A theme names fonts, cursor, GTK and icon themes by name: any that is not installed is
    replaced by Handtop's (logged), so nothing falls back to a toolkit's odd default."""
    for (section, key), fallback in FALLBACK.items():
        if (section, key) == ("cursor", "theme") and t.cursor_images:
            continue                                   # its own: installed after rendering
        name = getattr(t, section)[key]
        if not _installed((section, key), name):
            log(f"{t.id}: {section}.{key} {name!r} is not installed; using {fallback!r}")
            getattr(t, section)[key] = fallback


def _replace_dir(dest, fill):
    """Build a folder with fill(tmp) next to dest, then swap it in."""
    parent = os.path.dirname(dest)
    os.makedirs(parent, exist_ok=True)
    tmp = dest + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    fill(tmp)
    old = dest + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.lexists(dest):
        os.rename(dest, old)
    os.rename(tmp, dest)
    shutil.rmtree(old, ignore_errors=True)


def _fonts(t):
    """The theme's own fonts in FONTS_DIR (only ever a folder this program made), then fc-cache.
    Before the installed-check, so fonts.ui / fonts.mono are found."""
    ours = os.path.isdir(FONTS_DIR) and os.path.exists(os.path.join(FONTS_DIR, FONTS_MARK))
    if os.path.lexists(FONTS_DIR) and not ours:
        if t.font_files:
            log(f"{FONTS_DIR} is not Handtop's; the theme's fonts are not installed")
        return
    want = {f"{t.id}-{role}{os.path.splitext(f)[1]}": f for role, f in t.font_files.items()}
    if ours:
        have = sorted(n for n in os.listdir(FONTS_DIR) if n != FONTS_MARK)
        if have == sorted(want) and all(_same(os.path.join(FONTS_DIR, n), f) for n, f in want.items()):
            return
    if not want:
        if ours:
            shutil.rmtree(FONTS_DIR, ignore_errors=True)
            subprocess.run(["fc-cache", os.path.dirname(FONTS_DIR)], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        return

    def fill(d):
        open(os.path.join(d, FONTS_MARK), "w").close()
        for n, f in want.items():
            shutil.copyfile(f, os.path.join(d, n))
    _replace_dir(FONTS_DIR, fill)
    subprocess.run(["fc-cache", "-f", FONTS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _same(a, b):
    try:
        with open(a, "rb") as fa, open(b, "rb") as fb:
            return fa.read() == fb.read()
    except OSError:
        return False


def _running_pointer():
    """The pointer set labwc runs with (its XCURSOR_THEME): kept until the next log-in, also when
    this program runs outside the session (ssh)."""
    names = {os.environ.get("XCURSOR_THEME", "")}
    for pid in _pids("labwc"):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                for kv in f.read().split(b"\0"):
                    if kv.startswith(b"XCURSOR_THEME="):
                        names.add(kv[14:].decode(errors="replace"))
        except OSError:
            pass
    return names


def _pointer_sets(keep):
    """Remove pointer sets this program made (Handtop-Theme-*, with its mark) not in keep."""
    try:
        names = os.listdir(ICONS_DIR)
    except OSError:
        return
    for n in names:
        p = os.path.join(ICONS_DIR, n)
        if (n.startswith(S.CURSOR_SET_PREFIX) and n not in keep and not os.path.islink(p)
                and os.path.exists(os.path.join(p, xcursor.MARK))):
            shutil.rmtree(p, ignore_errors=True)


def _pointer(t):
    """Install the rendered pointer set as ~/.local/share/icons/Handtop-Theme-<id>. The set labwc
    runs with (XCURSOR_THEME) is kept until the next log-in."""
    src = os.path.join(STATE, "pointer")
    if t.cursor_images and os.path.isdir(src):
        dest = os.path.join(ICONS_DIR, t.cursor["theme"])
        if os.path.lexists(dest) and not os.path.exists(os.path.join(dest, xcursor.MARK)):
            log(f"{dest} is not Handtop's; the theme's pointer is not installed")
        else:
            _replace_dir(dest, lambda d: shutil.copytree(src, d, dirs_exist_ok=True))
    _pointer_sets({t.cursor["theme"]} | _running_pointer())


def prepare(tid):
    """Render theme tid (or the fallback) into STATE. Returns the Theme."""
    t = _load(tid)
    _fonts(t)
    _check_installed(t)
    render.render(t, STATE)
    _pointer(t)
    with open(STAMP, "w") as f:
        f.write(_stamp(t.path) + "\n")
    return t


# ---- applying ----------------------------------------------------------------------------------------
def _gget(key):
    r = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", key],
                       capture_output=True, text=True)
    return r.stdout.strip().strip("'") if r.returncode == 0 else None


def _gsettings(key, value):
    """Set an org.gnome.desktop.interface key when it differs (each write wakes every GTK app)."""
    if _gget(key) != str(value):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, str(value)],
                       stderr=subprocess.DEVNULL)


def _gtk(t):
    _gsettings("color-scheme", t.gtk["color_scheme"])
    _gsettings("gtk-theme", t.gtk["theme"])
    own_icons = _gget("icon-theme") in OUR_ICON_THEMES
    if own_icons:
        _gsettings("icon-theme", render.ICON_THEME)
    _gsettings("text-scaling-factor", float(t.fonts["scale"]))
    _gsettings("font-name", f"{t.fonts['ui']} {GTK_FONT_SIZE}")          # GTK apps' text
    _gsettings("document-font-name", f"{t.fonts['ui']} {GTK_FONT_SIZE}")
    _gsettings("monospace-font-name", f"{t.fonts['mono']} {GTK_FONT_SIZE}")
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    try:
        cp.read(GTK_INI)
    except configparser.Error:
        pass
    if not cp.has_section("Settings"):
        cp.add_section("Settings")
    s = cp["Settings"]
    s["gtk-application-prefer-dark-theme"] = "true" if t.gtk["color_scheme"] == "prefer-dark" else "false"
    s["gtk-theme-name"] = t.gtk["theme"]
    s["gtk-font-name"] = f"{t.fonts['ui']} {GTK_FONT_SIZE}"
    if own_icons and s.get("gtk-icon-theme-name", "Adwaita") in OUR_ICON_THEMES:
        s["gtk-icon-theme-name"] = render.ICON_THEME
    os.makedirs(os.path.dirname(GTK_INI), exist_ok=True)
    with open(GTK_INI, "w") as f:
        cp.write(f, space_around_delimiters=False)


def _session_cursor():
    """Give GTK apps the pointer labwc runs with. labwc reads XCURSOR_* only when it starts (the
    session script sets them from the theme), so a new theme's pointer waits for the next log-in;
    GTK would switch at once, and then the hand / text pointers over apps had another size than
    the arrow (found 2026-11-10). Run at every log-in (--ensure), never by apply."""
    env = render_env()
    name = os.environ.get("XCURSOR_THEME") or env.get("CURSOR_THEME") or "Handtop"
    size = os.environ.get("XCURSOR_SIZE") or env.get("CURSOR_SIZE") or "24"
    _gsettings("cursor-theme", name)
    _gsettings("cursor-size", size)
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    try:
        cp.read(GTK_INI)
    except configparser.Error:
        pass
    if not cp.has_section("Settings"):
        cp.add_section("Settings")
    cp["Settings"]["gtk-cursor-theme-name"] = name
    cp["Settings"]["gtk-cursor-theme-size"] = size
    os.makedirs(os.path.dirname(GTK_INI), exist_ok=True)
    with open(GTK_INI, "w") as f:
        cp.write(f, space_around_delimiters=False)


def render_env():
    from handtop_theme.current import read_env
    return read_env()


def _link(link, target, ours):
    """Point link at target unless something else (not ours) is there. True if changed."""
    try:
        if os.path.islink(link):
            now = os.readlink(link)
            if now == target:
                return False
            if now not in ours:
                return False              # the user's own link
            os.remove(link)
        elif os.path.exists(link):
            return False                  # the user's own file / folder wins
        os.makedirs(os.path.dirname(link), exist_ok=True)
        os.symlink(target, link)
        return True
    except OSError as e:
        log(f"cannot link {link}: {e}")
        return False


def _old_desktop_copies():
    """Remove v0.3.x's per-user .desktop copies with -light icons (only files with its marker)."""
    d = os.path.join(DATA, "applications")
    try:
        names = os.listdir(d)
    except OSError:
        return
    for n in names:
        p = os.path.join(d, n)
        try:
            with open(p) as f:
                if OLD_MARK in f.read():
                    os.remove(p)
        except OSError:
            pass


def _app_names():
    """The theme's names for default apps: its rendered .desktop copies go into
    ~/.local/share/applications (they win over the system's); the previous theme's copies, marked,
    are removed first. A file of your own with the same name is left alone."""
    d = os.path.join(DATA, "applications")
    try:
        for n in os.listdir(d):
            p = os.path.join(d, n)
            try:
                with open(p) as f:
                    if render.NAME_MARK in f.read():
                        os.remove(p)
            except OSError:
                pass
    except OSError:
        pass
    src = os.path.join(STATE, "applications")
    try:
        names = os.listdir(src)
    except OSError:
        return
    os.makedirs(d, exist_ok=True)
    for n in names:
        if not os.path.exists(os.path.join(d, n)):
            shutil.copyfile(os.path.join(src, n), os.path.join(d, n))


def _pids(name):
    out = []
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                with open(f"/proc/{d}/comm") as f:
                    if f.read().strip() == name:
                        out.append(int(d))
            except OSError:
                pass
    return out


def _waybar_refresh():
    """Re-run the icon scripts. Only signal a Waybar that has been up >= 3 s (a real-time signal
    during its start-up would kill it)."""
    for pid in _pids("waybar"):
        try:
            with open(f"/proc/{pid}/stat") as f:
                start = int(f.read().rsplit(")", 1)[1].split()[19]) / os.sysconf("SC_CLK_TCK")
            with open("/proc/uptime") as f:
                age = float(f.read().split()[0]) - start
            if age >= 3:
                for n in WAYBAR_SIGNALS:
                    os.kill(pid, signal.SIGRTMIN + n)
        except (OSError, ValueError, IndexError):
            pass


def _restart(name):
    """Stop the running component and start it again through rg35xxh-themed (new theme).
    Waybar under rg35xxh-waybar (the session's restart loop) is only stopped: the loop starts
    the new one, so there are never two taskbars."""
    pids = _pids(name)
    looped = name == "waybar" and _pids("rg35xxh-waybar")
    for p in pids:
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(30):                            # wait up to 3 s for it to go (Waybar must
        if not any(os.path.exists(f"/proc/{p}") for p in pids):   # release the tray first)
            break
        time.sleep(0.1)
    if looped:
        return
    os.makedirs(LOG, exist_ok=True)
    with open(os.path.join(LOG, f"{name}.log"), "a") as lg:
        subprocess.Popen(["rg35xxh-themed", name], stdin=subprocess.DEVNULL, stdout=lg, stderr=lg,
                         start_new_session=True)


def _session(t):
    """Everything outside STATE that points at the rendered theme."""
    _gtk(t)
    _link(ICON_LINK, os.path.join(STATE, "icon-theme"), ())
    _old_desktop_copies()
    _app_names()
    # the terminal: foot reads ~/.config/foot/foot.ini first (a file of your own there wins);
    # running terminals keep their colours, new ones follow
    _link(os.path.join(CONFIG, "foot", "foot.ini"), os.path.join(STATE, "foot.ini"), ())
    # GTK 3 apps: the theme's CSS (a header only when it has none); a gtk.css of your own wins
    _link(GTK_CSS, os.path.join(STATE, "gtk.css"), ())
    _link(LABWC_USER_THEME, LABWC_RENDERED, (OLD_LABWC_LIGHT,))
    # labwc re-reads the theme file only on reconfigure (also when only its content changed)
    subprocess.run(["labwc", "--reconfigure"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(tid):
    t = prepare(tid)
    _save_choice(t.id)
    _session(t)
    _waybar_refresh()                             # (a Waybar < 3 s old is skipped: it is new anyway)
    for name in ("swaybg", "mako", "waybar"):     # the new Waybar draws the new icons at start
        if _pids(name):
            _restart(name)
    return t


def ensure():
    """Session start: make sure the rendered files match the current theme. Fast when they do."""
    tid = current()
    path = package.find(tid)
    try:
        with open(STAMP) as f:
            ok = path is not None and f.read().strip() == _stamp(path)
    except OSError:
        ok = False
    if ok and os.path.exists(os.path.join(STATE, "theme.env")):
        _session_cursor()
        _pointer_sets({render_env().get("CURSOR_THEME", "")} | _running_pointer())
        return
    t = prepare(tid)
    if t.id != tid or not os.path.exists(CHOICE) or open(CHOICE).read().strip() != t.id:
        _save_choice(t.id)                         # migrates "dark" / "light"
    _session(t)
    _session_cursor()


# ---- the app -----------------------------------------------------------------------------------------
def gui():
    from handtop_theme import app
    app.run(apply, current)


def main(argv):
    if not argv:
        gui()
    elif argv[0] == "--get":
        print(current())
    elif argv[0] == "--list":
        for tid, path, builtin in package.list_themes():
            t = T.load(path)
            print(f"{tid}\t{'built-in' if builtin else 'user'}\t{t.name or '(broken)'}")
    elif argv[0] == "--ensure":
        ensure()
    elif argv[0] == "--import" and len(argv) >= 2:
        try:
            t = package.import_theme(argv[1], replace="--replace" in argv)
        except package.ThemeExists as e:
            sys.exit(f"{e} (add --replace to replace it)")
        except T.ThemeError as e:
            sys.exit("refused:\n  " + "\n  ".join(str(p) for p in e.problems))
        for p in t.problems:
            print(p)
        print(f"installed {t.id} ({t.name})")
    elif argv[0] == "--export" and len(argv) == 3:
        path = package.find(OLD_NAMES.get(argv[1], argv[1]))
        if path is None:
            sys.exit(f"no theme {argv[1]!r}")
        print(package.export_theme(path, argv[2]))
    elif not argv[0].startswith("-") and len(argv) == 1:
        tid = OLD_NAMES.get(argv[0], argv[0])
        if package.find(tid) is None:
            sys.exit(f"no theme {argv[0]!r} (rg35xxh-theme --list)")
        apply(tid)
    else:
        sys.exit(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    main(sys.argv[1:])
