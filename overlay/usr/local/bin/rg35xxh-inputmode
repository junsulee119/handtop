#!/bin/sh
# Waybar image#inputmode: prints the icon for the input daemon's current mode (flag files it
# writes) and a tooltip. rg35xxh-inputd signals Waybar (SIGRTMIN+8) on each change and drives the
# shake: while $XDG_RUNTIME_DIR/rg35xxh-inputmode-frame exists it holds "<old mode> <dx>", and the
# old icon is shown with its drawing shifted dx px (pre-drawn frames, one damped-spring swing each).
# Icons: the current theme's (rendered by rg35xxh-theme), Handtop dark's until then.
d="${XDG_RUNTIME_DIR:-/tmp}"
icons="${XDG_STATE_HOME:-$HOME/.local/state}/rg35xxh/theme/icons"
[ -d "$icons" ] || icons=/usr/local/share/rg35xxh/icons

if [ -e "$d/rg35xxh-bt-mode" ]; then mode=bt
elif [ -e "$d/rg35xxh-wired-mode" ]; then mode=wired
elif [ -e "$d/rg35xxh-gamepad-mode" ]; then mode=gamepad
else mode=desktop
fi
dx=
if [ -r "$d/rg35xxh-inputmode-frame" ]; then
  read -r fmode fdx < "$d/rg35xxh-inputmode-frame" 2>/dev/null
  case "$fmode:$fdx" in
    desktop:*|gamepad:*|bt:*|wired:*) case "$fdx" in -2|-1|1|2) mode=$fmode dx=$fdx ;; esac ;;
  esac
fi

case $mode in
  bt) tip="BT Controller mode: the controls go to the paired PC/phone. Select + Start + L1 + R1 to stop." ;;
  wired) tip="Wired Controller mode: the controls go to the PC over the USB cable. Select + Start + L1 + R1 to stop." ;;
  gamepad) tip="Gamepad mode. Hold Start 1 s for desktop mode." ;;
  *) tip="Desktop mode (mouse and keyboard). Press Start for gamepad mode." ;;
esac
printf '%s\n%s\n' "$icons/inputmode-$mode${dx:+-shake$dx}.png" "$tip"
