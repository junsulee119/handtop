#!/bin/sh
# Start a desktop component in the current Handtop theme, from the files rg35xxh-theme rendered
# into ~/.local/state/rg35xxh/theme (Handtop dark's files in /etc until the first render).
#   rg35xxh-themed waybar|mako|swaybg
# Used by the labwc autostart and rg35xxh-waybar, and by rg35xxh-theme to restart them after a
# switch. Your own config (~/.config/waybar/style.css, ~/.config/mako/config) still takes precedence.
C="${XDG_CONFIG_HOME:-$HOME/.config}"
S="${XDG_STATE_HOME:-$HOME/.local/state}/rg35xxh/theme"
val() { sed -n "s/^$1='\(.*\)'\$/\1/p" "$S/theme.env" 2>/dev/null; }   # one theme.env value
case "$1" in
  waybar)
    [ ! -e "$C/waybar/style.css" ] && [ -r "$S/waybar.css" ] && exec waybar -s "$S/waybar.css"
    exec waybar ;;
  mako)
    [ -e "$C/mako/config" ] && exec mako      # mako does not read /etc/xdg/mako/config by itself
    [ -r "$S/mako.conf" ] && exec mako -c "$S/mako.conf"
    exec mako -c /etc/xdg/mako/config ;;
  swaybg)      # the wallpaper image (centred by default) on its colour, which fills bigger screens
    col=$(val WALLPAPER_COLOR); img=$(val WALLPAPER); mode=$(val WALLPAPER_MODE)
    if [ -z "$col" ]; then                   # not rendered yet: Handtop dark
      col='#1e2430' img=/usr/local/share/rg35xxh/wallpaper-dark.png mode=center
    fi
    [ -n "$img" ] && [ -r "$img" ] && exec swaybg -i "$img" -m "${mode:-center}" -c "$col"
    exec swaybg -m solid_color -c "$col" ;;
  *) echo "usage: rg35xxh-themed waybar|mako|swaybg" >&2; exit 2 ;;
esac
