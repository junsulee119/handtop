#!/bin/sh
# Called by swayidle after AUTOSLEEP_MINUTES without input (labwc autostart).
# Skips sleeping while charging, in gamepad or external controller mode (controller input is not seen by the
# compositor) or with an HDMI monitor connected. Apps that play video or stream
# (Moonlight, Chromium, mpv) block idle themselves through the idle-inhibit protocol.
[ -r /etc/rg35xxh/power.conf ] && . /etc/rg35xxh/power.conf
log() { echo "$(date '+%F %T') rg35xxh-autosleep: $*"; }
if [ "$(cat /sys/class/power_supply/axp20x-usb/online 2>/dev/null)" = 1 ] && [ "${AUTOSLEEP_ON_CHARGER:-no}" != yes ]; then
  log "charging, not sleeping"; exit 0
fi
# Screen off keeps things running (SSH, downloads): never sleep there. rg35xxh-lowbattery turns
# the screen back on at low battery and shuts down cleanly before the battery runs flat.
if [ -e "$XDG_RUNTIME_DIR/rg35xxh-screen-off" ]; then
  log "Screen off, not sleeping"; exit 0
fi
if [ -e "$XDG_RUNTIME_DIR/rg35xxh-gamepad-mode" ] || [ -e "$XDG_RUNTIME_DIR/rg35xxh-bt-mode" ] ||
   [ -e "$XDG_RUNTIME_DIR/rg35xxh-wired-mode" ]; then
  log "gamepad or external controller mode, not sleeping"; exit 0
fi
for s in /sys/class/drm/card*-HDMI-*/status; do
  [ "$(cat "$s" 2>/dev/null)" = connected ] && { log "HDMI connected, not sleeping"; exit 0; }
done
log "idle, going to sleep"
exec rg35xxh-sleep
