#!/bin/sh
# App launcher: full-screen icon grid sized for 640x480 (toggles if already open).
# -spacing 4: with the default spacing (20) the 4th column ran past the right screen edge.
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
pgrep -x nwg-drawer >/dev/null && exec nwg-drawer -close
# Style from the current theme (rendered by rg35xxh-theme; Handtop dark's until then).
# nwg-drawer only takes a file name inside ~/.config/nwg-drawer, so it is copied there.
CSS="${XDG_STATE_HOME:-$HOME/.local/state}/rg35xxh/theme/nwg-drawer.css"
[ -r "$CSS" ] || CSS=/etc/xdg/nwg-drawer/handtop-dark.css
D="${XDG_CONFIG_HOME:-$HOME/.config}/nwg-drawer"; mkdir -p "$D"
cmp -s "$CSS" "$D/handtop.css" || cp "$CSS" "$D/handtop.css"
exec nwg-drawer -s handtop.css -c 4 -is 56 -spacing 4 -nofs -nocats -closebtn right -fm thunar -term foot -ovl
