#!/bin/sh
# Re-center the analog sticks: asks the input daemon to make the stick driver measure the
# centre again (see rg35xxh-inputd, "stick re-centre"). Keep your hands off the sticks.
# Exact command line: only the daemon itself (not its wrapper or its on-screen keyboard process,
# which would die from SIGUSR1; docs/hardware-safety.md rule 4). One daemon at a time (lock).
PID=$(pgrep -x -f 'python3 -m rg35xxh_inputd\.daemon' | head -1)
if [ -z "$PID" ]; then
  notify-send -t 4000 "Re-center sticks" "Input daemon is not running"; exit 1
fi
notify-send -t 3000 "Re-center sticks" "Hands off the sticks for 3 seconds…"
sleep 3
kill -USR1 "$PID"
