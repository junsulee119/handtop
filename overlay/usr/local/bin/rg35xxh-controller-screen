#!/usr/bin/python3
"""External-control status screen (BT Controller, Wired Controller and Switch Controller modes,
USB and Bluetooth).

Full-screen layer-shell window over the desktop while the handheld is used as a controller for
another device. Shows the connection state, the host's name, a live drawing of the handheld's
controls (pixel art, drawn at half resolution and scaled 2x like the taskbar icons), battery,
link info and how to stop. Reads JSON lines from the running service's status socket
(rg35xxh-btpad or rg35xxh-usbpad, also for Switch mode) and closes itself
when that socket closes (the mode ended). Takes no input: every button goes to the other device.

--saver (Battery saver, chosen in the External Controller app): redraws only when the picture
changes, at most 15 per second, and switches the handheld's display off (wlopm, DSI-1) 30 s
after the other device connected. Vol+ / Vol- (also F + Vol) and Power wake it for 10 s: the
input daemon writes $XDG_RUNTIME_DIR/rg35xxh-extpad-wake on those presses (the only ones not sent
to the other device), which this watches. It also comes back by itself when the connection
drops, and always when this window ends (rg35xxh-extpad-dark marks the dark state; the input
daemon switches the display on if this process died meanwhile).
"""
import json
import os
import signal
import socket
import subprocess
import sys
import time

import cairo
import gi
gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402

STATUS_SOCKET = "/run/rg35xxh-extpad-status.sock"     # rg35xxh-btpad or rg35xxh-usbpad
ICONS = "/usr/local/share/rg35xxh/icons"
SAVER = "--saver" in sys.argv          # Battery saver (see the top)
MAX_FPS = 15                           # Battery saver: redraws per second, at most
DARK_AFTER_S, WAKE_S = 30, 10          # Battery saver: display off after connecting / after a wake
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
WAKE_FILE = os.path.join(RUNTIME, "rg35xxh-extpad-wake")   # written by the input daemon
DARK_FLAG = os.path.join(RUNTIME, "rg35xxh-extpad-dark")   # exists while the display is off
OUTPUT = "DSI-1"                       # the handheld's own display (an HDMI monitor stays on)
# The handheld drawing, its geometry and colours: shared with the Controls app.
sys.path.insert(0, "/usr/local/lib/rg35xxh-controls")
from handtop_controls.art import (BG, BIT, DARK, H, LABEL_COL, PH, PW, SCR, SELECT,  # noqa: E402,F401
                                  START, W, Painter, src)

TEXT, DIM, OK, WARN = (0.91, 0.92, 0.93), (0.58, 0.62, 0.69), (0.55, 0.85, 0.62), (1.0, 0.80, 0.40)
# Text drawn on the handheld's own (always dark) screen and body keeps these colours in both themes.
SCREEN_TEXT, SCREEN_DIM, SCREEN_OK, SCREEN_WARN = TEXT, DIM, OK, WARN


def _current_theme():
    """The current theme's colours and icon folder (rg35xxh-theme renders them), read once at
    start. Returns (palette, page colours, screen colours, icon folder) or None if not rendered."""
    sys.path.insert(0, "/usr/local/lib/rg35xxh-theme")
    try:
        from handtop_theme import current
    except ImportError:
        return None
    c = current.colors("status")
    try:
        r = current.rgba
        pal = {k.upper(): r(c[k]) for k in ("body", "body_edge", "body_shade", "part", "part_edge", "lit",
                                            "lit_edge", "bezel", "bezel_edge", "screen", "led", "cap",
                                            "label", "label_lit")}
        pal["FACE"] = {b: r(c[f"face_{b.lower()}"]) for b in "XYAB"}
        page = tuple(r(c[k]) for k in ("bg", "text", "dim", "ok", "warn"))
        screen = tuple(r(c[f"screen_{k}"]) for k in ("text", "dim", "ok", "warn"))
    except (KeyError, ValueError):
        return None
    return pal, page, screen, current.icons_dir()


PAL = DARK
_cur = _current_theme()
if _cur:
    PAL, (BG, TEXT, DIM, OK, WARN), (SCREEN_TEXT, SCREEN_DIM, SCREEN_OK, SCREEN_WARN), ICONS = _cur
ACCENT = {"bt": (0.37, 0.50, 0.74), "usb": (0.75, 0.54, 0.36), "switch": (0.80, 0.33, 0.33),
          "switch-bt": (0.80, 0.33, 0.33)}


STATE_TEXT = {
    "pairing": ("Ready to pair", "On your PC or phone: Bluetooth > Add device > \"Handtop (Xbox)\""),
    "waiting": ("Waiting for {dev}", "Turn on Bluetooth there; it reconnects by itself"),
    "connected": ("Connected to {dev}", None),
    "cable": ("Connect the USB cable", "Right USB-C port (OTG2/DC) to the PC; the handheld charges meanwhile"),
    None: ("Starting…", None),
}
SWITCH_CABLE_HINT = "Right USB-C port to the Switch dock (USB-A), or through a USB-C OTG adapter"
SWITCH_HINT = "F: Home (hold: quick settings)    F + Select: Capture"
SWITCH_BT_TEXT = {      # Switch over Bluetooth (rg35xxh-switchbt): pairing happens on the Switch
    "pairing": ("Ready to pair", "On the Switch: Controllers > Change Grip/Order"),
    "waiting": ("Waiting for {dev}", "Wake the Switch; the handheld reconnects by itself"),
}


def handheld_monitor():
    """The handheld's own screen (DSI-1, 640x480) when an external display is connected too, so the
    status screen does not open on the monitor (a layer surface without an output goes to the one
    with the pointer). None: only one screen, or the handheld screen is off (Monitor only)."""
    import json
    import subprocess
    try:
        outs = json.loads(subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True,
                                         timeout=5).stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    if not any(o.get("enabled") and o["name"] != "DSI-1" for o in outs):
        return None
    if not any(o.get("enabled") and o["name"] == "DSI-1" for o in outs):
        return None
    ext_models = {o.get("model") or "" for o in outs if o["name"] != "DSI-1"}
    disp = Gdk.Display.get_default()
    for i in range(disp.get_n_monitors()):
        mon = disp.get_monitor(i)
        g = mon.get_geometry()
        if (g.width, g.height) == (W, H) and (mon.get_model() or "") not in ext_models - {""}:
            return mon
    return None


class Screen(Painter, Gtk.Window):
    def __init__(self):
        super().__init__()
        self.pal = PAL
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "rg35xxh-controller-screen")
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        handheld = handheld_monitor()
        if handheld is not None:                # with an HDMI display: on the handheld, not the monitor
            GtkLayerShell.set_monitor(self, handheld)
        self.area = Gtk.DrawingArea()
        self.area.connect("draw", self.on_draw)
        self.add(self.area)
        self.connect("realize", lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), "none")))     # no pointer over the screen
        self.st = {}
        self.buf = b""
        self.sock = None
        self.tries = 0
        self.icon = None
        self.icon_path = None
        GLib.timeout_add(200, lambda: self.connect_status())
        GLib.timeout_add_seconds(30, self.redraw)     # battery level
        self.bat_icons = {}
        self.bat_tick = 0
        GLib.timeout_add(450, self.battery_tick)       # charging animation (same as the taskbar)
        # Battery saver
        self.draw_pending = False
        self.last_draw = 0.0
        self.drawn_key = None
        self.dark = False
        self.dark_timer = None
        self.wake_monitor = None
        if SAVER:
            try:
                open(WAKE_FILE, "a").close()
                self.wake_monitor = Gio.File.new_for_path(WAKE_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
                self.wake_monitor.connect("changed", self.on_wake)
            except (OSError, GLib.Error) as e:
                print("rg35xxh-controller-screen: no wake file:", e, file=sys.stderr)

    # ------------------------------------------------------------ data
    def connect_status(self):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(STATUS_SOCKET)
        except OSError:
            self.tries += 1
            if self.tries > 75:                       # ~15 s: the service never came up
                Gtk.main_quit()
                return False
            return True
        self.sock = s
        GLib.io_add_watch(s.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_data)
        return False

    def on_data(self, fd, cond):
        try:
            data = self.sock.recv(65536)
        except OSError:
            data = b""
        if not data:                                  # BT Controller mode ended
            Gtk.main_quit()
            return False
        self.buf += data
        *lines, self.buf = self.buf.split(b"\n")
        old_state = self.st.get("state")
        for line in lines[-1:]:                       # only the newest state matters
            try:
                self.st = json.loads(line)
            except ValueError:
                pass
        if not SAVER:
            self.area.queue_draw()
            return True
        state = self.st.get("state")
        if state != old_state:
            if state == "connected":
                self.dark_in(DARK_AFTER_S)
            else:                                     # connection lost / waiting: show it
                self.cancel_dark()
                self.light()
        key = self.visual_key()
        if key != self.drawn_key:                     # same picture as on screen: skip
            self.drawn_key = key
            self.schedule_draw()
        return True

    def redraw(self):
        if not self.dark:
            self.area.queue_draw()
        return True

    # ------------------------------------------------------------ battery saver
    def visual_key(self):
        """What the picture depends on: stick noise and values that draw the same pixels (the
        caps move at most 6 px) don't trigger a redraw."""
        buttons, hat, sticks, trig = self.report()
        caps = tuple(round((a - 128) / 128 * 6) for a in sticks)
        st = self.st
        return (st.get("state"), st.get("device"), st.get("rssi"), st.get("rate"),
                buttons, hat, caps, trig[0] > 0, trig[1] > 0)

    def schedule_draw(self):
        """At most MAX_FPS redraws per second; the newest state is drawn at the next slot.
        Status updates come with every input report (up to hundreds per second): drawing each
        one kept a core about 20 % busy (measured 2026-10-28), the biggest cost of the mode."""
        if self.draw_pending or self.dark:
            return
        self.draw_pending = True
        wait = max(0.0, self.last_draw + 1.0 / MAX_FPS - time.monotonic())
        GLib.timeout_add(int(wait * 1000), self._draw_now)

    def _draw_now(self):
        self.draw_pending = False
        self.last_draw = time.monotonic()
        if not self.dark:
            self.area.queue_draw()
        return False

    def dark_in(self, seconds):
        self.cancel_dark()
        self.dark_timer = GLib.timeout_add_seconds(seconds, self._go_dark)

    def cancel_dark(self):
        if self.dark_timer:
            GLib.source_remove(self.dark_timer)
            self.dark_timer = None

    def _go_dark(self):
        self.dark_timer = None
        if self.dark or self.st.get("state") != "connected":
            return False
        self.dark = True
        try:
            open(DARK_FLAG, "w").close()
        except OSError:
            pass
        wlopm("--off")
        return False

    def light(self):
        if not self.dark:
            return
        self.dark = False
        wlopm("--on")
        try:
            os.unlink(DARK_FLAG)
        except FileNotFoundError:
            pass
        self.drawn_key = None
        self.area.queue_draw()

    def on_wake(self, monitor, f, other, event):
        if event == Gio.FileMonitorEvent.DELETED:
            return
        self.light()
        if self.st.get("state") == "connected":
            self.dark_in(WAKE_S)

    # ------------------------------------------------------------ drawing
    def on_draw(self, widget, cr):
        src(cr, BG)
        cr.paint()
        art = cairo.ImageSurface(cairo.FORMAT_ARGB32, PW, PH)
        self.draw_handheld(cairo.Context(art))
        cr.save()
        cr.scale(2, 2)
        cr.set_source_surface(art, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()
        cr.restore()
        self.draw_header(cr)
        self.draw_screen_text(cr)
        self.draw_footer(cr)

    def report(self):
        r = self.st.get("report") or [0, 0, 8, 128, 128, 128, 128, 0, 0]
        return r[0] | (r[1] << 8), r[2], r[3:7], r[7:9]

    def pressed(self, name):
        buttons = self.report()[0]
        return bool(buttons >> BIT[name] & 1)

    def text_mid(self, cr, s, cx, cy, size, color, bold=False):
        """Draw s with its ink (not its advance box) centred on (cx, cy)."""
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        e = cr.text_extents(s)
        cr.move_to(round(cx - e.x_bearing - e.width / 2), round(cy - e.y_bearing - e.height / 2))
        src(cr, color)
        cr.show_text(s)

    def battery_frames(self, bars):
        """Bar counts shown in turn while charging (like rg35xxh-battery): level .. full, hold full."""
        return list(range(bars, 5)) + [5, 5] if bars < 5 else [5]

    def battery_icon(self, cap, charging):
        bars = min(5, max(0, -(-cap // 20)))
        if charging:
            seq = self.battery_frames(bars)
            bars = seq[self.bat_tick % len(seq)]
        name = ("battery" + ("-charging" if charging else "") + ("-low" if cap <= 20 else "")
                + f"-{bars}.png")
        if name not in self.bat_icons:
            try:
                self.bat_icons[name] = cairo.ImageSurface.create_from_png(f"{ICONS}/{name}")
            except (OSError, cairo.Error):
                self.bat_icons[name] = None
        return self.bat_icons[name]

    def battery_tick(self):
        if battery()[1]:                               # charging: next frame
            self.bat_tick += 1
            self.area.queue_draw()
        else:
            self.bat_tick = 0
        return True

    def text(self, cr, s, x, y, size, color, bold=False, align="left"):
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(s)
        if align == "center":
            x -= ext.x_advance / 2
        elif align == "right":
            x -= ext.x_advance
        cr.move_to(x, y)
        src(cr, color)
        cr.show_text(s)

    def draw_header(self, cr):
        transport = self.st.get("transport", "bt")
        path = f"{ICONS}/inputmode-{'bt' if transport in ('bt', 'switch-bt') else 'wired'}.png"
        if (self.icon is None or self.icon_path != path) and os.path.exists(path):
            self.icon = cairo.ImageSurface.create_from_png(path)
            self.icon_path = path
        if self.icon:
            cr.save()
            cr.translate(20, 18)
            cr.scale(2, 2)
            cr.set_source_surface(self.icon, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.paint()
            cr.restore()
        state = self.st.get("state")
        title, hint = STATE_TEXT.get(state, STATE_TEXT[None])
        if transport == "switch-bt" and state in SWITCH_BT_TEXT:
            title, hint = SWITCH_BT_TEXT[state]
        if transport == "switch":
            hint = SWITCH_CABLE_HINT if state == "cable" else hint or SWITCH_HINT
        elif transport == "switch-bt":
            hint = hint or SWITCH_HINT
        dev = self.st.get("device") or "your device"
        self.text(cr, title.format(dev=dev), 80, 46, 22, OK if state == "connected" else TEXT, bold=True)
        sub = {"bt": "BT Controller", "usb": "Wired Controller (USB)",
               "switch": "Switch Controller (USB)",
               "switch-bt": "Switch Controller (Bluetooth, experimental)"}.get(transport, "")
        self.text(cr, sub, 80, 64, 13, DIM)
        # battery (top right): the taskbar's pixel-art battery icon at 2x, then the percentage
        cap, charging = battery()
        if cap is not None:
            col = WARN if cap <= 20 and not charging else TEXT
            label = f"{cap}%"
            self.text(cr, label, W - 20, 46, 22, col, bold=True, align="right")
            cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(22)
            tw = cr.text_extents(label).x_advance
            img = self.battery_icon(cap, charging)
            if img:
                cr.save()
                cr.translate(round(W - 20 - tw - 10 - 2 * img.get_width()), 27)
                cr.scale(2, 2)
                cr.set_source_surface(img, 0, 0)
                cr.get_source().set_filter(cairo.FILTER_NEAREST)
                cr.paint()
                cr.restore()
        if hint:
            self.text(cr, hint, W / 2, 400, 15, TEXT, align="center")

    def draw_screen_text(self, cr):
        # link info on the drawn handheld's own screen (canvas screen at 110,70 100x76 -> x2)
        x, y = (SCR[0] + SCR[2] / 2) * 2, SCR[1] * 2
        if self.st.get("state") != "connected":
            self.text(cr, "Handtop", x, y + 112, 18, SCREEN_DIM, bold=True, align="center")
            return
        rate = self.st.get("rate", 0)
        rssi = self.st.get("rssi")
        self.text(cr, f"{rate}", x, y + 78, 34, SCREEN_TEXT, bold=True, align="center")
        self.text(cr, "reports/s", x, y + 98, 13, SCREEN_DIM, align="center")
        if rssi is not None:
            q = "strong" if rssi >= -70 else "good" if rssi >= -85 else "weak"
            self.text(cr, f"signal {q}", x, y + 140, 15, SCREEN_OK if q != "weak" else SCREEN_WARN, align="center")
            self.text(cr, f"{rssi} dBm", x, y + 158, 12, SCREEN_DIM, align="center")

    def draw_footer(self, cr):
        # face-button labels on top of the pixel art (crisp text)
        P = self.pal
        for label, (x, y, lit) in getattr(self, "face", {}).items():
            # centre of pixel (x, y) on the 2x canvas = (2x + 1, 2y + 1); centre the letter's ink there
            self.text_mid(cr, label, x * 2 + 1, y * 2 + 1, 15,
                          P["LABEL_LIT"] if lit else (P["LABEL"] or LABEL_COL[label]), bold=True)
        for label, (x, y) in (("SELECT", SELECT), ("START", START)):
            self.text(cr, label, x * 2, y * 2 - 13, 9, P["LABEL"] or SCREEN_DIM, align="center")
        self.text(cr, "Select + Start + L1 + R1 to stop", W / 2, 448, 15, DIM, align="center")


def wlopm(arg):
    try:
        subprocess.run(["wlopm", arg, OUTPUT], timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        print("rg35xxh-controller-screen: wlopm:", e, file=sys.stderr)


def battery():
    try:
        with open("/sys/class/power_supply/battery/capacity") as f:
            cap = int(f.read().strip())
    except (OSError, ValueError):
        return None, False
    try:
        with open("/sys/class/power_supply/axp20x-usb/online") as f:
            charging = f.read().strip() == "1"
    except OSError:
        charging = False
    return cap, charging


if __name__ == "__main__":
    if not GtkLayerShell.is_supported():
        sys.exit("rg35xxh-controller-screen: layer-shell not available")
    win = Screen()
    if "--demo" in sys.argv:          # fixed sample state, for screenshots / checking the drawing
        win.connect_status = lambda: False
        usb = "--usb" in sys.argv or "--switch" in sys.argv
        transport = ("switch" if "--switch" in sys.argv else "switch-bt" if "--switch-bt" in sys.argv
                     else "usb" if usb else "bt")
        win.st = {"transport": transport, "state": "connected",
                  "device": {"switch": "Switch or PC (USB)", "usb": "PC (USB)",
                             "switch-bt": "Nintendo Switch"}.get(transport, "JASONPC"),
                  "rate": 1000 if usb else 118, "rssi": None if usb else -64,
                  "report": [(1 << 1) | (1 << 4) | (1 << 7), 0, 2, 200, 90, 128, 128, 0, 255]}
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *a: (Gtk.main_quit(), False)[1])
    win.show_all()
    try:
        Gtk.main()
    finally:
        win.cancel_dark()
        win.light()                       # never leave the handheld's display off
