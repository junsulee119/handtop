#!/usr/bin/python3
"""External-control status screen (BT Controller and Wired Controller modes).

Full-screen layer-shell window over the desktop while the handheld is used as a controller for
another device. Shows the connection state, the host's name, a live drawing of the handheld's
controls (pixel art, drawn at half resolution and scaled 2x like the taskbar icons), battery,
link info and how to stop. Reads JSON lines from the running service's status socket
(rg35xxh-btpad or rg35xxh-usbpad) and closes itself
when that socket closes (the mode ended). Takes no input: every button goes to the other device.
"""
import json
import os
import socket
import sys

import cairo
import gi
gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

STATUS_SOCKET = "/run/rg35xxh-extpad-status.sock"     # rg35xxh-btpad or rg35xxh-usbpad
ICONS = "/usr/local/share/rg35xxh/icons"
W, H = 640, 480
PW, PH = W // 2, H // 2          # pixel-art canvas (scaled 2x)

# Geometry on the half-resolution canvas, measured from Anbernic's product photo of the RG35XX H
# (body ~2.07:1 with large rounded corners; positions as fractions of the body).
BX, BY, BW, BH, BR = 30, 60, 260, 126, 18                     # body
def at(fx, fy):
    return round(BX + fx * BW), round(BY + fy * BH)
SCR = (90, 69, 140, 105)                                      # screen: centred, 4:3, ~54 % of the width
DPAD, LSTICK = at(0.118, 0.385), at(0.118, 0.76)
FACE_C, RSTICK = at(0.885, 0.385), at(0.885, 0.76)
SELECT, START, LED = at(0.164, 0.156), at(0.83, 0.156), at(0.924, 0.18)
# Shoulder buttons sit side by side on the top face. Seen from the front (as drawn here): L2 just
# inward of the corner pokes up above the top edge as a low tab with slanted sides; L1 continues
# from it over the rounded corner as a cap that peaks on top and thins to nothing down the side.
# Mirrored on the right. (x0, x1) on the canvas.
L2_X, R2_X = (at(0.094, 0)[0], at(0.179, 0)[0]), (at(0.821, 0)[0], at(0.906, 0)[0])
L2_UP, L1_UP = 6, 4                                           # height above the top edge
L1_R = 18                                                     # L1/R1 cap outer corner radius

BG = (0.071, 0.082, 0.110)
BODY, BODY_EDGE, BODY_SHADE = (0.17, 0.18, 0.21), (0.30, 0.32, 0.37), (0.12, 0.13, 0.15)
PART, PART_EDGE = (0.09, 0.10, 0.12), (0.34, 0.36, 0.42)      # black buttons, like the real one
LABEL_COL = {"X": (0.36, 0.52, 1.0), "Y": (0.35, 0.82, 0.42), "A": (0.95, 0.30, 0.30), "B": (0.98, 0.85, 0.25)}
LIT, LIT_EDGE = (0.62, 0.76, 1.0), (0.85, 0.91, 1.0)

# Handheld palettes. "detailed" = the frozen v1 drawing (solid, like the real black handheld).
# "simple" = hologram: translucent light-blue body, whitish-blue outlines and contours, transparent
# controls that fill in brighter when pressed. Colours may carry alpha (4th value).
PALETTES = {
    "detailed": {"BODY": BODY, "BODY_EDGE": BODY_EDGE, "BODY_SHADE": BODY_SHADE, "PART": PART,
                 "PART_EDGE": PART_EDGE, "LIT": LIT, "LIT_EDGE": LIT_EDGE, "BEZEL": (0.05, 0.05, 0.06),
                 "BEZEL_EDGE": (0.24, 0.26, 0.30), "SCREEN": (0.03, 0.04, 0.05), "LED": (0.30, 0.85, 0.40),
                 "CAP": (0.12, 0.13, 0.15), "FACE": LABEL_COL, "LABEL": None, "LABEL_LIT": BG},
    "simple": {"BODY": (0.55, 0.75, 1.0, 0.16), "BODY_EDGE": (0.82, 0.91, 1.0, 0.95),
               "BODY_SHADE": (0.55, 0.75, 1.0, 0.06), "PART": (0.55, 0.75, 1.0, 0.10),
               "PART_EDGE": (0.82, 0.91, 1.0, 0.85), "LIT": (0.86, 0.94, 1.0, 0.80),
               "LIT_EDGE": (1.0, 1.0, 1.0, 1.0), "BEZEL": (0.55, 0.75, 1.0, 0.0),
               "BEZEL_EDGE": (0.82, 0.91, 1.0, 0.45), "SCREEN": (0.03, 0.05, 0.09, 0.70),
               "LED": (0.82, 0.91, 1.0, 0.95), "CAP": (0.55, 0.75, 1.0, 0.10),
               "FACE": {k: (0.86, 0.94, 1.0, 0.80) for k in "XYAB"},
               "LABEL": (0.82, 0.91, 1.0), "LABEL_LIT": (0.10, 0.16, 0.28)},
}


def src(cr, c):
    """Set a cairo source from an (r, g, b) or (r, g, b, a) tuple."""
    if len(c) == 4:
        cr.set_source_rgba(*c)
    else:
        cr.set_source_rgb(*c)
TEXT, DIM, OK, WARN = (0.91, 0.92, 0.93), (0.58, 0.62, 0.69), (0.55, 0.85, 0.62), (1.0, 0.80, 0.40)
ACCENT = {"bt": (0.37, 0.50, 0.74), "usb": (0.75, 0.54, 0.36)}

# HID report (rg35xxh-btpad): bytes 0-1 buttons, 2 hat (0-7, 8 = centre), 3-6 sticks LX LY RX RY,
# 7-8 triggers. Button bits follow the Xbox layout; the handheld's face labels are Nintendo-style.
BIT = {"xa": 0, "xb": 1, "xx": 2, "xy": 3, "l1": 4, "r1": 5, "select": 6, "start": 7, "l3": 8, "r3": 9}
FACE = {"X": "xy", "A": "xb", "B": "xa", "Y": "xx"}      # physical label -> Xbox button
HAT_DIRS = {0: "u", 1: "ur", 2: "r", 3: "dr", 4: "d", 5: "dl", 6: "l", 7: "ul"}

STATE_TEXT = {
    "pairing": ("Ready to pair", "On your PC or phone: Bluetooth > Add device > \"Handtop Gamepad\""),
    "waiting": ("Waiting for {dev}", "Turn on Bluetooth there; it reconnects by itself"),
    "connected": ("Connected to {dev}", None),
    "cable": ("Connect the USB cable", "Right USB-C port (OTG2/DC) to the PC; the handheld charges meanwhile"),
    None: ("Starting…", None),
}


def handheld_monitor():
    """The handheld's own screen (DSI-1, 640x480) when an external display is connected too, so the
    status screen does not open on the monitor (a layer surface without an output goes to the one
    with the pointer). None: only one screen, or the handheld screen is off (Monitor only)."""
    import json
    import subprocess
    try:
        outs = json.loads(subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True,
                                         timeout=5).stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    if not any(o.get("enabled") and o["name"] != "DSI-1" for o in outs):
        return None
    if not any(o.get("enabled") and o["name"] == "DSI-1" for o in outs):
        return None
    ext_models = {o.get("model") or "" for o in outs if o["name"] != "DSI-1"}
    disp = Gdk.Display.get_default()
    for i in range(disp.get_n_monitors()):
        mon = disp.get_monitor(i)
        g = mon.get_geometry()
        if (g.width, g.height) == (W, H) and (mon.get_model() or "") not in ext_models - {""}:
            return mon
    return None


class Screen(Gtk.Window):
    def __init__(self, style="detailed"):
        super().__init__()
        self.style = style            # "detailed" (frozen v1 drawing) or "simple" (hologram)
        self.pal = PALETTES[style]
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "rg35xxh-controller-screen")
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        handheld = handheld_monitor()
        if handheld is not None:                # with an HDMI display: on the handheld, not the monitor
            GtkLayerShell.set_monitor(self, handheld)
        self.area = Gtk.DrawingArea()
        self.area.connect("draw", self.on_draw)
        self.add(self.area)
        self.connect("realize", lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), "none")))     # no pointer over the screen
        self.st = {}
        self.buf = b""
        self.sock = None
        self.tries = 0
        self.icon = None
        self.icon_path = None
        GLib.timeout_add(200, lambda: self.connect_status())
        GLib.timeout_add_seconds(30, self.redraw)     # battery level
        self.bat_icons = {}
        self.bat_tick = 0
        GLib.timeout_add(450, self.battery_tick)       # charging animation (same as the taskbar)

    # ------------------------------------------------------------ data
    def connect_status(self):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(STATUS_SOCKET)
        except OSError:
            self.tries += 1
            if self.tries > 75:                       # ~15 s: the service never came up
                Gtk.main_quit()
                return False
            return True
        self.sock = s
        GLib.io_add_watch(s.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_data)
        return False

    def on_data(self, fd, cond):
        try:
            data = self.sock.recv(65536)
        except OSError:
            data = b""
        if not data:                                  # BT Controller mode ended
            Gtk.main_quit()
            return False
        self.buf += data
        *lines, self.buf = self.buf.split(b"\n")
        for line in lines[-1:]:                       # only the newest state matters
            try:
                self.st = json.loads(line)
            except ValueError:
                pass
        self.area.queue_draw()
        return True

    def redraw(self):
        self.area.queue_draw()
        return True

    # ------------------------------------------------------------ drawing
    def on_draw(self, widget, cr):
        cr.set_source_rgb(*BG)
        cr.paint()
        art = cairo.ImageSurface(cairo.FORMAT_ARGB32, PW, PH)
        self.draw_handheld(cairo.Context(art))
        cr.save()
        cr.scale(2, 2)
        cr.set_source_surface(art, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.paint()
        cr.restore()
        self.draw_header(cr)
        self.draw_screen_text(cr)
        self.draw_footer(cr)

    def report(self):
        r = self.st.get("report") or [0, 0, 8, 128, 128, 128, 128, 0, 0]
        return r[0] | (r[1] << 8), r[2], r[3:7], r[7:9]

    def pressed(self, name):
        buttons = self.report()[0]
        return bool(buttons >> BIT[name] & 1)

    # pixel-art helpers (canvas coordinates, whole pixels, no antialiasing)
    @staticmethod
    def rect(cr, x, y, w, h, fill, edge=None):
        cr.rectangle(x, y, w, h)
        src(cr, fill)
        cr.fill()
        if edge:
            src(cr, edge)
            cr.rectangle(x + 0.5, y + 0.5, w - 1, h - 1)
            cr.set_line_width(1)
            cr.stroke()

    def clip_outside(self, cr, path_fn):
        """Intersect the clip with 'everything outside path_fn's shape' (even-odd with the canvas)."""
        cr.new_path()
        path_fn(cr)                                   # (may start its own path: add the canvas after)
        cr.rectangle(-10, -10, PW + 20, PH + 20)
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        cr.clip()
        cr.set_fill_rule(cairo.FILL_RULE_WINDING)

    def body_path(self, cr):
        self.rrect_path(cr, BX, BY, BW, BH, BR)

    @staticmethod
    def tab_path(cr, x0, x1):
        cr.move_to(x0, BY + 2)
        cr.line_to(x0 + 2, BY - L2_UP + 1)
        cr.line_to(x0 + 3, BY - L2_UP)
        cr.line_to(x1 - 3, BY - L2_UP)
        cr.line_to(x1 - 2, BY - L2_UP + 1)
        cr.line_to(x1, BY + 2)
        cr.close_path()

    @staticmethod
    def cross_path(cr, cx, cy, a, h):
        """Plus shape covering pixels cx-a..cx+a x cy-h..cy+h and cx-h..cx+h x cy-a..cy+a."""
        l, r, t, b = cx - a, cx + a + 1, cy - a, cy + a + 1
        il, ir, it, ib = cx - h, cx + h + 1, cy - h, cy + h + 1
        cr.move_to(il, t)                             # new sub-path (don't join the previous one)
        for x, y in ((ir, t), (ir, it), (r, it), (r, ib), (ir, ib), (ir, b), (il, b),
                     (il, ib), (l, ib), (l, it), (il, it)):
            cr.line_to(x, y)
        cr.close_path()

    @staticmethod
    def rrect_path(cr, x, y, w, h, r):
        cr.new_path()
        cr.arc(x + w - r, y + r, r, -1.5708, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
        cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
        cr.arc(x + r, y + r, r, 3.1416, 4.7124)
        cr.close_path()

    @staticmethod
    def rrect(cr, x, y, w, h, r, fill, edge=None):
        cr.new_path()
        cr.arc(x + w - r, y + r, r, -1.5708, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
        cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
        cr.arc(x + r, y + r, r, 3.1416, 4.7124)
        cr.close_path()
        src(cr, fill)
        if edge:
            cr.fill_preserve()
            src(cr, edge)
            cr.set_line_width(1)
            cr.stroke()
        else:
            cr.fill()

    @staticmethod
    def circle(cr, x, y, r, fill, edge=None, odd=False):
        """odd=True: centre on pixel (x, y) itself -> 2r+1 px wide, symmetric around that pixel.
        Otherwise the centre is the corner between pixels (2r wide)."""
        cr.new_path()
        c = 0.5 if odd else 0
        cr.arc(x + c, y + c, r, 0, 6.2832)
        src(cr, fill)
        if edge:
            cr.fill_preserve()
            src(cr, edge)
            cr.set_line_width(1)
            cr.stroke()
        else:
            cr.fill()

    def draw_handheld(self, cr):
        cr.set_antialias(cairo.ANTIALIAS_NONE)
        P = self.pal
        _, hat, sticks, trig = self.report()
        hat_dir = HAT_DIRS.get(hat, "")
        # L1 / R1: corner caps. Outer shape = the body's rounded rect raised by L1_UP at the top
        # with radius L1_R, so it is L1_UP thick on top and tapers to 0 down the side. Each cap
        # runs under the L2/R2 tab (drawn next, in front), so its top outline meets the tab's
        # slanted side and the two read as one continuous line.
        for lit, x0, x1 in ((self.pressed("l1"), BX - 1, L2_X[0] + 3),
                            (self.pressed("r1"), R2_X[1] - 3, BX + BW + 1)):
            cr.save()
            cr.rectangle(x0, BY - L1_UP - 1, x1 - x0, BR + L1_UP + 1)
            cr.clip()
            self.clip_outside(cr, self.body_path)                   # only the part above the body
            tab = L2_X if x0 < BX + BW // 2 else R2_X
            self.clip_outside(cr, lambda c: self.tab_path(c, *tab))  # ... and not under the tab
            self.rrect_path(cr, BX, BY - L1_UP, BW, BH + L1_UP, L1_R)
            src(cr, (P["LIT"] if lit else P["PART"]))
            cr.fill_preserve()
            edge = P["LIT_EDGE"] if lit else P["PART_EDGE"]
            src(cr, edge)
            cr.set_line_width(1)
            cr.stroke()
            cr.restore()
        # L2 / R2: slanted tabs above the top edge (the body drawn next covers their base)
        for (x0, x1), lit in ((L2_X, trig[0] > 0), (R2_X, trig[1] > 0)):
            cr.save()
            self.clip_outside(cr, self.body_path)
            cr.new_path()
            self.tab_path(cr, x0, x1)
            src(cr, (P["LIT"] if lit else P["PART"]))
            cr.fill_preserve()
            src(cr, (P["LIT_EDGE"] if lit else P["PART_EDGE"]))
            cr.set_line_width(1)
            cr.stroke()
            cr.restore()
        # body
        self.rrect(cr, BX, BY, BW, BH, BR, P["BODY"], P["BODY_EDGE"])
        # screen with its black bezel
        sx, sy, sw, sh = SCR
        self.rect(cr, sx - 3, sy - 3, sw + 6, sh + 6, P["BEZEL"], P["BEZEL_EDGE"])
        self.rect(cr, sx, sy, sw, sh, P["SCREEN"])
        # power LED
        self.rect(cr, LED[0], LED[1], 2, 2, P["LED"])
        # D-pad (upper left): one plus shape, 2*A+1 px long and T px thick (both odd, so the
        # centre pixel is DPAD itself). Edge = the 1 px ring between the plus and the plus inset
        # by 1 px (even-odd), fill = the inset plus: no seam where the bars cross, and nothing is
        # painted twice (matters for the translucent "simple" style).
        cx, cy = DPAD
        A, T = 20, 13
        h = T // 2
        cr.new_path()
        self.cross_path(cr, cx, cy, A, h)
        self.cross_path(cr, cx, cy, A - 1, h - 1)
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        src(cr, P["PART_EDGE"])
        cr.fill()
        cr.set_fill_rule(cairo.FILL_RULE_WINDING)
        self.cross_path(cr, cx, cy, A - 1, h - 1)
        src(cr, P["PART"])
        cr.fill()
        arms = {"u": (cx - h + 1, cy - A + 1, T - 2, A - h - 1), "d": (cx - h + 1, cy + h + 1, T - 2, A - h - 1),
                "l": (cx - A + 1, cy - h + 1, A - h - 1, T - 2), "r": (cx + h + 1, cy - h + 1, A - h - 1, T - 2)}
        for d, (x, y, w, hh) in arms.items():
            if d in hat_dir:
                self.rect(cr, x, y, w, hh, P["LIT"])
        # face buttons (upper right): X top, A right, B bottom, Y left, as printed on the handheld
        fx, fy = FACE_C
        g = 14
        self.face = {}
        for label, (dx, dy) in {"X": (0, -1), "A": (1, 0), "B": (0, 1), "Y": (-1, 0)}.items():
            x, y = fx + dx * g, fy + dy * g
            lit = self.pressed(FACE[label])
            self.circle(cr, x, y, 7, P["FACE"][label] if lit else P["PART"], P["LIT_EDGE"] if lit else P["PART_EDGE"],
                        odd=True)                       # 15 px, centred on pixel (x, y)
            self.face[label] = (x, y, lit)
        # sticks (lower left / lower right): recessed ring + cap that moves
        for (x, y), (ax, ay), btn in ((LSTICK, (sticks[0], sticks[1]), "l3"),
                                      (RSTICK, (sticks[2], sticks[3]), "r3")):
            self.circle(cr, x, y, 19, P["BODY_SHADE"], P["PART_EDGE"])
            ox, oy = round((ax - 128) / 128 * 6), round((ay - 128) / 128 * 6)
            lit = self.pressed(btn)
            moved = abs(ax - 128) > 12 or abs(ay - 128) > 12
            self.circle(cr, x + ox, y + oy, 12, P["LIT"] if lit else P["PART"], P["LIT_EDGE"] if (lit or moved) else P["PART_EDGE"])
            self.circle(cr, x + ox, y + oy, 8, P["LIT"] if lit else P["CAP"])
        # Select / Start: small round buttons above the D-pad and the face buttons
        for name, (x, y) in (("select", SELECT), ("start", START)):
            lit = self.pressed(name)
            self.circle(cr, x, y, 4, P["LIT"] if lit else P["PART"], P["LIT_EDGE"] if lit else P["PART_EDGE"])

    def text_mid(self, cr, s, cx, cy, size, color, bold=False):
        """Draw s with its ink (not its advance box) centred on (cx, cy)."""
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        e = cr.text_extents(s)
        cr.move_to(round(cx - e.x_bearing - e.width / 2), round(cy - e.y_bearing - e.height / 2))
        src(cr, color)
        cr.show_text(s)

    def battery_frames(self, bars):
        """Bar counts shown in turn while charging (like rg35xxh-battery): level .. full, hold full."""
        return list(range(bars, 5)) + [5, 5] if bars < 5 else [5]

    def battery_icon(self, cap, charging):
        bars = min(5, max(0, -(-cap // 20)))
        if charging:
            seq = self.battery_frames(bars)
            bars = seq[self.bat_tick % len(seq)]
        name = "battery" + ("-charging" if charging else "") + ("-low" if cap <= 20 else "") + f"-{bars}.png"
        if name not in self.bat_icons:
            try:
                self.bat_icons[name] = cairo.ImageSurface.create_from_png(f"{ICONS}/{name}")
            except (OSError, cairo.Error):
                self.bat_icons[name] = None
        return self.bat_icons[name]

    def battery_tick(self):
        if battery()[1]:                               # charging: next frame
            self.bat_tick += 1
            self.area.queue_draw()
        else:
            self.bat_tick = 0
        return True

    def text(self, cr, s, x, y, size, color, bold=False, align="left"):
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        ext = cr.text_extents(s)
        if align == "center":
            x -= ext.x_advance / 2
        elif align == "right":
            x -= ext.x_advance
        cr.move_to(x, y)
        cr.set_source_rgb(*color)
        cr.show_text(s)

    def draw_header(self, cr):
        transport = self.st.get("transport", "bt")
        path = f"{ICONS}/inputmode-{'bt' if transport == 'bt' else 'wired'}.png"
        if (self.icon is None or self.icon_path != path) and os.path.exists(path):
            self.icon = cairo.ImageSurface.create_from_png(path)
            self.icon_path = path
        if self.icon:
            cr.save()
            cr.translate(20, 18)
            cr.scale(2, 2)
            cr.set_source_surface(self.icon, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.paint()
            cr.restore()
        state = self.st.get("state")
        title, hint = STATE_TEXT.get(state, STATE_TEXT[None])
        dev = self.st.get("device") or "your device"
        self.text(cr, title.format(dev=dev), 80, 46, 22, OK if state == "connected" else TEXT, bold=True)
        sub = {"bt": "BT Controller", "usb": "Wired Controller (USB)"}.get(transport, "")
        self.text(cr, sub, 80, 64, 13, DIM)
        # battery (top right): the taskbar's pixel-art battery icon at 2x, then the percentage
        cap, charging = battery()
        if cap is not None:
            col = WARN if cap <= 20 and not charging else TEXT
            label = f"{cap}%"
            self.text(cr, label, W - 20, 46, 22, col, bold=True, align="right")
            cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(22)
            tw = cr.text_extents(label).x_advance
            img = self.battery_icon(cap, charging)
            if img:
                cr.save()
                cr.translate(round(W - 20 - tw - 10 - 2 * img.get_width()), 27)
                cr.scale(2, 2)
                cr.set_source_surface(img, 0, 0)
                cr.get_source().set_filter(cairo.FILTER_NEAREST)
                cr.paint()
                cr.restore()
        if hint:
            self.text(cr, hint, W / 2, 400, 15, TEXT, align="center")

    def draw_screen_text(self, cr):
        # link info on the drawn handheld's own screen (canvas screen at 110,70 100x76 -> x2)
        x, y = (SCR[0] + SCR[2] / 2) * 2, SCR[1] * 2
        if self.st.get("state") != "connected":
            self.text(cr, "Handtop", x, y + 112, 18, DIM, bold=True, align="center")
            return
        rate = self.st.get("rate", 0)
        rssi = self.st.get("rssi")
        self.text(cr, f"{rate}", x, y + 78, 34, TEXT, bold=True, align="center")
        self.text(cr, "reports/s", x, y + 98, 13, DIM, align="center")
        if rssi is not None:
            q = "strong" if rssi >= -70 else "good" if rssi >= -85 else "weak"
            self.text(cr, f"signal {q}", x, y + 140, 15, OK if q != "weak" else WARN, align="center")
            self.text(cr, f"{rssi} dBm", x, y + 158, 12, DIM, align="center")

    def draw_footer(self, cr):
        # face-button labels on top of the pixel art (crisp text)
        P = self.pal
        for label, (x, y, lit) in getattr(self, "face", {}).items():
            # centre of pixel (x, y) on the 2x canvas = (2x + 1, 2y + 1); centre the letter's ink there
            self.text_mid(cr, label, x * 2 + 1, y * 2 + 1, 15,
                          P["LABEL_LIT"] if lit else (P["LABEL"] or LABEL_COL[label]), bold=True)
        for label, (x, y) in (("SELECT", SELECT), ("START", START)):
            self.text(cr, label, x * 2, y * 2 - 13, 9, P["LABEL"] or DIM, align="center")
        self.text(cr, "Select + Start + L1 + R1 to stop", W / 2, 448, 15, DIM, align="center")


def battery():
    try:
        with open("/sys/class/power_supply/battery/capacity") as f:
            cap = int(f.read().strip())
    except (OSError, ValueError):
        return None, False
    try:
        with open("/sys/class/power_supply/axp20x-usb/online") as f:
            charging = f.read().strip() == "1"
    except OSError:
        charging = False
    return cap, charging


if __name__ == "__main__":
    if not GtkLayerShell.is_supported():
        sys.exit("rg35xxh-controller-screen: layer-shell not available")
    style = "simple" if "--simple" in sys.argv else "detailed"
    try:          # per-user choice: "simple" in ~/.config/rg35xxh/controller-screen
        with open(os.path.expanduser("~/.config/rg35xxh/controller-screen")) as f:
            if f.read().strip() == "simple":
                style = "simple"
    except OSError:
        pass
    win = Screen(style)
    if "--demo" in sys.argv:          # fixed sample state, for screenshots / checking the drawing
        win.connect_status = lambda: False
        usb = "--usb" in sys.argv
        win.st = {"transport": "usb" if usb else "bt", "state": "connected", "device": "PC (USB)" if usb else "JASONPC",
                  "rate": 1000 if usb else 118, "rssi": None if usb else -64,
                  "report": [(1 << 1) | (1 << 4) | (1 << 7), 0, 2, 200, 90, 128, 128, 0, 255]}
    win.show_all()
    Gtk.main()
