{
  "schema": 1,
  "id": "handtop-retro",
  "name": "Retro",
  "base": "light",
  "author": "Handtop",
  "description": "A 90s desktop: grey bevelled buttons, navy title bars, a teal desktop.",
  "palette": {
    "bg": "#c0c0c0",
    "surface": "#c0c0c0",
    "surface_hi": "#000080",
    "border": "#808080",
    "fg": "#000000",
    "fg_dim": "#808080",
    "accent": "#000080",
    "accent_fg": "#000080",
    "on_accent": "#ffffff",
    "warn": "#806000",
    "error": "#c00000",
    "brightness": "#808000",
    "success": "#008000"
  },
