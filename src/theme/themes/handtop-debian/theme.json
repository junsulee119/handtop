{
  "schema": 1,
  "id": "handtop-debian",
  "name": "Debian",
  "base": "light",
  "author": "Handtop",
  "description": "A stock Debian desktop: GNOME's Adwaita, Debian red, the apps' own icons.",
  "palette": {
    "bg": "#fafafa",
    "surface": "#ffffff",
    "surface_hi": "#dcdcdc",
    "border": "#cdc7c2",
    "fg": "#2e3436",
    "fg_dim": "#77767b",
    "accent": "#d70a53",
    "accent_fg": "#a80030",
    "on_accent": "#ffffff",
    "warn": "#c64600",
    "error": "#e01b24",
    "brightness": "#e5a50a",
    "success": "#26a269"
  },
  "colors": {
    "taskbar.bg": "#ebebeb",
    "taskbar.border": "#cdc7c2",
    "taskbar.apps_bg": "#d70a53",
    "taskbar.apps_fg": "#ffffff",
    "titlebar.active_bg": "#ebebeb",
    "titlebar.inactive_bg": "#fafafa",
    "titlebar.active_fg": "#2e3436",
    "titlebar.inactive_fg": "#929595",
    "titlebar.active_button": "#2e3436",
    "titlebar.inactive_button": "#929595",
    "drawer.entry_bg": "#0000000f",
    "drawer.hover_bg": "#00000014",
    "powermenu.hover_bg": "#f9dbe5",
    "powermenu.hover_border": "#d70a53",
    "powermenu.focus": "#d70a53",
    "notify.border": "#cdc7c2",
    "osk.hit": "#c0bfbc",
    "osk.hit_border": "#d70a53",
    "osk.hit_fg": "#2e3436"
  },
  "wallpaper": {
    "color": "#2b3e50",
    "image": null,
    "mode": "center"
  },
  "status_screen": {
    "style": "solid"
  },
  "gtk": {
    "color_scheme": "default",
    "theme": "Adwaita",
    "icon_theme": "Adwaita"
  },
  "cursor": {
    "theme": "Adwaita",
    "size": 24
  },
  "fonts": {
    "ui": "Noto Sans",
    "mono": "Noto Sans Mono",
    "scale": 1.0
  },
  "icons": {
