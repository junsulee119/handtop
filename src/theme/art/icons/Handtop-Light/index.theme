[Icon Theme]
Name=Handtop-Light
Comment=Handtop light theme: taskbar and default-app icons drawn for a light background (rg35xxh-theme light)
Inherits=Adwaita,hicolor
Hidden=true
Directories=22x22/apps,24x24/apps,scalable/apps

[22x22/apps]
Size=22
Context=Applications
Type=Threshold

[24x24/apps]
Size=24
Context=Applications
Type=Threshold

[scalable/apps]
Size=56
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable
