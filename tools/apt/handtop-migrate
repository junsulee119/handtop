-----END PGP PUBLIC KEY BLOCK-----
KEY
keys=$(gpg --batch --show-keys --with-colons "$T/key.asc" 2>/dev/null | awk -F: '/^pub:/ {getline; print $10}')
[ "$keys" = "$FPR" ] || die "the archive key inside this script is not Handtop's (found: ${keys:-none})"
install -D -m644 "$T/key.asc" "$KEYRING"
if [ -n "${HANDTOP_MIGRATE_SOURCE:-}" ]; then
  printf 'Types: deb\n%s\nTrusted: yes\n' "$HANDTOP_MIGRATE_SOURCE" | put "$SRC"
else
  put "$SRC" <<'SOURCES'
# Handtop's own packages (updates without reflashing). Signed by the Handtop archive key,
# fingerprint EF04B02F6569FB6FC8EAF9C5F5962C429E9C69FF (README, release notes).
# Shipped by the handtop-keyring package. Don't edit: the Update app's testing channel is a
# separate file (handtop-testing.sources).
Types: deb
URIs: https://junsulee119.github.io/handtop-apt
Suites: trixie-stable
Components: main
Signed-By: /usr/share/keyrings/handtop-archive.asc
SOURCES
fi
put "$PREF" <<'PREF'
# Handtop's FFmpeg replaces Debian's packages of the same names (V4L2 request API decoders for
# the video engine). Only Handtop's repository may provide them: Debian's versions are never
# installed, so a Debian security update cannot silently drop hardware decoding. Handtop's
# repository follows Debian's security updates (project doc update-system.md).
Package: ffmpeg libavcodec61 libavdevice61 libavfilter10 libavformat61 libavutil59 libpostproc58 libswresample5 libswscale8 libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libpostproc-dev libswresample-dev libswscale-dev
Pin: release o=Handtop
Pin-Priority: 995

Package: ffmpeg libavcodec61 libavdevice61 libavfilter10 libavformat61 libavutil59 libpostproc58 libswresample5 libswscale8 libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libpostproc-dev libswresample-dev libswscale-dev
Pin: release o=Debian
Pin-Priority: -1

Package: handtop handtop-*
Pin: release o=Handtop
Pin-Priority: 995
PREF

echo "2/4 The update worker from this release"
apt-get update -q --error-on=any || { echo "(trying once more)"; sleep 5; apt-get update -q --error-on=any; } ||
  die "could not refresh every package list (Wi-Fi?)"
install -d -m755 "$T/dl" && chown _apt "$T/dl" 2>/dev/null || true   # only the download folder is apt's
(cd "$T/dl" && apt-get download -q handtop-core) || die "could not download handtop-core"
CORE=$(dpkg-deb -f "$T"/dl/handtop-core_*.deb Version)
dpkg-deb -x "$T"/dl/handtop-core_*.deb "$T/x"
for f in handtop-update handtop-run handtop-recovery; do
  install -m755 "$T/x/usr/local/sbin/$f" "/usr/local/sbin/$f"
done
install -d /usr/local/share/handtop
if [ ! -f "$U/share-new" ]; then       # the folder was there: keep what each file was first (#85)
  mkdir -p "$U/share"; : > "$U/share-absent"
  (cd "$T/x/usr/local/share/handtop" && find . ! -type d) > "$T/share-list" || die "could not list the new files"
  while IFS= read -r f; do
    if [ -e "/usr/local/share/handtop/$f" ] || [ -L "/usr/local/share/handtop/$f" ]; then
      mkdir -p "$U/share/$(dirname "$f")" && cp -a "/usr/local/share/handtop/$f" "$U/share/$f" ||
        die "could not save /usr/local/share/handtop/$f"
    else echo "$f" >> "$U/share-absent"; fi
  done < "$T/share-list"
  sync
fi
cp -a "$T/x/usr/local/share/handtop/." /usr/local/share/handtop/
install -m644 "$T/x/etc/systemd/system/handtop-update-apply.service" "$UNIT"
# The first maintenance boot still has v0.4.x's boot splash and Bluetooth check: keep them out of it.
for u in $DROPIN_UNITS; do
  mkdir -p "/etc/systemd/system/$u.d"
  printf '[Unit]\nConditionPathIsSymbolicLink=!/system-update\n' | put "/etc/systemd/system/$u.d/$DROPIN"
done
systemctl daemon-reload 2>/dev/null || true    # (no systemd in a chroot test)
systemctl enable handtop-update-apply.service >/dev/null 2>&1 || true

echo "3/4 Planning and downloading (a few minutes)"
if ! "$W" migrate > "$T/plan.json"; then
  die "$(json "$T/plan.json" 'd.get("error")' || cat "$T/plan.json")"
fi
[ "$(json "$T/plan.json" 'd.get("core")')" = "$CORE" ] ||
  die "the release changed while downloading (handtop-core $CORE vs $(json "$T/plan.json" 'd.get("core")')): run this again"
python3 - "$T/plan.json" <<'SUMMARY'
import json, sys
d = json.load(open(sys.argv[1]))
f = d["from"]
print("\nThis card: Handtop %s%s." % (f["release"], " (%s)" % f["variant"] if f["variant"] else ""))
print("To install: %d packages, %.1f MB downloaded." % (d["packages"], d["download_mb"]))
for p in d["config_kept"]:
    print("  kept, you changed it: %s (Handtop's new version goes next to it as .dpkg-dist)" % p)
for p in d["backed_up"]:
    print("  you changed %s: Handtop's version replaces it, your copy goes to /var/backups/handtop-migrate" % p)
for p in d.get("config_deleted", []):
    print("  you deleted %s: it stays deleted" % p)
for p in d.get("links", []):
    print("  you made %s a link: Handtop's file replaces it; where it pointed is noted in "
          "/var/backups/handtop-migrate/links.json" % p)
if d.get("ffmpeg_backed_up"):
    print("  %d file(s) of v0.4.x's own FFmpeg build differ from Handtop's FFmpeg packages: copies go to "
          "/var/backups/handtop-migrate" % d["ffmpeg_backed_up"])
for w in d.get("warnings", []):
    print("  note: " + w)
SUMMARY

echo
echo "4/4 Install at the next start"
ask "The handheld restarts and installs for a few minutes (keep it charged; don't switch it off). Go ahead?" ||
  die "cancelled: nothing installed"
PID=$(json "$T/plan.json" 'd.get("plan")')     # exactly the plan shown above (review 2026-11-26 #63)
echo "$PID" > "$U/consented"; sync               # from here on, a cut never undoes the move (#84)
# Refused (battery, space, ...): not agreed to after all, so everything is put back, holds too (#98).
"$W" schedule restart "$PID" > "$T/sched.json" ||
  { rm -f "$U/consented"; die "$(json "$T/sched.json" 'd.get("error")' || cat "$T/sched.json")"; }
SCHEDULED=1
rm -rf "$U"
sync
if [ "${HANDTOP_MIGRATE_NO_RESTART:-}" = 1 ]; then echo "scheduled (no restart: test)"; exit 0; fi
echo "Restarting in 10 s. After the install the desktop starts again; Apps > Update shows the result."
sleep 10
systemctl reboot
