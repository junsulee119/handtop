# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol
# Compositor and shell
labwc
xwayland
waybar
# nwg-drawer: not in trixie, built from source by 04b-nwg-drawer.sh
wlogout
mako-notifier
swaybg
xdg-utils
# GIO maps a content type to an application only with both of these: the MIME
# database and the desktop-file cache (build/05-configure-base.sh refreshes
# them). Without them a fresh home has no handler for a video file.
shared-mime-info
desktop-file-utils
wl-clipboard
wlrctl
grim
slurp
brightnessctl
swayidle                 # auto-sleep after idle (rg35xxh-autosleep)
network-manager-gnome
# polkit agent; without it apt picks hyprpolkitagent from backports
lxpolkit
blueman
# Apps
foot
thunar
tumbler                   # thumbnail service Thunar needs; without it opening a
                          # video fails with a missing-exec error (exo-open crash)
mousepad
chromium                  # browser: about half Firefox's CPU when scrolling on this device (docs/desktop.md)
imv
qpdfview
mpv
bemenu                  # fast text app launcher (goblin-run); ~6x quicker than the icon drawer
python3-textual          # modern TUI framework (goblin-tui); mouse support, neon styling
xarchiver
# Themes / fonts
adwaita-icon-theme
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji
# Display management (per-output scaling, screen off)
kanshi
wlr-randr
wlopm
# GSettings defaults (glib-compile-schemas)
libglib2.0-bin
# Input daemon (on-screen keyboard UI, notifications)
python3-gi
gir1.2-gtk-3.0
gir1.2-gtklayershell-0.1
libnotify-bin
