From: stockmind <slysimo@gmail.com>
Subject: [PATCH] media: cedrus: tell the VP9 engine how the reference stride is aligned

Applies on top of the LibreELEC VP9 series (0410/0411/0412/0413/0414/0415/
0417/0418/0421). Not part of that series: this one is ours.

The VP9 backend programs the reference-scale registers with the vendor's
VE_DEC_VP9_SCALE1_STRIDE_ALIGN(1), which is the value for the 16-byte stride
cedrus used to program before 0002-cedrus-64-byte-stride.patch made the capture
stride 64-byte aligned. The engine then reads reference pictures back with the
wrong stride: key frames decode, every inter frame is garbage, and only at
widths whose 16- and 64-byte alignments differ (416/854/1366 - not 1280/1920/
3840, which is why the first round of testing missed it).

Which stride matters depends on the output depth: for 8-bit the reconstruct
surface is the capture buffer (64-byte stride), for 10-bit the references live
in the hidden NV12 surface that cedrus_dst_frame_fmt() keeps at the 16-byte
stride the hardware reconstructs with. Deriving the field from ctx->dst_fmt
gets 8-bit right and 10-bit wrong at unaligned widths (key frames fine, inter
frames garbage); deriving it from cedrus_dst_frame_fmt() gets both right.

Measured on the device, 10 frames against a software decode:

  8-bit 416x234 / 720p / 854x480 / 1366x768 / 1080p / 4K   PSNR inf
  10-bit 384x216 / 448x256 / 512x288 / 640x360 / 720p /
         854x480 / 1366x768                                PSNR inf
  10-bit 352x234 / 416x234 / 416x240 / 480x234 / 544x234    25.5-29.2 dB
         (widths 32 bytes past a 64-byte multiple: the low-2-bit
          plane stride and the P010 reconstruct offset, which
          LibreELEC 0438 fixes; see build/kernel/libreelec/README.md)

Sweep that pinned the field value, 8-bit 854x480 (align, PSNR): 0 9.26,
1 (vendor) 9.42, 2 9.42, 3 inf, 4 inf, 5 9.22, 6 9.15, 7 9.26.
---
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
@@ -423,6 +423,36 @@
  *   reg[ 4: 0] = step_q4 - 1
  *   reg[20: 5] = (ref_size << 14) / cur_size  (Q14 scale factor)
  */
+/*
+ * The reference surfaces are read back with the reconstruct stride, so the
+ * hardware has to be told how that stride is aligned: the vendor blob used 1
+ * for the 16-byte stride cedrus used to program.  Our capture stride is
+ * 64-byte aligned (build/kernel/0002-cedrus-64-byte-stride.patch), and leaving
+ * the field at the vendor value makes every inter frame read its references
+ * with the wrong stride: luma and chroma are garbage at any width whose
+ * 16-byte and 64-byte alignments differ, while all-intra streams decode fine.
+ *
+ * Note which stride: for 8-bit output the reconstruct surface *is* the capture
+ * buffer (64-byte stride), but for 10-bit the references live in the hidden
+ * NV12 reconstruction surface, which cedrus_dst_frame_fmt() keeps at the
+ * 16-byte stride the hardware reconstructs with.  Deriving this from
+ * ctx->dst_fmt instead breaks 10-bit inter frames at unaligned widths - key
+ * frames still decode, which is how that was missed.
+ */
+static u32 cedrus_vp9_stride_align(struct cedrus_ctx *ctx)
+{
+	struct v4l2_pix_format fmt = cedrus_dst_frame_fmt(ctx);
+	u32 width = fmt.width;
+	u32 bpl = fmt.bytesperline;
+
+	if (bpl >= ALIGN(width, 64))
+		return 3;	/* 64-byte aligned rows */
+	if (bpl >= ALIGN(width, 32))
+		return 2;	/* 32-byte aligned rows */
+
+	return 1;		/* 16-byte aligned rows */
+}
+
 static void cedrus_vp9_ref_scale(u32 ref_w, u32 ref_h, u32 cur_w, u32 cur_h,
 				 u32 *reg0, u32 *reg1)
 {
@@ -744,7 +774,7 @@
 	struct vb2_buffer *src_buf = &run->src->vb2_buf;
 	dma_addr_t src_dma, src_end, luma, chroma;
 	u32 src_len, hdr_off, cur_w, cur_h;
-	u32 hdr_syn, fc;
+	u32 hdr_syn, fc, stride_align;
 	bool intra_only, p010, resolution_change, use_temporal_mv;
 	int ret;
 
@@ -899,13 +929,15 @@
 		     VE_DEC_VP9_BITS_ADDR_LAST);
 
 	/* Picture size and reference frame sizes / scale factors. */
+	stride_align = cedrus_vp9_stride_align(ctx);
+
 	cedrus_write(dev, VE_DEC_VP9_PIC_SIZE,
 		     VE_DEC_VP9_PIC_WIDTH(cur_w) |
 		     VE_DEC_VP9_PIC_HEIGHT(cur_h));
 
 	if (intra_only) {
 		cedrus_write(dev, VE_DEC_VP9_LAST_SCALE1,
-			     VE_DEC_VP9_SCALE1_STRIDE_ALIGN(1));
+			     VE_DEC_VP9_SCALE1_STRIDE_ALIGN(stride_align));
 	} else {
 		struct vb2_buffer *last_buf, *gold_buf, *alt_buf;
 		struct cedrus_buffer *last_cb, *gold_cb, *alt_cb;
@@ -951,7 +983,7 @@
 		cedrus_vp9_ref_scale(last_w, last_h, cur_w, cur_h, &s0, &s1);
 		cedrus_write(dev, VE_DEC_VP9_LAST_SCALE0, s0);
 		cedrus_write(dev, VE_DEC_VP9_LAST_SCALE1,
-			     s1 | VE_DEC_VP9_SCALE1_STRIDE_ALIGN(1));
+			     s1 | VE_DEC_VP9_SCALE1_STRIDE_ALIGN(stride_align));
 
 		cedrus_vp9_ref_scale(gold_w, gold_h, cur_w, cur_h, &s0, &s1);
 		cedrus_write(dev, VE_DEC_VP9_GOLDEN_SCALE0, s0);
-- 
2.43.0
