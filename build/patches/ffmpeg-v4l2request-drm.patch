 #define HWACCEL_V4L2REQUEST(codec) \
     HW_CONFIG_HWACCEL(1, 0, 0, DRM_PRIME,    V4L2REQUEST,  ff_ ## codec ## _v4l2request_hwaccel)
 
+// The same stateless V4L2 request decoder, also registered under the DRM
+// device type. Its buffers are V4L2 request buffers exported as dmabufs
+// (AV_PIX_FMT_DRM_PRIME), which is what a render API expects from a "drm"
+// hwaccel: mpv's DRM PRIME interop consumes those frames as they are, so this
+// is the zero-copy path on Cedrus (see docs/video-decode.md).
+#define HWACCEL_DRM_V4L2REQUEST(codec) \
+    HW_CONFIG_HWACCEL(1, 0, 0, DRM_PRIME,    DRM,          ff_ ## codec ## _v4l2request_hwaccel)
+
 #define HW_CONFIG_ENCODER(device, frames, ad_hoc, format, device_type_) \
