diff --git a/libavcodec/decode.c b/libavcodec/decode.c
index d8d3bd4..37efb5e 100644
--- a/libavcodec/decode.c
+++ b/libavcodec/decode.c
@@ -1327,12 +1327,31 @@ int ff_get_format(AVCodecContext *avctx, const enum AVPixelFormat *fmt)
         }
 
         if (ffcodec(avctx->codec)->hw_configs) {
-            for (i = 0;; i++) {
-                hw_config = ffcodec(avctx->codec)->hw_configs[i];
+            /* A codec can offer several configurations with the same output
+             * pixel format but different device types: the stateless V4L2
+             * request decoders are reachable both as v4l2request and as drm,
+             * and both produce AV_PIX_FMT_DRM_PRIME. Selecting the first
+             * format match would reject a caller that passed a device of the
+             * other type ("does not match the type of the provided device
+             * context"). Prefer the configuration whose device type matches
+             * the provided device context, keeping the first match as the
+             * fallback. */
+            enum AVHWDeviceType dev_type = AV_HWDEVICE_TYPE_NONE;
+            if (avctx->hw_device_ctx)
+                dev_type = ((AVHWDeviceContext *)avctx->hw_device_ctx->data)->type;
+            hw_config = NULL;
+            for (i = 0; ffcodec(avctx->codec)->hw_configs[i]; i++) {
+                const AVCodecHWConfigInternal *cand =
+                    ffcodec(avctx->codec)->hw_configs[i];
+                if (cand->public.pix_fmt != user_choice)
+                    continue;
                 if (!hw_config)
+                    hw_config = cand;
+                if (dev_type != AV_HWDEVICE_TYPE_NONE &&
+                    cand->public.device_type == dev_type) {
+                    hw_config = cand;
                     break;
-                if (hw_config->public.pix_fmt == user_choice)
-                    break;
+                }
             }
         } else {
             hw_config = NULL;
