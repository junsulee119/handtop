diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 6d7a0de..aa448e8 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -724,6 +724,23 @@ int ff_v4l2_request_init(AVCodecContext *avctx,
         ctx->output[i].request_fd = -1;
     }
 
+    // A DRM device here comes from a render API's dmabuf interop (mpv creates
+    // one and hands it to the decoder, see --hwdec=drm). It is only a stand-in:
+    // the frames we produce are V4L2 request buffers, so swap in the device this
+    // decoder really needs before the frames context is created from it.
+    if (avctx->hw_device_ctx) {
+        AVHWDeviceContext *dev = (AVHWDeviceContext *)avctx->hw_device_ctx->data;
+        if (dev->type == AV_HWDEVICE_TYPE_DRM) {
+            AVBufferRef *ref = NULL;
+            ret = av_hwdevice_ctx_create(&ref, AV_HWDEVICE_TYPE_V4L2REQUEST,
+                                         NULL, NULL, 0);
+            if (ret < 0)
+                goto fail;
+            av_buffer_unref(&avctx->hw_device_ctx);
+            avctx->hw_device_ctx = ref;
+        }
+    }
+
     // Create frames context and allocate initial CAPTURE buffers
     ret = ff_decode_get_hw_frames_ctx(avctx, AV_HWDEVICE_TYPE_V4L2REQUEST);
     if (ret < 0)
